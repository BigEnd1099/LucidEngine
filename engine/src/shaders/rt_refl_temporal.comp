#version 460
#extension GL_EXT_ray_query : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_GOOGLE_include_directive : require

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

#include "rt_common.glsl"
#include "rt_screen.glsl"

layout(set = 1, binding = 0) uniform sampler2D uDepth;
layout(set = 1, binding = 3, rgba32f) uniform image2D imgGeomCur;
layout(set = 1, binding = 4, rgba32f) uniform image2D imgGeomPrev;
layout(set = 1, binding = 9, rgba16f) uniform image2D imgRefl;
layout(set = 1, binding = 10, rgba16f) uniform image2D imgReflHistCur;
layout(set = 1, binding = 11, rgba16f) uniform image2D imgReflHistPrev;
layout(set = 1, binding = 12) uniform sampler2D uMotion;

layout(push_constant) uniform PC {
    mat4 prevViewProj;
    vec4 f;   // x = max history, y = samples, z = history valid
    uvec4 u;
} pc;

void main() {
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    ivec2 isize = imageSize(imgRefl);
    if (any(greaterThanEqual(px, isize))) return;
    vec2 size = vec2(isize);

    ivec2 geomCurSize = imageSize(imgGeomCur);
    ivec2 geomPx = clamp(ivec2(((vec2(px) + 0.5) / size) * vec2(geomCurSize)), ivec2(0), geomCurSize - 1);
    vec4 geom = imageLoad(imgGeomCur, geomPx);
    float d = texelFetch(uDepth, px, 0).r;
    if (d >= 1.0 || geom.z < 0.0) { // sky
        imageStore(imgReflHistCur, px, vec4(0.0));
        imageStore(imgRefl, px, vec4(0.0));
        return;
    }

    vec4 raw = imageLoad(imgRefl, px);
    if (raw.a <= 0.0) {
        // Sky or skipped roughness > 0.75
        imageStore(imgReflHistCur, px, vec4(0.0));
        imageStore(imgRefl, px, vec4(0.0));
        return;
    }

    vec3 N = rtOctDecode(geom.xy);
    vec3 P = rtWorldPos(vec2(px) + 0.5, d, size);

    vec4 hist = vec4(0.0);
    float wSum = 0.0;

    vec2 curUV = (vec2(px) + 0.5) / size;
    vec2 motion = texelFetch(uMotion, px, 0).xy;
    vec4 pClip = pc.prevViewProj * vec4(P, 1.0);
    if (pc.f.z > 0.5) {
        vec2 prevUV = curUV - motion;
        if (dot(motion, motion) < 1e-9 && pClip.w > 1e-4) {
            prevUV = (pClip.xy / pClip.w) * 0.5 + 0.5;
        }
        vec2 prevPx = prevUV * size - 0.5;
        ivec2 base = ivec2(floor(prevPx));
        vec2 fr = prevPx - vec2(base);
        for (int i = 0; i < 4; ++i) {
            ivec2 o = ivec2(i & 1, i >> 1);
            ivec2 tp = base + o;
            if (any(lessThan(tp, ivec2(0))) || any(greaterThanEqual(tp, isize))) continue;
            ivec2 geomPrevSize = imageSize(imgGeomPrev);
            ivec2 geomTp = clamp(ivec2(((vec2(tp) + 0.5) / size) * vec2(geomPrevSize)), ivec2(0), geomPrevSize - 1);
            vec4 g = imageLoad(imgGeomPrev, geomTp);
            if (g.z < 0.0) continue;
            if (abs(g.z - pClip.w) > 0.03 * pClip.w + 0.01) continue;
            if (dot(rtOctDecode(g.xy), N) < 0.85) continue;
            float w = ((o.x == 0) ? (1.0 - fr.x) : fr.x) * ((o.y == 0) ? (1.0 - fr.y) : fr.y);
            hist += w * imageLoad(imgReflHistPrev, tp);
            wSum += w;
        }
    }

    bool isCheckerSkipped = (raw.a > 0.1 && raw.a < 0.4);
    vec4 result;
    float historyAge = 0.0;
    float sampleCount = max(pc.f.y, 1.0);
    float maxHistory = max(pc.f.x, 1.0);

    if (isCheckerSkipped) {
        if (wSum > 0.05) {
            // Re-use full history from previous frame when this pixel was active
            result = vec4((hist / wSum).rgb, 1.0);
            historyAge = hist.a / wSum;
        } else {
            // Disocclusion / history invalid: Bilateral reconstruction from 4 active neighbors
            vec3 neighborSum = vec3(0.0);
            float weightSum = 0.0;
            const ivec2 offsets[4] = ivec2[](ivec2(1, 0), ivec2(-1, 0), ivec2(0, 1), ivec2(0, -1));
            for (int i = 0; i < 4; ++i) {
                ivec2 np = px + offsets[i];
                if (any(lessThan(np, ivec2(0))) || any(greaterThanEqual(np, isize))) continue;
                vec4 nVal = imageLoad(imgRefl, np);
                if (nVal.a < 0.5) continue;

                float nDepth = texelFetch(uDepth, np, 0).r;
                float depthDiff = abs(nDepth - d);
                if (depthDiff > 0.005 * (1.0 + d * 10.0)) continue;

                ivec2 nGeomPx = clamp(ivec2(((vec2(np) + 0.5) / size) * vec2(geomCurSize)), ivec2(0), geomCurSize - 1);
                vec4 nGeom = imageLoad(imgGeomCur, nGeomPx);
                vec3 nNormal = rtOctDecode(nGeom.xy);
                float normalDot = max(dot(nNormal, N), 0.0);
                if (normalDot < 0.75) continue;

                float w = normalDot / (1.0 + depthDiff * 100.0);
                neighborSum += nVal.rgb * w;
                weightSum += w;
            }
            if (weightSum > 1e-4) {
                result = vec4(neighborSum / weightSum, 1.0);
            } else {
                result = vec4(0.0);
            }
            // Checkerboard reconstruction has no new ray sample; preserve age only when history was accepted.
        }
    } else {
        if (wSum > 0.05) {
            hist /= wSum;

            // 3x3 Neighborhood Clamping for specular reflections
            vec4 boxMin = raw;
            vec4 boxMax = raw;
            vec4 m1 = vec4(0.0);
            vec4 m2 = vec4(0.0);
            float count = 0.0;
            for (int dy = -1; dy <= 1; ++dy) {
                for (int dx = -1; dx <= 1; ++dx) {
                    ivec2 sp = px + ivec2(dx, dy);
                    if (any(lessThan(sp, ivec2(0))) || any(greaterThanEqual(sp, isize))) continue;
                    vec4 sVal = imageLoad(imgRefl, sp);
                    if (sVal.a < 0.5) continue; // Skip checkerboard-skipped or empty neighbors
                    boxMin = (count == 0.0) ? sVal : min(boxMin, sVal);
                    boxMax = (count == 0.0) ? sVal : max(boxMax, sVal);
                    m1 += sVal;
                    m2 += sVal * sVal;
                    count += 1.0;
                }
            }
            if (count > 0.0) {
                m1 /= count;
                m2 /= count;
                vec4 sigma = sqrt(max(vec4(0.0), m2 - m1 * m1));
                vec4 clampMin = min(boxMin, m1 - 2.5 * sigma) - vec4(0.05);
                vec4 clampMax = max(boxMax, m1 + 2.5 * sigma) + vec4(0.05);
                hist = clamp(hist, clampMin, clampMax);
            }

            // Firefly suppression on specular hits
            raw.rgb = clamp(raw.rgb, vec3(0.0), vec3(100.0));
            // Accumulation factor (keep ~85% history for smooth specular without excessive lag)
            float alpha = (pc.f.z > 0.5) ? clamp(4.0 / max(pc.f.x, 1.0), 0.03, 0.15) : 1.0;
            result = vec4(mix(hist.rgb, raw.rgb, alpha), 1.0);
            historyAge = min(hist.a + sampleCount, maxHistory);
        } else {
            result = raw;
            historyAge = sampleCount;
        }
    }

    // Alpha of the private history image stores effective accumulated sample age.
    // The public reflection output keeps alpha=1 as its validity mask for PBR.
    imageStore(imgReflHistCur, px, vec4(result.rgb, historyAge));
    imageStore(imgRefl, px, vec4(result.rgb, 1.0));
}
