#version 460
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_shader_subgroup_arithmetic : enable
#extension GL_KHR_shader_subgroup_ballot : enable
#extension GL_EXT_ray_query : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_GOOGLE_include_directive : require

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

#include "rt_common.glsl"
#include "rt_screen.glsl"

layout(set = 1, binding = 0) uniform sampler2D uDepth;
layout(set = 1, binding = 3, rgba32f) uniform image2D imgGeomCur;
layout(set = 1, binding = 4, rgba32f) uniform image2D imgGeomPrev;
layout(set = 1, binding = 7) uniform sampler2D uGNormalRoughness;
layout(set = 1, binding = 9, rgba16f) uniform image2D imgRefl;
layout(set = 1, binding = 10, rgba16f) uniform image2D imgReflHistCur;
layout(set = 1, binding = 11, rgba16f) uniform image2D imgReflHistPrev;
layout(set = 1, binding = 12) uniform sampler2D uMotion;
layout(set = 1, binding = 15, std430) buffer RtDiagnostics { uint counters[48]; } rtDiag;
layout(set = 1, binding = 18, rgba32f) uniform image2D imgReflGeomCur;
layout(set = 1, binding = 19, rgba32f) uniform readonly image2D imgReflGeomPrev;

vec3 rgbToYCoCg(vec3 c) {
    return vec3(
         0.25 * c.r + 0.5 * c.g + 0.25 * c.b,
         0.5  * c.r             - 0.5  * c.b,
        -0.25 * c.r + 0.5 * c.g - 0.25 * c.b
    );
}

vec3 yCoCgToRgb(vec3 c) {
    float y  = c.x;
    float co = c.y;
    float cg = c.z;
    return vec3(
        y + co - cg,
        y + cg,
        y - co - cg
    );
}

layout(push_constant) uniform PC {
    mat4 prevViewProj;
    vec4 f;   // x = max history, y = samples, z = history valid
    uvec4 u;
} pc;

void addDiagCounter(uint counterIdx, uint value) {
    uint sgSum = subgroupAdd(value);
    if (subgroupElect() && sgSum != 0u) {
        atomicAdd(rtDiag.counters[counterIdx], sgSum);
    }
}

void processPixel(ivec2 px, out uint ageBin, out bool histogramCounted, out bool rejectedCounted, out uint pixelDiag[16]) {
    for (int i = 0; i < 16; ++i) pixelDiag[i] = 0u;
    histogramCounted = false;
    rejectedCounted = false;
    ageBin = 0u;
    ivec2 isize = imageSize(imgRefl);
    if (any(greaterThanEqual(px, isize))) return;
    vec2 size = vec2(isize);

    float d = texelFetch(uDepth, px, 0).r;
    if (d >= 1.0) { // Sky is not a reflection sample.
        imageStore(imgReflGeomCur, px, vec4(0.0, 0.0, 0.0, -1.0));
        rejectedCounted = true;
        return;
    }

    vec4 gNR = texelFetch(uGNormalRoughness, px, 0);
    vec3 N = gNR.xyz;
    if (dot(N, N) <= 1e-4) {
        imageStore(imgReflGeomCur, px, vec4(0.0, 0.0, 0.0, -1.0));
        rejectedCounted = true;
        return;
    }
    N = normalize(N);
    float roughness = clamp(gNR.w, 0.0, 1.0);
    vec4 raw = imageLoad(imgRefl, px);

    if ((pc.u.w & (1u << 15)) != 0u) {
        vec3 bypassP = rtWorldPos(vec2(px) + 0.5, d, size);
        float bypassViewDepth = -(ubo.view * vec4(bypassP, 1.0)).z;
        imageStore(imgReflGeomCur, px, vec4(N, bypassViewDepth));
        float valid = raw.a > 0.0 ? 1.0 : 0.0;
        imageStore(imgReflHistCur, px, vec4(raw.rgb, valid));
        imageStore(imgRefl, px, raw);
        ageBin = 0u;
        histogramCounted = true;
        return;
    }

    // The trace pass already writes exact zero for sky, invalid normals and
    // roughness-cutoff pixels. Keep their geometry invalid for reprojection,
    // but do not reconstruct world position or rewrite two already-empty images.
    if (raw.a <= 0.0) {
        histogramCounted = false; // Not a traced reflection sample; never enter age Bin 00.
        imageStore(imgReflGeomCur, px, vec4(0.0, 0.0, 0.0, -1.0));
        rejectedCounted = true;
        if (!all(equal(raw, vec4(0.0))))
            imageStore(imgRefl, px, raw);
        return;
    }

    vec3 P = rtWorldPos(vec2(px) + 0.5, d, size);
    float currentViewDepth = -(ubo.view * vec4(P, 1.0)).z;
    imageStore(imgReflGeomCur, px, vec4(N, currentViewDepth));

    vec3 toCam = ubo.cameraPos.xyz - P;
    vec3 toCamNorm = (dot(toCam, toCam) > 1e-6) ? normalize(toCam) : vec3(0.0, 1.0, 0.0);
    float nDotV = clamp(abs(dot(N, toCamNorm)), 0.15, 1.0);

    vec4 hist = vec4(0.0);
    float wSum = 0.0;

    vec2 curUV = (vec2(px) + 0.5) / size;
    vec2 motion = texelFetch(uMotion, px, 0).xy;
    vec4 pClip = pc.prevViewProj * vec4(P, 1.0);
    if (pc.f.z > 0.5) {
        vec2 prevUV = curUV - motion;
        if (dot(motion, motion) < 1e-9 && pClip.w > 1e-4) {
            prevUV = (pClip.xy / pClip.w) * 0.5 + 0.5;
        }
        vec2 prevPx = prevUV * size - 0.5;
        ivec2 base = ivec2(floor(prevPx));
        vec2 fr = prevPx - vec2(base);

        // Slope-aware depth tolerance for reflections
        float depthTol = (0.03 * pClip.w + 0.01) / nDotV;

        uint rejectedBounds = 0u;
        uint rejectedDepth = 0u;
        uint rejectedNormal = 0u;
        for (int i = 0; i < 4; ++i) {
            ivec2 o = ivec2(i & 1, i >> 1);
            ivec2 tp = base + o;
            if (any(lessThan(tp, ivec2(0))) || any(greaterThanEqual(tp, isize))) { rejectedBounds++; continue; }
            vec4 prevGeom = imageLoad(imgReflGeomPrev, tp);
            if (prevGeom.w < 0.0) continue;
            if (abs(prevGeom.w - pClip.w) > depthTol) { rejectedDepth++; continue; }
            if (dot(normalize(prevGeom.xyz), N) < 0.85) { rejectedNormal++; continue; }
            float w = ((o.x == 0) ? (1.0 - fr.x) : fr.x) * ((o.y == 0) ? (1.0 - fr.y) : fr.y);
            hist += w * imageLoad(imgReflHistPrev, tp);
            wSum += w;
        }
        if (rejectedBounds != 0u) pixelDiag[11] += rejectedBounds;
        if (rejectedDepth != 0u) pixelDiag[12] += rejectedDepth;
        if (rejectedNormal != 0u) pixelDiag[13] += rejectedNormal;


    }

    bool isCheckerSkipped = (raw.a > 0.1 && raw.a < 0.4);
    vec4 result;
    float historyAge = 0.0;
        float maxHistory = max(pc.f.x, 1.0);
    bool denoiseMirrors = (pc.u.w & (1u << 14)) != 0u;
    bool mirrorTemporalOnly = roughness < 0.08 && !denoiseMirrors;
    float motionPixels = length(motion * size);
    float effectiveMaxHistory = mirrorTemporalOnly ? maxHistory :
        mix(maxHistory, max(4.0, maxHistory * 0.25), clamp(motionPixels * 0.08, 0.0, 1.0));

    if (isCheckerSkipped) {
        if (wSum > 0.05) {
            pixelDiag[14] += 1u;
            // Re-use full history from previous frame when this pixel was active
            result = vec4((hist / wSum).rgb, 1.0);
            historyAge = min(hist.a / wSum, effectiveMaxHistory);
        } else {
            pixelDiag[15] += 1u;
            // Disocclusion / history invalid: Bilateral reconstruction from 4 active neighbors with linear depth
            vec3 neighborSum = vec3(0.0);
            float weightSum = 0.0;
            float linDepth = rtLinearDepth(d);
            const ivec2 offsets[4] = ivec2[](ivec2(1, 0), ivec2(-1, 0), ivec2(0, 1), ivec2(0, -1));
            for (int i = 0; i < 4; ++i) {
                ivec2 np = px + offsets[i];
                if (any(lessThan(np, ivec2(0))) || any(greaterThanEqual(np, isize))) continue;
                vec4 nVal = imageLoad(imgRefl, np);
                if (nVal.a < 0.5) continue;

                float nDepth = texelFetch(uDepth, np, 0).r;
                float depthDiff = abs(rtLinearDepth(nDepth) - linDepth);
                if (depthDiff > 0.04 * linDepth + 0.02) continue;

                vec4 nGNR = texelFetch(uGNormalRoughness, np, 0);
                if (dot(nGNR.xyz, nGNR.xyz) <= 1e-4) continue;
                float normalDot = max(dot(normalize(nGNR.xyz), N), 0.0);
                if (normalDot < 0.75) continue;

                float w = normalDot / (1.0 + depthDiff * 50.0);
                neighborSum += nVal.rgb * w;
                weightSum += w;
            }
            if (weightSum > 1e-4) {
                result = vec4(neighborSum / weightSum, 1.0);
            } else {
                result = vec4(0.0);
            }
        }
    } else {
        if (wSum > 0.05) {
            pixelDiag[9] += 1u;
            hist /= wSum;

            bool outlierFilterEnabled = (pc.u.w & (1u << 16)) != 0u;

            if (mirrorTemporalOnly) {
                // Mirror surfaces (roughness < 0.08) with mirror denoiser off:
                // Primary rays are deterministic, so there is ZERO directional Monte Carlo noise.
                // Reproject and temporally accumulate without neighborhood variance clamping
                // so sharp specular highlights, light bulbs, and reflection edges are NEVER crushed or dimmed!
                historyAge = min(hist.a + 1.0, effectiveMaxHistory);
                float minAlpha = 1.0 / effectiveMaxHistory;
                float alpha = (pc.f.z > 0.5) ? clamp(1.0 / historyAge, minAlpha, 1.0) : 1.0;
                result = vec4(mix(hist.rgb, raw.rgb, alpha), 1.0);
            } else {
                // Rough specular surfaces or mirror denoiser enabled:
                // 3x3 Neighborhood Hampel Outlier & Variance Clamping in YCoCg for specular reflections
                vec3 rawY = rgbToYCoCg(raw.rgb);
                vec3 m1Y = vec3(0.0);
                vec3 m2Y = vec3(0.0);
                float count = 0.0;
                for (int dy = -1; dy <= 1; ++dy) {
                    for (int dx = -1; dx <= 1; ++dx) {
                        if (dx == 0 && dy == 0) continue; // Exclude center to avoid firefly self-contamination
                        ivec2 sp = px + ivec2(dx, dy);
                        if (any(lessThan(sp, ivec2(0))) || any(greaterThanEqual(sp, isize))) continue;
                        vec4 sVal = imageLoad(imgRefl, sp);
                        if (sVal.a < 0.5) continue; // Skip checkerboard-skipped or empty neighbors
                        vec3 sY = rgbToYCoCg(sVal.rgb);
                        m1Y += sY;
                        m2Y += sY * sY;
                        count += 1.0;
                    }
                }
                if (count >= 2.0) {
                    m1Y /= count;
                    m2Y /= count;
                    vec3 sigmaY = sqrt(max(vec3(0.0), m2Y - m1Y * m1Y));
                    float gamma = 1.5 + 1.5 * clamp(hist.a / 16.0, 0.0, 1.0);

                    // Variance floor: prevent zero-clipping of weak reflections in dark areas
                    vec3 effectiveSigma = max(sigmaY, vec3(0.06, 0.03, 0.03));
                    vec3 clampMinY = m1Y - gamma * effectiveSigma;
                    vec3 clampMaxY = m1Y + gamma * effectiveSigma;
                    clampMinY.x = max(0.0, clampMinY.x);
                    clampMaxY.x = max(clampMinY.x, clampMaxY.x);

                    vec3 histY = rgbToYCoCg(hist.rgb);

                    // Preserve bright features that have spatial support. A single high
                    // sample is rejected only when it is a rare outlier in a populated patch.
                    float floorThreshold = (roughness < 0.08) ? 64.0 : 16.0;
                    float fireflyThreshold = max(6.0 * sigmaY.x, max(m1Y.x * 7.0, floorThreshold));
                    float supportThreshold = max(m1Y.x + sigmaY.x, rawY.x * 0.5);
                    float brightNeighborCount = 0.0;
                    float maxSupportedLum = clampMaxY.x;
                    for (int fy = -1; fy <= 1; ++fy) {
                        for (int fx = -1; fx <= 1; ++fx) {
                            if (fx == 0 && fy == 0) continue;
                            ivec2 fp = px + ivec2(fx, fy);
                            if (any(lessThan(fp, ivec2(0))) || any(greaterThanEqual(fp, isize))) continue;
                            vec4 fVal = imageLoad(imgRefl, fp);
                            if (fVal.a < 0.5) continue;
                            float neighborLum = dot(fVal.rgb, vec3(0.2126, 0.7152, 0.0722));
                            if (neighborLum >= supportThreshold) {
                                brightNeighborCount += 1.0;
                                maxSupportedLum = max(maxSupportedLum, neighborLum);
                            }
                        }
                    }
                    bool isolatedFirefly = count >= 4.0 &&
                        brightNeighborCount <= floor(count * 0.125);
                    // Expand the upper bound for bright features supported by neighboring samples.
                    if (!isolatedFirefly) clampMaxY.x = max(clampMaxY.x, maxSupportedLum);
                    if (outlierFilterEnabled)
                        histY = clamp(histY, clampMinY, clampMaxY);
                    hist.rgb = max(vec3(0.0), yCoCgToRgb(histY));
                    if (outlierFilterEnabled && isolatedFirefly &&
                        rawY.x > m1Y.x + fireflyThreshold) {
                        rawY.x = m1Y.x + fireflyThreshold;
                        raw.rgb = max(vec3(0.0), yCoCgToRgb(rawY));
                    }
                }

                raw.rgb = max(raw.rgb, vec3(0.0)); // Do not impose a fixed ceiling on legitimate specular energy.
                historyAge = min(hist.a + 1.0, maxHistory);
                float minAlpha = 1.0 / maxHistory;
                float alpha = (pc.f.z > 0.5) ? clamp(1.0 / historyAge, minAlpha, 1.0) : 1.0;
                result = vec4(mix(hist.rgb, raw.rgb, alpha), 1.0);
            }
        } else {
            rejectedCounted = true;
            result = raw;
            historyAge = 1.0;
        }
    }

    // Alpha of the private history image stores effective accumulated sample age.
    // The public reflection output keeps alpha=1 as its validity mask for PBR.
    ageBin = min(uint(clamp(historyAge / effectiveMaxHistory, 0.0, 0.999999) * 16.0), 15u);
    histogramCounted = true;
    imageStore(imgReflHistCur, px, vec4(result.rgb, historyAge));
    imageStore(imgRefl, px, vec4(result.rgb, 1.0));
}

void main() {
    uint ageBin = 0u;
    bool histogramCounted = false;
    bool rejectedCounted = false;
    uint pixelDiag[16];
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    processPixel(px, ageBin, histogramCounted, rejectedCounted, pixelDiag);

    uint diagMask = 0u;
    for (uint metric = 0u; metric < 16u; ++metric) diagMask |= pixelDiag[metric];
    uvec4 diagBallot = subgroupBallot(diagMask != 0u);
    if (subgroupBallotBitCount(diagBallot) != 0u) {
        for (uint metric = 0u; metric < 16u; ++metric) {
            addDiagCounter(metric, pixelDiag[metric]);
        }
    }

    // Most roughness-cutoff / sky subgroups have no valid age samples.
    // Skip all sixteen bin ballots when the subgroup has no histogram entries.
    uvec4 histogramBallot = subgroupBallot(histogramCounted);
    if (subgroupBallotBitCount(histogramBallot) != 0u) {
        for (uint bin = 0u; bin < 16u; ++bin) {
            uvec4 ballot = subgroupBallot(histogramCounted && ageBin == bin);
            uint binCount = subgroupBallotBitCount(ballot);
            if (subgroupElect() && binCount != 0u) {
                atomicAdd(rtDiag.counters[32u + bin], binCount);
            }
        }
    }

    uvec4 rejectedBallot = subgroupBallot(rejectedCounted);
    uint rejectedTotal = subgroupBallotBitCount(rejectedBallot);
    if (subgroupElect() && rejectedTotal != 0u) {
        atomicAdd(rtDiag.counters[10], rejectedTotal);
    }
}
