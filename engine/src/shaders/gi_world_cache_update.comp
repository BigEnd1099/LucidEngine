#version 460
#extension GL_EXT_ray_query : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_GOOGLE_include_directive : require

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

#include "rt_common.glsl"
#include "gi_world_cache_common.glsl"

layout(std430, set = 1, binding = 0) buffer WorldRadianceGridBuffer {
    WorldRadianceCell cells[];
} worldCache;

layout(push_constant) uniform PC {
    vec4 cameraPosAndCellSize; // xyz = cameraPos, w = cellSize
    vec4 sunDirAndIntensity;   // xyz = sunDirection, w = sunIntensity
    vec4 sunColor;             // rgb = sunColor, a = reserved
    uvec4 frameAndSlice;       // x = frameIndex, y = sliceOffset, z = cellCount, w = reserved
} pc;

void main() {
    uint threadIdx = gl_GlobalInvocationID.x;
    if (threadIdx >= pc.frameAndSlice.z) return;

    rngInit(uvec2(threadIdx + pc.frameAndSlice.y, pc.frameAndSlice.x), pc.frameAndSlice.x);

    // Compute probe coordinate in camera-relative volume [-16..16]
    uint gridDim = 32u;
    uint idx = threadIdx % (gridDim * gridDim * gridDim);
    int gz = int(idx / (gridDim * gridDim)) - 16;
    uint rem = idx % (gridDim * gridDim);
    int gy = int(rem / gridDim) - 16;
    int gx = int(rem % gridDim) - 16;

    float cellSize = pc.cameraPosAndCellSize.w > 0.0 ? pc.cameraPosAndCellSize.w : WORLD_CACHE_CELL_SIZE;
    vec3 probePos = pc.cameraPosAndCellSize.xyz + vec3(float(gx), float(gy), float(gz)) * cellSize;

    // Pick a hemisphere normal based on random direction
    vec3 sampleDir = normalize(vec3(rand1() * 2.0 - 1.0, rand1() * 2.0 - 1.0, rand1() * 2.0 - 1.0));
    if (length(sampleDir) < 0.1) sampleDir = vec3(0.0, 1.0, 0.0);

    // Ray query to test scene surface and illumination
    rayQueryEXT rq;
    rayQueryInitializeEXT(rq, sceneTLAS, gl_RayFlagsOpaqueEXT, 0xFF, probePos, 0.01, sampleDir, 40.0);
    while (rayQueryProceedEXT(rq)) {}

    vec3 hitRad = vec3(0.0);
    vec3 normal = sampleDir;

    if (rayQueryGetIntersectionTypeEXT(rq, true) != gl_RayQueryCommittedIntersectionNoneEXT) {
        float hitDist = rayQueryGetIntersectionTEXT(rq, true);
        vec3 hitPos = probePos + sampleDir * hitDist;

        // Sunlight visibility check from hit point
        vec3 sunDir = normalize(pc.sunDirAndIntensity.xyz);
        rayQueryEXT shadowQuery;
        rayQueryInitializeEXT(shadowQuery, sceneTLAS, gl_RayFlagsTerminateOnFirstHitEXT | gl_RayFlagsOpaqueEXT,
                              0xFF, hitPos + sunDir * 0.02, 0.01, sunDir, 100.0);
        while (rayQueryProceedEXT(shadowQuery)) {}

        float shadow = (rayQueryGetIntersectionTypeEXT(shadowQuery, true) == gl_RayQueryCommittedIntersectionNoneEXT) ? 1.0 : 0.0;
        float NdotL = max(dot(normal, sunDir), 0.0);
        hitRad = pc.sunColor.rgb * (pc.sunDirAndIntensity.w * NdotL * shadow);
    } else {
        hitRad = textureLod(envCubemap, sampleDir, 4.0).rgb * 0.5;
    }

    uint hIndex = hashWorldCell(probePos, normal, cellSize);
    WorldRadianceCell current = worldCache.cells[hIndex];

    // Temporal accumulation with exponential moving average
    float prevWeight = current.irradiance.a;
    float blendFactor = clamp(1.0 / (prevWeight + 1.0), 0.05, 0.5);
    vec3 newIrr = mix(current.irradiance.rgb, hitRad, blendFactor);
    float newWeight = min(prevWeight + 1.0, 32.0);

    worldCache.cells[hIndex].irradiance = vec4(newIrr, newWeight);
    worldCache.cells[hIndex].cellKey = hIndex;
    worldCache.cells[hIndex].packedNormal = packNormalOctahedral(normal);
    worldCache.cells[hIndex].lastSeenFrame = pc.frameAndSlice.x;
    worldCache.cells[hIndex].lockOrFlags = 0u;
}
