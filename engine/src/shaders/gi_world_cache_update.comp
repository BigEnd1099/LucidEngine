#version 460
#extension GL_EXT_ray_query : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_GOOGLE_include_directive : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_KHR_shader_subgroup_ballot : require

layout(local_size_x = 32, local_size_y = 1, local_size_z = 1) in;

#include "rt_common.glsl"
#include "gi_world_cache_common.glsl"

layout(std430, set = 1, binding = 0) coherent buffer WorldRadianceGridBuffer {
    WorldRadianceCell cells[];
} worldCache;

layout(push_constant) uniform PC {
    vec4 cameraPosAndCellSize; // xyz = cameraPos, w = cellSize
    vec4 sunDirAndIntensity;   // xyz = sunDirection, w = sunIntensity
    vec4 sunColor;             // rgb = sunColor, a = reserved
    uvec4 frameAndSlice;       // x = frameIndex, y = sliceOffset, z = cellCount, w = reserved
} pc;

void main() {
    uint cellBatchIdx = gl_WorkGroupID.x;
    if (cellBatchIdx >= pc.frameAndSlice.z) return;

    uint probeLinearIdx = (cellBatchIdx + pc.frameAndSlice.y) & 32767u;
    rngInit(uvec2(probeLinearIdx, pc.frameAndSlice.x), pc.frameAndSlice.x);

    uint flags = pc.frameAndSlice.w;
    bool clipmapEnabled = (flags & 1u) != 0u;
    bool stratifiedEnabled = (flags & 4u) != 0u;
    float baseCellSize = pc.cameraPosAndCellSize.w > 0.05 ? pc.cameraPosAndCellSize.w : DEFAULT_CELL_SIZE;
    float bounceIntensity = max(pc.sunColor.a, 0.0);
    float cellSize = baseCellSize;
    vec3 cameraPos = pc.cameraPosAndCellSize.xyz;

    // Uniform full-sphere ray direction shared across all 32 lanes in this cell workgroup
    float dirY = 1.0 - 2.0 * rand1();
    float dirPhi = 6.28318530718 * rand1();
    float dirRadius = sqrt(max(0.0, 1.0 - dirY * dirY));
    vec3 sampleDir = vec3(dirRadius * cos(dirPhi), dirY,
                          dirRadius * sin(dirPhi));

    vec3 probePos;
    if ((cellBatchIdx & 3u) != 0u) {
        // 75% of rays originate near the player/camera with tiny spherical jitter
        float offsetY = 1.0 - 2.0 * rand1();
        float offsetPhi = 6.28318530718 * rand1();
        float offsetRadius = sqrt(max(0.0, 1.0 - offsetY * offsetY));
        vec3 offsetDir = vec3(offsetRadius * cos(offsetPhi), offsetY,
                              offsetRadius * sin(offsetPhi));
        probePos = cameraPos + offsetDir * (0.35 * rand1());
    } else {
        // 25% maintain broad spatial coverage in structured grid around camera
        int gz = int(probeLinearIdx / 1024u) - 16;
        uint rem = probeLinearIdx % 1024u;
        int gy = int(round(float(rem / 32u) * (16.0 / 31.0))) - 2;
        int gx = int(rem % 32u) - 16;
        probePos = cameraPos + vec3(float(gx), float(gy), float(gz)) * cellSize;
    }

    RtInstanceData hit;
    vec3 hitPos, hitNormal;
    vec2 hitUv;
    vec4 hitTangent;
    float hitDistance;
    bool hitSurface = traceSceneSurface(probePos, sampleDir, 40.0,
            hit, hitPos, hitNormal, hitUv, hitTangent, hitDistance);
    if (!hitSurface) {
        sampleDir = normalize(vec3(sampleDir.x, -abs(sampleDir.y) - 0.35, sampleDir.z));
        hitSurface = traceSceneSurface(probePos, sampleDir, 40.0,
            hit, hitPos, hitNormal, hitUv, hitTangent, hitDistance);
    }
    if (!hitSurface) return;

    vec3 cellNormal = normalize(hitNormal);
    if (dot(cellNormal, -sampleDir) < 0.0) cellNormal = -cellNormal;

    // System #1: 32 threads in the workgroup correspond to 1 active cell.
    // Each lane gl_SubgroupInvocationID (0..31) calculates a stratified direction in the hemisphere:
    // 8x4 stratified octahedral grid (8 azimuth columns, 4 elevation rings).
    uint lane = gl_LocalInvocationIndex & 31u;
    rngInit(uvec2(probeLinearIdx, pc.frameAndSlice.x + lane * 1013904223u), pc.frameAndSlice.x);
    vec2 laneJitter = vec2(rand1(), rand1());
    vec3 bounceDir = stratifiedEnabled
        ? getStratifiedHemisphereDirection(cellNormal, lane, laneJitter)
        : sampleCosineHemisphere(cellNormal, laneJitter);

    RtInstanceData bounceHit;
    vec3 bouncePos, bounceNormal;
    vec2 bounceUv;
    vec4 bounceTangent;
    float bounceDist;
    vec3 hitRad = vec3(0.0);
    if (traceSceneSurface(hitPos + cellNormal * 0.02, bounceDir, 30.0,
            bounceHit, bouncePos, bounceNormal, bounceUv, bounceTangent, bounceDist)) {
        vec3 bN = normalize(bounceNormal);
        if (dot(bN, -bounceDir) < 0.0) bN = -bN;
        hitRad = shadeRtHitEx(bounceHit, bouncePos, bN, bounceUv, bounceTangent,
                              bounceDir, true, -1.0, -1, 1.0, 1.5);
        uint bCascade = getCascadeIndexCfg(bouncePos, cameraPos, 0.0, clipmapEnabled);
        float bCellSize = getCascadeCellSizeCfg(bCascade, baseCellSize, clipmapEnabled);
        uint bKey = computeWorldCellKey(bouncePos, bN, bCellSize, bCascade);
        uint bBase = bKey % CACHE_CELL_COUNT;
        for (uint bp = 0u; bp < 4u; ++bp) {
            WorldRadianceCell bCell = worldCache.cells[(bBase + bp) % CACHE_CELL_COUNT];
            if (bCell.cellKey == bKey && bCell.irradiance.a > 0.0 &&
                dot(unpackNormalOctahedral(bCell.packedNormal), bN) > 0.65) {
                vec3 bAlbedo = bounceHit.baseColor.rgb *
                    pow(max(textureLod(rtAlbedoTextures[nonuniformEXT(bounceHit.textureIndices.x)], bounceUv, 2.0).rgb, vec3(0.0)), vec3(2.2));
                float bMetallic = clamp(bounceHit.material.x *
                    textureLod(rtOrmTextures[nonuniformEXT(bounceHit.textureIndices.z)], bounceUv, 2.0).b, 0.0, 1.0);
                float bConf = smoothstep(1.0, 16.0, bCell.irradiance.a);
                hitRad += bAlbedo * (1.0 - bMetallic) * bCell.irradiance.rgb * bConf * bounceIntensity;
                break;
            }
        }
    } else {
        hitRad = sampleRtSkyRadiance(bounceDir);
    }

    // Outlier clamp per sample before reduction
    float hitLum = dot(hitRad, vec3(0.2126, 0.7152, 0.0722));
    if (hitLum > 4.0) {
        hitRad *= (4.0 / hitLum);
    }

    // Hardware subgroup reduction across the 32 lanes
    vec3 avgRad = subgroupAdd(hitRad) / 32.0;

    // Master lane writes the 32-sample averaged irradiance into the cell
    if (subgroupElect()) {
        uint cascade = getCascadeIndexCfg(hitPos, cameraPos, 0.0, clipmapEnabled);
        cellSize = getCascadeCellSizeCfg(cascade, baseCellSize, clipmapEnabled);
        vec3 biasedPos = hitPos + cellNormal * (cellSize * 0.25);
        ivec3 cellCoord = ivec3(floor(biasedPos / cellSize));
        uint cellKey = computeWorldCellKeyFromCoord(cellCoord, cellNormal, cascade);
        uint baseIndex = cellKey % CACHE_CELL_COUNT;

        for (uint probe = 0u; probe < 4u; ++probe) {
            uint hIndex = (baseIndex + probe) % CACHE_CELL_COUNT;
            bool acquired = false;
            for (uint spin = 0u; spin < 64u; ++spin) {
                if ((atomicOr(worldCache.cells[hIndex].lockOrFlags, 1u) & 1u) == 0u) {
                    acquired = true;
                    break;
                }
            }
            if (!acquired) continue;

            memoryBarrierBuffer();
            WorldRadianceCell prevCell = worldCache.cells[hIndex];
            float prevWeight = prevCell.irradiance.a;
            bool expired = (prevWeight <= 0.0) ||
                (pc.frameAndSlice.x < prevCell.lastSeenFrame);
            bool keyMismatch = prevCell.cellKey != cellKey;
            bool normalMismatch = !expired &&
                dot(unpackNormalOctahedral(prevCell.packedNormal), cellNormal) < 0.5;

            if (!expired && (keyMismatch || normalMismatch)) {
                memoryBarrierBuffer();
                atomicAnd(worldCache.cells[hIndex].lockOrFlags, ~1u);
                continue;
            }

            float newWeight;
            vec3 newIrr;
            if (expired) {
                // A 32-lane warp already integrates 32 hemisphere rays on the first update.
                // Start weight at 8.0 so confidence is immediately non-zero on first hit.
                newWeight = 8.0;
                newIrr = avgRad;
            } else {
                newWeight = min(prevWeight + 4.0, 64.0);
                float alpha = clamp(4.0 / newWeight, 0.05, 0.25);
                newIrr = mix(prevCell.irradiance.rgb, avgRad, alpha);
            }

            worldCache.cells[hIndex].irradiance = vec4(sanitizeHDR(newIrr), newWeight);
            worldCache.cells[hIndex].cellKey = cellKey;
            worldCache.cells[hIndex].packedNormal = packNormalOctahedral(cellNormal);
            worldCache.cells[hIndex].lastSeenFrame = pc.frameAndSlice.x;
            memoryBarrierBuffer();
            atomicExchange(worldCache.cells[hIndex].lockOrFlags, packCellCoord(cellCoord, cascade) << 1u);
            return;
        }
    }
}
