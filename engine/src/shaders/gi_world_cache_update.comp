#version 460
#extension GL_EXT_ray_query : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_GOOGLE_include_directive : require

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

#include "rt_common.glsl"
#include "gi_world_cache_common.glsl"

layout(std430, set = 1, binding = 0) coherent buffer WorldRadianceGridBuffer {
    WorldRadianceCell cells[];
} worldCache;

layout(push_constant) uniform PC {
    vec4 cameraPosAndCellSize; // xyz = cameraPos, w = cellSize
    vec4 sunDirAndIntensity;   // xyz = sunDirection, w = sunIntensity
    vec4 sunColor;             // rgb = sunColor, a = reserved
    uvec4 frameAndSlice;       // x = frameIndex, y = sliceOffset, z = cellCount, w = reserved
} pc;

void main() {
    uint threadIdx = gl_GlobalInvocationID.x;
    if (threadIdx >= pc.frameAndSlice.z) return;

    uint probeLinearIdx = (gl_GlobalInvocationID.x + pc.frameAndSlice.y) & 32767u;
    rngInit(uvec2(probeLinearIdx, pc.frameAndSlice.x), pc.frameAndSlice.x);

    // Camera-relative 32^3 probe volume. The slice offset now selects a distinct
    // contiguous segment of the volume instead of repeatedly updating its origin.
    int gz = int(probeLinearIdx / 1024u) - 16;
    uint rem = probeLinearIdx % 1024u;
    int gy = int(rem / 32u) - 16;
    int gx = int(rem % 32u) - 16;

    float cellSize = pc.cameraPosAndCellSize.w > 0.0 ? pc.cameraPosAndCellSize.w : DEFAULT_CELL_SIZE;
    vec3 probePos = pc.cameraPosAndCellSize.xyz + vec3(float(gx), float(gy), float(gz)) * cellSize;
    // Probe the full sphere. The old +Y cosine hemisphere systematically
    // missed floors and many side-facing surfaces in ordinary indoor scenes.
    float dirY = 1.0 - 2.0 * rand1();
    float dirPhi = 6.28318530718 * rand1();
    float dirRadius = sqrt(max(0.0, 1.0 - dirY * dirY));
    vec3 sampleDir = vec3(dirRadius * cos(dirPhi), dirY,
                          dirRadius * sin(dirPhi));

    RtInstanceData hit;
    vec3 hitPos, hitNormal;
    vec2 hitUv;
    vec4 hitTangent;
    float hitDistance;
    if (!traceSceneSurface(probePos, sampleDir, 40.0,
            hit, hitPos, hitNormal, hitUv, hitTangent, hitDistance)) {
        // This cache is queried using visible surface positions and normals.
        // Sky misses have no matching surface key and only pollute the table.
        return;
    }

    vec3 cellNormal = normalize(hitNormal);
    // computeWorldCellKey applies the same normal-directed voxel bias used
    // by G-buffer lookups, so ray-hit and visible surface keys agree.
    vec3 hitRad = shadeRtHitEx(hit, hitPos, hitNormal, hitUv, hitTangent,
                               sampleDir, true, 0.25);
    uint cellKey = computeWorldCellKey(hitPos, cellNormal, cellSize);
    uint hIndex = cellKey % CACHE_CELL_COUNT;
    // Multiple probe rays can map to the same spatial hash cell in one dispatch.
    // Serialize the read/modify/write so the EMA and normal/key metadata cannot tear.
    bool acquired = false;
    for (uint spin = 0u; spin < 64u; ++spin) {
        if (atomicCompSwap(worldCache.cells[hIndex].lockOrFlags, 0u, 1u) == 0u) {
            acquired = true;
            break;
        }
    }
    if (!acquired) return;
    memoryBarrierBuffer();
    WorldRadianceCell prevCell = worldCache.cells[hIndex];
    float prevWeight = prevCell.irradiance.a;
    vec3 prevNormal = unpackNormalOctahedral(prevCell.packedNormal);
    bool expired = (prevWeight <= 0.0) ||
        (pc.frameAndSlice.x < prevCell.lastSeenFrame) ||
        ((pc.frameAndSlice.x - prevCell.lastSeenFrame) > 2048u);
    bool keyMismatch = prevCell.cellKey != cellKey;
    bool normalMismatch = dot(prevNormal, cellNormal) < 0.5;

    float alpha;
    float newWeight;
    vec3 newIrr;
    if (expired || keyMismatch || normalMismatch) {
        alpha = 1.0;
        newWeight = 1.0;
        newIrr = hitRad;
    } else {
        newWeight = min(prevWeight + 1.0, 32.0);
        alpha = max(1.0 / newWeight, 0.05);
        newIrr = mix(prevCell.irradiance.rgb, hitRad, alpha);
    }

    worldCache.cells[hIndex].irradiance = vec4(sanitizeHDR(newIrr), newWeight);
    worldCache.cells[hIndex].cellKey = cellKey;
    worldCache.cells[hIndex].packedNormal = packNormalOctahedral(cellNormal);
    worldCache.cells[hIndex].lastSeenFrame = pc.frameAndSlice.x;
    memoryBarrierBuffer();
    atomicExchange(worldCache.cells[hIndex].lockOrFlags, 0u);
}
