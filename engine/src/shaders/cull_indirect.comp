#version 460
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

struct InstanceCullData {
    mat4 modelMatrix;
    vec4 boundingSphere; // xyz = local center, w = radius
    uint indexCount;
    uint instanceCount;  // 1
    uint firstIndex;
    int  vertexOffset;
    uint firstInstance;
    uint padding[3];
};

struct DrawIndexedIndirectCommand {
    uint indexCount;
    uint instanceCount;
    uint firstIndex;
    int  vertexOffset;
    uint firstInstance;
};

layout(std430, set = 0, binding = 0) readonly buffer InstanceInputBuffer {
    InstanceCullData instances[];
} instanceBuffer;

layout(std430, set = 0, binding = 1) writeonly buffer IndirectDrawBuffer {
    DrawIndexedIndirectCommand commands[];
} drawCommands;

layout(std430, set = 0, binding = 2) buffer DrawCountBuffer {
    uint count;
} drawCount;

layout(set = 0, binding = 3) uniform sampler2D u_HiZMap;

layout(push_constant) uniform PushConstants {
    mat4 viewProj;
    vec4 cameraPos;
    vec4 screenParams; // xy = width, height, zw = 1.0/width, 1.0/height
    uint totalInstances;
    uint enableHiZCulling;
    uint padding[2];
} pc;

// Frustum plane extraction from ViewProj
vec4 getFrustumPlane(mat4 m, int index) {
    vec4 plane;
    switch (index) {
        case 0: plane = m[3] + m[0]; break; // Left
        case 1: plane = m[3] - m[0]; break; // Right
        case 2: plane = m[3] + m[1]; break; // Bottom
        case 3: plane = m[3] - m[1]; break; // Top
        case 4: plane = m[2];        break; // Near (Vulkan Z in [0, 1])
        case 5: plane = m[3] - m[2]; break; // Far
        default: plane = vec4(0.0); break;
    }
    float len = length(plane.xyz);
    return len > 0.0 ? plane / len : vec4(0.0);
}

void main() {
    uint index = gl_GlobalInvocationID.x;
    if (index >= pc.totalInstances) return;

    InstanceCullData inst = instanceBuffer.instances[index];

    // Transform bounding sphere center to world space
    vec3 worldCenter = (inst.modelMatrix * vec4(inst.boundingSphere.xyz, 1.0)).xyz;
    // Scale radius by maximum scale component of model matrix
    float scaleX = length(inst.modelMatrix[0].xyz);
    float scaleY = length(inst.modelMatrix[1].xyz);
    float scaleZ = length(inst.modelMatrix[2].xyz);
    float maxScale = max(max(scaleX, scaleY), scaleZ);
    float worldRadius = inst.boundingSphere.w * maxScale;

    // 1. Frustum Culling (Sphere vs 6 planes)
    bool visible = true;
    for (int i = 0; i < 6; ++i) {
        vec4 plane = getFrustumPlane(pc.viewProj, i);
        float dist = dot(plane.xyz, worldCenter) + plane.w;
        if (dist < -worldRadius) {
            visible = false;
            break;
        }
    }

    // 2. Hi-Z Occlusion Culling
    if (visible && pc.enableHiZCulling != 0u) {
        vec4 clipPos = pc.viewProj * vec4(worldCenter, 1.0);
        if (clipPos.w > 0.0) {
            // Project sphere to screen space AABB in UV coords
            vec2 screenCenter = (clipPos.xy / clipPos.w) * 0.5 + 0.5;
            screenCenter.y = 1.0 - screenCenter.y; // Invert Vulkan Y for texture UV

            // Screen space radius approximation
            float screenRadius = (worldRadius / clipPos.w) * max(pc.screenParams.x, pc.screenParams.y) * 0.5;
            vec2 aabbSize = vec2(screenRadius * pc.screenParams.z, screenRadius * pc.screenParams.w);
            vec2 minUV = clamp(screenCenter - aabbSize, 0.0, 1.0);
            vec2 maxUV = clamp(screenCenter + aabbSize, 0.0, 1.0);

            // Calculate conservative mip level covering the bounding box
            vec2 pixelSize = (maxUV - minUV) * pc.screenParams.xy;
            float maxDim = max(pixelSize.x, pixelSize.y);
            float mip = ceil(log2(max(maxDim, 1.0)));

            // Sample Hi-Z max depth
            vec2 sampleUV = (minUV + maxUV) * 0.5;
            float hzbDepth = textureLod(u_HiZMap, sampleUV, mip).r;

            // Nearest point on sphere in normalized device coordinates [0, 1]
            float nearestZ = (clipPos.z - worldRadius) / clipPos.w;
            if (nearestZ > hzbDepth + 1e-4) {
                visible = false; // Behind occluder
            }
        }
    }

    if (visible) {
        uint drawIndex = atomicAdd(drawCount.count, 1u);
        drawCommands.commands[drawIndex].indexCount = inst.indexCount;
        drawCommands.commands[drawIndex].instanceCount = 1u;
        drawCommands.commands[drawIndex].firstIndex = inst.firstIndex;
        drawCommands.commands[drawIndex].vertexOffset = inst.vertexOffset;
        drawCommands.commands[drawIndex].firstInstance = inst.firstInstance;
    }
}
