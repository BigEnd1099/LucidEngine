#version 460
#extension GL_EXT_ray_query : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_GOOGLE_include_directive : require

// Passes 3-4/4: edge-avoiding a-trous wavelet filter (5x5 B3-spline, 4-stage hierarchy step 1, 2, 4, 8),
// guided by view-space plane distance, normals, and SVGF local luminance variance.
//   PASS 0: imgHistCur -> imgA (step 1)
//   PASS 1: imgA       -> imgS (step 2)
//   PASS 2: imgS       -> imgA (step 4)
//   PASS 3: imgA       -> imgS (step 8, final output sampled by pbr_rt.frag)
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(constant_id = 0) const int PASS = 0;

#include "rt_common.glsl"
#include "rt_screen.glsl"
#include "gi_world_cache_common.glsl"
#include "gi_surface_history_common.glsl"

layout(set = 1, binding = 0) uniform sampler2D uDepth;
layout(set = 1, binding = 1, rgba16f) uniform image2D imgS;
layout(set = 1, binding = 2, rgba16f) uniform image2D imgA;
layout(set = 1, binding = 3, rgba32f) uniform image2D imgGeomCur;
layout(set = 1, binding = 5, rgba16f) uniform image2D imgHistCur;
layout(set = 1, binding = 13, rgba16f) uniform image2D imgMomentsCur; // in/out: mu1, mu2, variance, filtered_var
layout(set = 1, binding = 16, rgba16f) uniform image2D imgRawGi;
layout(set = 1, binding = 17, rgba16f) uniform image2D imgCaustics;

layout(push_constant) uniform PC {
    mat4 unused;
    vec4 f;   // x = spatial strength (0..1), y = maxHistory, w = svgfEnabled (1/0)
    uvec4 u;  // u.x = debugMode (evaluated in final pass)
} pc;

vec4 loadSrc(ivec2 p) {
    if (PASS == 0) return imageLoad(imgHistCur, p);
    if (PASS == 1 || PASS == 3) return imageLoad(imgA, p);
    return imageLoad(imgS, p); // PASS == 2
}

void storeDst(ivec2 p, vec4 v) {
    if (PASS == 0 || PASS == 2) imageStore(imgA, p, v);
    else imageStore(imgS, p, v); // PASS == 1 or PASS == 3
}

void persistFinalSurfaceHistory(ivec2 px, vec2 size, vec4 geom, vec3 filteredRadiance) {
    uvec2 writePhase = uvec2(pc.u.w & 1u, (pc.u.w >> 1u) & 1u);
    bool writeSample = all(equal((uvec2(px) & 1u), writePhase));
    if (PASS != 3 || pc.u.y == 0u || pc.u.z == 0u || geom.w < 2.0 || !writeSample) return;
    vec2 uv = (vec2(px) + 0.5) / size;
    ivec2 depthSize = textureSize(uDepth, 0);
    ivec2 depthPx = clamp(ivec2(uv * vec2(depthSize)), ivec2(0), depthSize - 1);
    float depth = texelFetch(uDepth, depthPx, 0).r;
    vec3 worldPos = rtWorldPos(vec2(px) + 0.5, depth, size);
    vec3 worldNormal = rtOctDecode(geom.xy);
    storeSurfaceHistory(worldPos, worldNormal, filteredRadiance, geom.w, pc.u.z, pc.u.w, true);
}

void main() {
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    ivec2 isize = imageSize(imgS);
    if (any(greaterThanEqual(px, isize))) return;
    vec2 size = vec2(isize);

    vec4 center = loadSrc(px);
    vec4 gC = imageLoad(imgGeomCur, px);

    // Debug visualization modes (evaluated in final pass directly into imgS)
    if ((PASS == 3 || PASS == 1) && pc.u.x > 0u) {
        uint mode = pc.u.x;
        if (gC.z < 0.0) {
            // Sky
            storeDst(px, vec4(0.0, 0.0, 0.0, 1.0));
            return;
        }
        if (mode == 1u) {
            // True raw GI trace, captured before temporal accumulation or spatial filtering.
            vec4 rawS = imageLoad(imgRawGi, px);
            storeDst(px, rawS);
            return;
        } else if (mode == 8u) {
            vec4 caustic = imageLoad(imgCaustics, px);
            storeDst(px, vec4(caustic.rgb, 1.0));
            return;
        } else if (mode == 9u) {
            float density = clamp(imageLoad(imgCaustics, px).a, 0.0, 1.0);
            storeDst(px, vec4(density, density * density, 0.0, 1.0));
            return;
        } else if (mode == 10u || mode == 11u || mode == 12u) {
            storeDst(px, imageLoad(imgHistCur, px));
            return;
        } else if (mode == 2u) {
            // History length (false color gradient normalized to maxHistory)
            float maxH = max(pc.f.y, 1.0);
            float t = clamp(gC.w / maxH, 0.0, 1.0);
            vec3 col;
            if (t <= 0.25)      col = mix(vec3(0.05, 0.05, 0.4), vec3(0.0, 0.8, 0.8), t * 4.0);
            else if (t <= 0.50) col = mix(vec3(0.0, 0.8, 0.8),   vec3(0.1, 0.9, 0.1), (t - 0.25) * 4.0);
            else if (t <= 0.75) col = mix(vec3(0.1, 0.9, 0.1),   vec3(1.0, 0.9, 0.0), (t - 0.50) * 4.0);
            else                col = mix(vec3(1.0, 0.9, 0.0),   vec3(1.0, 0.1, 0.1), (t - 0.75) * 4.0);
            storeDst(px, vec4(col, 1.0));
            return;
        } else if (mode == 3u) {
            // Geometric / reconstructed normal
            vec3 n = rtOctDecode(gC.xy);
            storeDst(px, vec4(n * 0.5 + 0.5, 1.0));
            return;
        } else if (mode == 4u) {
            // Linear depth (normalized visualization)
            float dVis = clamp(gC.z / 40.0, 0.0, 1.0);
            storeDst(px, vec4(vec3(dVis), 1.0));
            return;
        } else if (mode == 5u) {
            // AO only
            storeDst(px, vec4(vec3(center.a), 1.0));
            return;
        } else if (mode == 7u) {
            // Luminance variance from SVGF (log-scaled heat map)
            vec4 mom = imageLoad(imgMomentsCur, px);
            float v = max(mom.z, 0.0);
            float t = clamp(log2(1.0 + v * 16.0) / 4.0, 0.0, 1.0);
            vec3 col;
            if (t <= 0.25)      col = mix(vec3(0.0, 0.0, 0.5), vec3(0.0, 0.5, 1.0), t * 4.0);
            else if (t <= 0.50) col = mix(vec3(0.0, 0.5, 1.0), vec3(0.0, 0.9, 0.2), (t - 0.25) * 4.0);
            else if (t <= 0.75) col = mix(vec3(0.0, 0.9, 0.2), vec3(1.0, 0.8, 0.0), (t - 0.50) * 4.0);
            else                col = mix(vec3(1.0, 0.8, 0.0), vec3(1.0, 0.05, 0.05), (t - 0.75) * 4.0);
            storeDst(px, vec4(col, 1.0));
            return;
        }
    }

    if (gC.z < 0.0) { storeDst(px, center); return; }
    if (pc.f.x <= 0.001) {
        storeDst(px, center);
        persistFinalSurfaceHistory(px, size, gC, center.rgb);
        return;
    }

    vec3 nC = rtOctDecode(gC.xy);
    vec3 nCv = mat3(ubo.view) * nC;
    vec3 pCv = rtViewPosFromLinear(vec2(px) + 0.5, gC.z, size);
    float depthTol = 0.005 * gC.z + 0.002;
    const int step = 1 << PASS;
    const float h[3] = float[3](0.375, 0.25, 0.0625);   // B3-spline taps for offsets 0, +-1, +-2

    vec4 momC = imageLoad(imgMomentsCur, px);
    float varC = (PASS == 0) ? max(0.0, momC.z) : max(0.0, momC.w);
    float lC = dot(center.rgb, vec3(0.2126, 0.7152, 0.0722));
    const bool useSvgf = (pc.f.w > 0.5);

    vec4 sum = center * (h[0] * h[0]);
    float varSum = varC * (h[0] * h[0]);
    float wTotal = h[0] * h[0];

    for (int j = -2; j <= 2; ++j) {
        for (int i = -2; i <= 2; ++i) {
            if (i == 0 && j == 0) continue;
            ivec2 q = px + ivec2(i, j) * step;
            if (any(lessThan(q, ivec2(0))) || any(greaterThanEqual(q, isize))) continue;
            vec4 gQ = imageLoad(imgGeomCur, q);
            if (gQ.z < 0.0) continue;
            vec3 pQv = rtViewPosFromLinear(vec2(q) + 0.5, gQ.z, size);
            float planeDist = abs(dot(nCv, pQv - pCv));
            float wd = exp(-planeDist / max(depthTol * sqrt(float(step)), 1e-4));
            float wn = pow(max(0.0, dot(nC, rtOctDecode(gQ.xy))), 16.0);

            vec4 qCol = loadSrc(q);
            float wl = 1.0;
            if (useSvgf) {
                float lQ = dot(qCol.rgb, vec3(0.2126, 0.7152, 0.0722));
                float deltaL = abs(lC - lQ);
                float stdDev = sqrt(max(varC, 1e-4));
                float stepScale = 1.0 / sqrt(float(step));
                float sigmaL = 1.2 * max(pc.f.x, 0.1) * stepScale;
                float lumaFloor = 0.03 * stepScale;
                wl = exp(-deltaL / (sigmaL * stdDev + lumaFloor));
            }

            // Contact shadow / AO preservation: prevents bright floor light from leaking into contact shadows
            float deltaVis = abs(center.a - qCol.a);
            float wVis = exp(-deltaVis / 0.18);

            float w = h[abs(i)] * h[abs(j)] * wd * wn * wl * wVis;
            sum += qCol * w;
            if (useSvgf) {
                float qVar = (PASS == 0) ? max(0.0, imageLoad(imgMomentsCur, q).z) : max(0.0, imageLoad(imgMomentsCur, q).w);
                varSum += w * qVar;
            }
            wTotal += w;
        }
    }
    vec4 filtered = sum / max(wTotal, 1e-6);

    if (useSvgf && PASS < 3) {
        float filteredVar = varSum / max(wTotal, 1e-6);
        momC.w = filteredVar;
        imageStore(imgMomentsCur, px, momC);
    }

    // Spatial strength directly controls filtering. SVGF edge-stopping functions
    // (depth, normal, and variance-guided luminance weight) naturally preserve true details.
    float s = clamp(pc.f.x, 0.0, 1.0);
    vec4 finalValue = mix(center, filtered, s);
    storeDst(px, finalValue);
    persistFinalSurfaceHistory(px, size, gC, finalValue.rgb);
}
