#version 460
#extension GL_EXT_ray_query : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_GOOGLE_include_directive : require

// Passes 3-4/4: edge-avoiding a-trous wavelet filter (5x5 B3-spline, 4-stage hierarchy step 1, 2, 4, 8),
// guided by view-space plane distance, normals, and SVGF local luminance variance.
//   PASS 0: imgHistCur -> imgA (step 1)
//   PASS 1: imgA       -> imgS (step 2)
//   PASS 2: imgS       -> imgA (step 4)
//   PASS 3: imgA       -> imgS (step 8, final output sampled by pbr_rt.frag)
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(constant_id = 0) const int PASS = 0;

#include "rt_common.glsl"
#include "rt_screen.glsl"
#include "gi_world_cache_common.glsl"
#include "gi_surface_history_common.glsl"

layout(set = 1, binding = 0) uniform sampler2D uDepth;
layout(set = 1, binding = 1, rgba16f) uniform image2D imgS;
layout(set = 1, binding = 2, rgba16f) uniform image2D imgA;
layout(set = 1, binding = 3, rgba32f) uniform image2D imgGeomCur;
layout(set = 1, binding = 5, rgba16f) uniform image2D imgHistCur;
layout(set = 1, binding = 13, rgba16f) uniform image2D imgMomentsCur; // in/out: mu1, mu2, variance, filtered_var
layout(set = 1, binding = 16, rgba16f) uniform image2D imgRawGi;
layout(set = 1, binding = 17, rgba16f) uniform image2D imgCaustics;

layout(push_constant) uniform PC {
    mat4 unused;
    vec4 f;   // x = spatial strength (0..1), y = maxHistory, w = svgfEnabled (1/0)
    uvec4 u;  // u.x = debugMode (evaluated in final pass)
} pc;

vec4 loadSrc(ivec2 p) {
    if (PASS == 0) return imageLoad(imgHistCur, p);
    if (PASS == 1 || PASS == 3) return imageLoad(imgA, p);
    return imageLoad(imgS, p); // PASS == 2
}

void storeDst(ivec2 p, vec4 v) {
    if (PASS == 0 || PASS == 2) imageStore(imgA, p, v);
    else imageStore(imgS, p, v); // PASS == 1 or PASS == 3
}

// Continuous GI confidence from the temporal luminance moments.
// .z carries the SVGF variance floor; subtract it before estimating uncertainty.
float giConfidence(float mu1, float variance, float historyLen) {
    float measured = max(variance - 0.005, 0.0);
    float relativeSigmaMean = sqrt(measured / max(historyLen, 1.0)) /
                              max(mu1, 0.15);
    return smoothstep(2.0, 12.0, historyLen) *
           (1.0 - smoothstep(0.10, 0.45, relativeSigmaMean));
}

vec3 debugLogGray(float value, float scale, float range) {
    float t = clamp(log2(1.0 + max(value, 0.0) * scale) / range, 0.0, 1.0);
    return vec3(t);
}

void persistFinalSurfaceHistory(ivec2 px, vec2 size, vec4 geom, vec3 filteredRadiance) {
    uvec2 writePhase = uvec2(pc.u.w & 1u, (pc.u.w >> 1u) & 1u);
    bool writeSample = all(equal((uvec2(px) & 1u), writePhase));
    float historyLen = unpackGiHistoryLen(geom.w);
    if (PASS != 3 || pc.u.y == 0u || pc.u.z == 0u || historyLen < 2.0 || !writeSample) return;
    vec2 uv = (vec2(px) + 0.5) / size;
    ivec2 depthSize = textureSize(uDepth, 0);
    ivec2 depthPx = clamp(ivec2(uv * vec2(depthSize)), ivec2(0), depthSize - 1);
    float depth = texelFetch(uDepth, depthPx, 0).r;
    vec3 worldPos = rtWorldPos(vec2(px) + 0.5, depth, size);
    vec3 worldNormal = rtOctDecode(geom.xy);
    storeSurfaceHistory(worldPos, worldNormal, filteredRadiance, historyLen, pc.u.z, pc.u.w, true);
}

void main() {
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    ivec2 isize = imageSize(imgS);
    if (any(greaterThanEqual(px, isize))) return;
    vec2 size = vec2(isize);

    vec4 center = loadSrc(px);
    vec4 gC = imageLoad(imgGeomCur, px);

    // Debug visualization modes (evaluated in final pass directly into imgS)
    if ((PASS == 3 || PASS == 1) && pc.u.x > 0u) {
        uint mode = pc.u.x;
        if (gC.z < 0.0) {
            // Sky
            storeDst(px, vec4(0.0, 0.0, 0.0, 1.0));
            return;
        }
        if (mode == 1u) {
            // True raw GI trace, captured before temporal accumulation or spatial filtering.
            vec4 rawS = imageLoad(imgRawGi, px);
            storeDst(px, rawS);
            return;
        } else if (mode == 8u) {
            vec4 caustic = imageLoad(imgCaustics, px);
            storeDst(px, vec4(caustic.rgb, 1.0));
            return;
        } else if (mode == 9u) {
            float density = clamp(imageLoad(imgCaustics, px).a, 0.0, 1.0);
            storeDst(px, vec4(density, density * density, 0.0, 1.0));
            return;
        } else if (mode >= 17u && mode <= 20u) {
            vec4 temporalMoments = imageLoad(imgMomentsCur, px);
            float historyLen = unpackGiHistoryLen(gC.w);
            float mu1 = max(temporalMoments.x, 0.0);
            float temporalVariance = max(temporalMoments.z, 0.0);
            float measuredVariance = max(temporalVariance - 0.005, 0.0);
            float relativeSigmaMean = sqrt(measuredVariance / max(historyLen, 1.0)) /
                                      max(mu1, 0.15);
            if (mode == 17u) {
                float confidence = giConfidence(mu1, temporalVariance, historyLen);
                storeDst(px, vec4(1.0 - confidence, confidence, 0.0, 1.0));
            } else if (mode == 18u) {
                storeDst(px, vec4(debugLogGray(mu1, 16.0, 8.0), 1.0));
            } else if (mode == 19u) {
                storeDst(px, vec4(debugLogGray(temporalVariance, 256.0, 8.0), 1.0));
            } else if (mode == 20u) {
                storeDst(px, vec4(debugLogGray(relativeSigmaMean, 1.0, 2.0), 1.0));
            }
            return;
        } else if (mode >= 10u && mode <= 16u) {
            storeDst(px, imageLoad(imgHistCur, px));
            return;
        } else if (mode == 2u) {
            // History length (false color gradient normalized to maxHistory)
            float maxH = max(pc.f.y, 1.0);
            float t = clamp(unpackGiHistoryLen(gC.w) / maxH, 0.0, 1.0);
            vec3 col;
            if (t <= 0.25)      col = mix(vec3(0.05, 0.05, 0.4), vec3(0.0, 0.8, 0.8), t * 4.0);
            else if (t <= 0.50) col = mix(vec3(0.0, 0.8, 0.8),   vec3(0.1, 0.9, 0.1), (t - 0.25) * 4.0);
            else if (t <= 0.75) col = mix(vec3(0.1, 0.9, 0.1),   vec3(1.0, 0.9, 0.0), (t - 0.50) * 4.0);
            else                col = mix(vec3(1.0, 0.9, 0.0),   vec3(1.0, 0.1, 0.1), (t - 0.75) * 4.0);
            storeDst(px, vec4(col, 1.0));
            return;
        } else if (mode == 3u) {
            // Geometric / reconstructed normal
            vec3 n = rtOctDecode(gC.xy);
            storeDst(px, vec4(n * 0.5 + 0.5, 1.0));
            return;
        } else if (mode == 4u) {
            // Linear depth (normalized visualization)
            float dVis = clamp(gC.z / 40.0, 0.0, 1.0);
            storeDst(px, vec4(vec3(dVis), 1.0));
            return;
        } else if (mode == 5u) {
            // AO only
            storeDst(px, vec4(vec3(center.a), 1.0));
            return;
        } else if (mode == 7u) {
            // Luminance variance from SVGF (log-scaled heat map)
            vec4 mom = imageLoad(imgMomentsCur, px);
            float v = max(mom.z, 0.0);
            float t = clamp(log2(1.0 + v * 16.0) / 4.0, 0.0, 1.0);
            vec3 col;
            if (t <= 0.25)      col = mix(vec3(0.0, 0.0, 0.5), vec3(0.0, 0.5, 1.0), t * 4.0);
            else if (t <= 0.50) col = mix(vec3(0.0, 0.5, 1.0), vec3(0.0, 0.9, 0.2), (t - 0.25) * 4.0);
            else if (t <= 0.75) col = mix(vec3(0.0, 0.9, 0.2), vec3(1.0, 0.8, 0.0), (t - 0.50) * 4.0);
            else                col = mix(vec3(1.0, 0.8, 0.0), vec3(1.0, 0.05, 0.05), (t - 0.75) * 4.0);
            storeDst(px, vec4(col, 1.0));
            return;
        }
    }

    if (gC.z < 0.0) { storeDst(px, center); return; }
    if (pc.f.x <= 0.001) {
        storeDst(px, center);
        persistFinalSurfaceHistory(px, size, gC, center.rgb);
        return;
    }

    vec3 nC = rtOctDecode(gC.xy);
    vec3 nCv = mat3(ubo.view) * nC;
    vec3 pCv = rtViewPosFromLinear(vec2(px) + 0.5, gC.z, size);
    float depthTol = 0.005 * gC.z + 0.002;
    const int step = 1 << PASS;
    const float h[3] = float[3](0.375, 0.25, 0.0625);   // B3-spline taps for offsets 0, +-1, +-2

    vec4 momC = imageLoad(imgMomentsCur, px);

    // 3x3 bilateral pre-filter of temporal variance and Hampel firefly suppression in Pass 0
    float varC = max(momC.z, 0.0);
    if (PASS == 0) {
        float varSum = 0.0;
        float wVarTotal = 0.0;
        vec3 colSum = vec3(0.0);
        float wColTotal = 0.0;
        vec3 neighborMax = vec3(0.0);
        int validNeighborCount = 0;

        for (int dy = -1; dy <= 1; ++dy) {
            for (int dx = -1; dx <= 1; ++dx) {
                if (dx == 0 && dy == 0) continue;
                ivec2 q = px + ivec2(dx, dy);
                if (any(lessThan(q, ivec2(0))) || any(greaterThanEqual(q, isize))) continue;
                vec4 gQ = imageLoad(imgGeomCur, q);
                if (gQ.z < 0.0) continue;

                float dn = dot(nC, rtOctDecode(gQ.xy));
                if (dn < 0.707) continue;
                float dz = abs(gC.z - gQ.z);
                if (dz > depthTol * 3.0) continue;

                float wTap = (abs(dx) + abs(dy) == 2) ? 0.0625 : 0.125;
                vec4 qMom = imageLoad(imgMomentsCur, q);
                varSum += max(qMom.z, 0.0) * wTap;
                wVarTotal += wTap;

                vec4 qSrc = loadSrc(q);
                colSum += qSrc.rgb * wTap;
                wColTotal += wTap;
                neighborMax = max(neighborMax, qSrc.rgb);
                validNeighborCount++;
            }
        }
        if (wVarTotal > 1e-4) {
            varC = (varC * 0.25 + varSum) / (0.25 + wVarTotal);
        }
        // Hampel outlier suppression: clamp isolated firefly sparks in input radiance
        if (validNeighborCount >= 3 && wColTotal > 1e-4) {
            vec3 neighborMean = colSum / wColTotal;
            float centerLum = dot(center.rgb, vec3(0.2126, 0.7152, 0.0722));
            float meanLum = dot(neighborMean, vec3(0.2126, 0.7152, 0.0722));
            float maxLum = dot(neighborMax, vec3(0.2126, 0.7152, 0.0722));
            if (centerLum > meanLum * 6.0 + 4.0 && centerLum > maxLum * 3.0 + 1.5) {
                vec3 safeClamp = max(neighborMax * 1.5, neighborMean * 2.5 + vec3(0.5));
                center.rgb = min(center.rgb, safeClamp);
            }
        }

        // Store smoothed variance into momC.w for downstream passes 1, 2, 3 to read immutably
        momC.w = varC;
        imageStore(imgMomentsCur, px, momC);
    } else {
        // Downstream passes read the pre-filtered variance from momC.w
        varC = max(momC.w, 0.0);
    }

    float lC = max(0.0, dot(center.rgb, vec3(0.2126, 0.7152, 0.0722)));
    const bool useSvgf = (pc.f.w > 0.5);
    float historyLen = unpackGiHistoryLen(gC.w);

    // Dynamic history boost: at low history (SPP1 / camera motion / fresh frame) widen bandwidth
    // to smooth stochastic hits and prevent energy loss. At mature history, bandwidth contracts
    // to maintain sharp shadow boundaries while dissolving low-frequency blotches across surfaces.
    float histBoost = mix(2.5, 1.0, clamp(historyLen / 8.0, 0.0, 1.0));

    // Decayed variance per pass (SVGF Schied et al. 2017 Eq. 6):
    // As passes progress (step = 1, 2, 4, 8), prior passes have smoothed noise variance by ~2x per pass.
    float passVarC = varC / exp2(float(PASS));
    float sigmaC = sqrt(max(passVarC, 0.0));

    vec3 sumRgb = center.rgb * (h[0] * h[0]);
    float sumAo = center.a * (h[0] * h[0]);
    float wRgbTotal = h[0] * h[0];
    float wAoTotal = h[0] * h[0];

    for (int j = -2; j <= 2; ++j) {
        for (int i = -2; i <= 2; ++i) {
            if (i == 0 && j == 0) continue;
            ivec2 offset = ivec2(i, j) * step;
            ivec2 q = px + offset;
            if (any(lessThan(q, ivec2(0))) || any(greaterThanEqual(q, isize))) continue;
            vec4 gQ = imageLoad(imgGeomCur, q);
            if (gQ.z < 0.0) continue;

            vec4 qCol = loadSrc(q);

            vec3 pQv = rtViewPosFromLinear(vec2(q) + 0.5, gQ.z, size);
            float planeDist = abs(dot(nCv, pQv - pCv));
            float wd = exp(-planeDist / max(depthTol * float(step), 1e-4));
            float dn = max(0.0, dot(nC, rtOctDecode(gQ.xy)));
            float wn = dn * dn * dn * dn; // pow(dn, 4.0): sharp 90-deg edges preserved, smooth curvature on spheres
            float wGeomBase = h[abs(i)] * h[abs(j)] * wd * wn;
            if (wGeomBase <= 1e-6) continue;

            vec3 safeQCol = qCol.rgb;
            float lQ = max(0.0, dot(safeQCol, vec3(0.2126, 0.7152, 0.0722)));
            float deltaL = abs(lC - lQ);

            // True Linear SVGF Luminance Edge-Stopping (Schied et al. 2017 Eq. 6):
            // w_l = exp(-|lC - lQ| / (k_sigma * sqrt(Var) + eps))
            // Using LINEAR luminance (NOT log-luminance):
            // - In dark areas: small noise |deltaL| < sigma is freely smoothed, eliminating blotchiness/coagulation.
            // - In bright areas: noise is filtered smoothly without dark holes eating into the light.
            // - Across true shadow boundaries: |deltaL| >> sigma, so edges remain razor-sharp.
            float wl = 1.0;
            if (useSvgf) {
                vec4 qMoments = imageLoad(imgMomentsCur, q);
                float qVar = (PASS == 0) ? max(qMoments.z, 0.0) : max(qMoments.w, 0.0);
                float passVarQ = qVar / exp2(float(PASS));
                float sigmaQ = sqrt(max(passVarQ, 0.0));
                float effectiveSigma = max(sigmaC, sigmaQ);

                float floorBandwidth = mix(0.08, 0.025, clamp(historyLen / 16.0, 0.0, 1.0));
                float bandwidth = max(3.5 * effectiveSigma * max(pc.f.x, 0.1) * histBoost, floorBandwidth);
                wl = exp(-deltaL / bandwidth);
            }

            float wRgb = wGeomBase * wl;
            sumRgb += safeQCol.rgb * wRgb;
            wRgbTotal += wRgb;

            // Contact shadow / AO preservation: deltaVis only constrains the AO channel
            float deltaVis = abs(center.a - qCol.a);
            float wVis = exp(-deltaVis / 0.25);
            float wAo = wGeomBase * wVis;
            sumAo += qCol.a * wAo;
            wAoTotal += wAo;
        }
    }

    vec4 filtered = vec4(sumRgb / max(wRgbTotal, 1e-6),
                         sumAo / max(wAoTotal, 1e-6));

    if (PASS < 3) {
        storeDst(px, filtered);
    } else {
        // Final pass: apply spatial strength cleanly
        float s = clamp(pc.f.x, 0.0, 1.0);
        vec4 finalValue = mix(center, filtered, s);
        storeDst(px, finalValue);
        persistFinalSurfaceHistory(px, size, gC, finalValue.rgb);
    }
}
