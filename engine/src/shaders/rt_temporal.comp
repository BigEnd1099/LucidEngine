#version 460
#extension GL_EXT_ray_query : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_GOOGLE_include_directive : require

// Pass 2/4: temporal accumulation with camera reprojection and geometric
// (depth plane + normal) history rejection. history length counts *effective
// samples*, so raising samples-per-pixel makes the image converge faster.
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

#include "rt_common.glsl"
#include "rt_screen.glsl"

layout(set = 1, binding = 0) uniform sampler2D uDepth;
layout(set = 1, binding = 1, rgba16f) uniform image2D imgS;        // in : raw trace output
layout(set = 1, binding = 3, rgba32f) uniform image2D imgGeomCur;  // in/out: history length written to .w
layout(set = 1, binding = 4, rgba32f) uniform image2D imgGeomPrev; // in
layout(set = 1, binding = 5, rgba16f) uniform image2D imgHistCur;  // out
layout(set = 1, binding = 6, rgba16f) uniform image2D imgHistPrev; // in

layout(push_constant) uniform PC {
    mat4 prevViewProj;
    vec4 f;   // x = max history (effective samples), y = samples per pixel, z = history valid (0/1)
    uvec4 u;
} pc;

void main() {
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    ivec2 isize = imageSize(imgS);
    if (any(greaterThanEqual(px, isize))) return;
    vec2 size = vec2(isize);

    vec4 geom = imageLoad(imgGeomCur, px);
    if (geom.z < 0.0) { // sky
        imageStore(imgHistCur, px, vec4(0.0, 0.0, 0.0, 1.0));
        return;
    }

    vec4 raw = imageLoad(imgS, px);
    vec3 N = rtOctDecode(geom.xy);
    float d = texelFetch(uDepth, px, 0).r;
    vec3 P = rtWorldPos(vec2(px) + 0.5, d, size);

    vec4  hist = vec4(0.0);
    float histLen = 0.0;
    float wSum = 0.0;

    vec4 pClip = pc.prevViewProj * vec4(P, 1.0);
    if (pc.f.z > 0.5 && pClip.w > 1e-4) {
        vec2 prevUV = (pClip.xy / pClip.w) * 0.5 + 0.5;
        vec2 prevPx = prevUV * size - 0.5;
        ivec2 base = ivec2(floor(prevPx));
        vec2 fr = prevPx - vec2(base);
        for (int i = 0; i < 4; ++i) {
            ivec2 o = ivec2(i & 1, i >> 1);
            ivec2 tp = base + o;
            if (any(lessThan(tp, ivec2(0))) || any(greaterThanEqual(tp, isize))) continue;
            vec4 g = imageLoad(imgGeomPrev, tp);
            if (g.z < 0.0) continue;
            // Disocclusion tests: depth of the same surface point in the previous frame + normal.
            if (abs(g.z - pClip.w) > 0.04 * pClip.w + 0.01) continue;
            if (dot(rtOctDecode(g.xy), N) < 0.8) continue;
            float w = ((o.x == 0) ? (1.0 - fr.x) : fr.x) * ((o.y == 0) ? (1.0 - fr.y) : fr.y);
            hist    += w * imageLoad(imgHistPrev, tp);
            histLen += w * g.w;
            wSum    += w;
        }
    }

    float maxHist = max(pc.f.x, 1.0);
    float spp = max(pc.f.y, 1.0);
    vec4 result;
    float newLen;
    if (wSum > 0.05) {
        hist /= wSum;
        histLen /= wSum;
        // Fireflies: once there is history, a sample far above it is almost surely noise.
        if (histLen >= 4.0) raw.rgb = min(raw.rgb, hist.rgb * 3.0 + vec3(2.0));
        newLen = min(histLen + spp, maxHist);
        float alpha = clamp(spp / newLen, 0.0, 1.0);
        result = mix(hist, raw, alpha);
    } else {
        newLen = min(spp, maxHist);
        result = raw;
    }

    imageStore(imgHistCur, px, result);
    geom.w = newLen;
    imageStore(imgGeomCur, px, geom);
}
