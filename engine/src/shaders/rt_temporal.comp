#version 460
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_shader_subgroup_arithmetic : enable
#extension GL_KHR_shader_subgroup_ballot : enable

#extension GL_EXT_ray_query : require

#extension GL_EXT_buffer_reference2 : require

#extension GL_EXT_scalar_block_layout : require

#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

#extension GL_EXT_nonuniform_qualifier : require

#extension GL_GOOGLE_include_directive : require



// Pass 2/4: temporal accumulation with camera reprojection, motion vectors,
// geometric history rejection, 3x3 neighborhood clamping, EMA, and SVGF moments.
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

#include "rt_common.glsl"
#include "rt_screen.glsl"
#include "gi_world_cache_common.glsl"
#include "gi_surface_history_common.glsl"

vec3 rgbToYCoCg(vec3 c) {
    return vec3(
         0.25 * c.r + 0.5 * c.g + 0.25 * c.b,
         0.5  * c.r             - 0.5  * c.b,
        -0.25 * c.r + 0.5 * c.g - 0.25 * c.b
    );
}

vec3 yCoCgToRgb(vec3 c) {
    float y  = c.x;
    float co = c.y;
    float cg = c.z;
    return vec3(
        y + co - cg,
        y + cg,
        y - co - cg
    );
}



layout(set = 1, binding = 0) uniform sampler2D uDepth;

layout(set = 1, binding = 1, rgba16f) uniform image2D imgS;        // in : raw trace output

layout(set = 1, binding = 3, rgba32f) uniform image2D imgGeomCur;  // in/out: history length written to .w

layout(set = 1, binding = 4, rgba32f) uniform image2D imgGeomPrev; // in

layout(set = 1, binding = 5, rgba16f) uniform image2D imgHistCur;  // out

layout(set = 1, binding = 6, rgba16f) uniform image2D imgHistPrev; // in

layout(set = 1, binding = 12) uniform sampler2D uMotion;           // in: screen-space motion vectors

layout(set = 1, binding = 13, rgba16f) uniform image2D imgMomentsCur;  // out: mu1, mu2, variance, filtered_var

layout(set = 1, binding = 14, rgba16f) uniform image2D imgMomentsPrev; // in: reprojected moments
layout(set = 1, binding = 22, rgba16f) uniform image2D imgGiDirectionBins0;
layout(set = 1, binding = 23, rgba16f) uniform image2D imgGiDirectionBins1;
layout(set = 1, binding = 24, rgba16f) uniform image2D imgGiDirectionBins2;
layout(set = 1, binding = 25, rgba16f) uniform image2D imgGiDirectionCount;
layout(set = 1, binding = 26, rgba16f) uniform image2D imgGiDirectionBinsPrev0;
layout(set = 1, binding = 27, rgba16f) uniform image2D imgGiDirectionBinsPrev1;
layout(set = 1, binding = 28, rgba16f) uniform image2D imgGiDirectionBinsPrev2;
layout(set = 1, binding = 29, rgba16f) uniform image2D imgGiDirectionCountPrev;
layout(set = 1, binding = 30, rgba32f) uniform image2D imgGiPathPosition;
layout(set = 1, binding = 31, rgba16f) uniform image2D imgGiPathNormal;
layout(set = 1, binding = 32, rgba32f) uniform image2D imgGiPathPositionPrev;
layout(set = 1, binding = 33, rgba16f) uniform image2D imgGiPathNormalPrev;

layout(set = 1, binding = 15, std430) buffer RtDiagnostics { uint counters[60]; } rtDiag;
layout(set = 1, binding = 20, std430) readonly buffer WorldRadianceCacheBuf { WorldRadianceCell cells[]; } worldRadianceCache;

layout(push_constant) uniform PC {
    mat4 prevViewProj;
    vec4 f;   // x = max history, y = wrcBaseCellSize, z = history valid, w = GI spatial reuse strength
    uvec4 u;  // x: bit 0=bypass, bit 1=surfaceCache, bit 2=worldCache, bits 8..13=WRC flags; y: clamp/debug; z: epoch; w: frameIndex
} pc;

bool trySampleWorldRadianceCache(uint cellKey, ivec3 cellCoord, vec3 worldPos, vec3 n, float cellSize,
                                 uint currentFrame, bool planeWeightEnabled, out vec4 result,
                                 out float sampleWeight) {
    uint baseIndex = cellKey % CACHE_CELL_COUNT;
    for (uint probe = 0u; probe < 4u; ++probe) {
        uint idx = (baseIndex + probe) % CACHE_CELL_COUNT;
        WorldRadianceCell cell = worldRadianceCache.cells[idx];
        // WRC writers claim the first empty slot in this same bounded probe
        // sequence. An empty slot therefore terminates the search; probing
        // subsequent slots only adds random SSBO reads on cache misses.
        if (cell.irradiance.a <= 0.0)
            return false;
        if (cell.cellKey != cellKey || currentFrame < cell.lastSeenFrame)
            continue;
        vec3 cellNormal = unpackNormalOctahedral(cell.packedNormal);
        float geomWeight = computeWorldCacheNormalWeight(cellNormal, n);
        if (geomWeight <= 0.0)
            continue;
        if (planeWeightEnabled) {
            vec3 cellCenter = computeWorldCellCenter(cellCoord, n, cellSize);
            float excessDist = computeWorldCellPlaneDistanceExcess(cellCenter, worldPos, n, cellSize);
            if (excessDist > 0.95 * cellSize)
                continue;
            geomWeight *= computePlaneDistanceWeight(excessDist, cellSize);
        }
        sampleWeight = cell.irradiance.a;
        result = vec4(cell.irradiance.rgb, smoothstep(0.0, 32.0, sampleWeight) * geomWeight);
        return true;
    }
    return false;
}

bool trySampleWorldRadianceCacheCascade(vec3 worldPos, vec3 n, vec2 pixel, uint currentFrame,
                                        uint cascade, float baseCellSize, bool clipmapEnabled,
                                        bool jitterEnabled, bool planeWeightEnabled,
                                        out vec4 result, out float sampleWeight) {
    float cellSize = getCascadeCellSizeCfg(cascade, baseCellSize, clipmapEnabled);
    vec3 T, B;
    buildBasis(n, T, B);
    if (jitterEnabled) {
        vec2 xi = vec2(ignTemporal(pixel, currentFrame), ignTemporal(pixel.yx, currentFrame)) - 0.5;
        vec3 jitteredPos = worldPos + (T * xi.x + B * xi.y) * cellSize;
        vec3 biasedJitter = jitteredPos + n * (cellSize * 0.25);
        ivec3 jitterCoord = ivec3(floor(biasedJitter / cellSize));
        uint keyJitter = computeWorldCellKeyFromCoord(jitterCoord, n, cascade);
        if (trySampleWorldRadianceCache(keyJitter, jitterCoord, worldPos, n, cellSize,
                                        currentFrame, planeWeightEnabled, result, sampleWeight))
            return true;
    }
    vec3 biasedBase = worldPos + n * (cellSize * 0.25);
    ivec3 baseCoord = ivec3(floor(biasedBase / cellSize));
    uint keyBase = computeWorldCellKeyFromCoord(baseCoord, n, cascade);
    return trySampleWorldRadianceCache(keyBase, baseCoord, worldPos, n, cellSize,
                                       currentFrame, planeWeightEnabled, result, sampleWeight);
}

vec4 sampleWorldRadianceCacheTangentJitter(vec3 worldPos, vec3 worldNormal, ivec2 px, uint currentFrame,
                                           vec3 cameraPos, out float rawSampleWeight) {
    rawSampleWeight = 0.0;
    bool clipmapEnabled = (pc.u.x & (1u << 8)) != 0u;
    bool jitterEnabled = (pc.u.x & (1u << 9)) != 0u;
    bool planeWeightEnabled = (pc.u.x & (1u << 12)) != 0u;
    float baseCellSize = (pc.f.y > 0.05) ? pc.f.y : DEFAULT_CELL_SIZE;
    vec2 pixel = vec2(px);
    float dither = jitterEnabled ? ((ignTemporal(pixel, currentFrame) - 0.5) * 0.50) : 0.0;
    uint primaryCascade = getCascadeIndexCfg(worldPos, cameraPos, dither, clipmapEnabled);
    uint candidates[3];
    int candidateCount = 1;
    candidates[0] = primaryCascade;
    if (clipmapEnabled && primaryCascade > 0u)
        candidates[candidateCount++] = primaryCascade - 1u;
    if (clipmapEnabled && primaryCascade < 3u)
        candidates[candidateCount++] = primaryCascade + 1u;

    vec3 n = normalize(worldNormal);
    vec4 bestResult = vec4(0.0);
    float bestWeight = -1.0;
    for (int i = 0; i < candidateCount; ++i) {
        vec4 candidateResult = vec4(0.0);
        float candidateWeight = 0.0;
        if (!trySampleWorldRadianceCacheCascade(worldPos, n, pixel, currentFrame,
                                                candidates[i], baseCellSize, clipmapEnabled,
                                                jitterEnabled, planeWeightEnabled,
                                                candidateResult, candidateWeight))
            continue;
        float cascadePenalty = (i == 0) ? 1.0 : 0.25;
        float candidateScore = candidateWeight * cascadePenalty;
        if (candidateScore > bestWeight) {
            bestResult = candidateResult;
            bestWeight = candidateScore;
            rawSampleWeight = candidateWeight;
        }
        if (i == 0 && candidateWeight >= 8.0) {
            rawSampleWeight = candidateWeight;
            return candidateResult;
        }
    }
    return bestWeight >= 0.0 ? bestResult : vec4(0.0);
}

// Overload taking 4 arguments defaulting cameraPos to ubo.cameraPos.xyz
vec4 sampleWorldRadianceCacheTangentJitter(vec3 worldPos, vec3 worldNormal, ivec2 px, uint currentFrame) {
    float unusedSampleWeight = 0.0;
    return sampleWorldRadianceCacheTangentJitter(worldPos, worldNormal, px, currentFrame,
                                                  ubo.cameraPos.xyz, unusedSampleWeight);
}

// Fallback compatibility wrapper
vec4 sampleWorldRadianceCache(vec3 worldPos, vec3 worldNormal, uint currentFrame) {
    float unusedSampleWeight = 0.0;
    return sampleWorldRadianceCacheTangentJitter(worldPos, worldNormal, ivec2(0), currentFrame,
                                                  ubo.cameraPos.xyz, unusedSampleWeight);
}





void addDiagCounter(uint counterIdx, uint value) {
    uint sgSum = subgroupAdd(value);
    if (subgroupElect() && sgSum != 0u) {
        atomicAdd(rtDiag.counters[counterIdx], sgSum);
    }
}

void processPixel(ivec2 px, out uint ageBin, out bool histogramCounted,
                  out uint pixelDiag[8], out uint pixelCacheDiag[4]) {
    for (int i = 0; i < 8; ++i) pixelDiag[i] = 0u;
    for (int i = 0; i < 4; ++i) pixelCacheDiag[i] = 0u;
    histogramCounted = false;
    ageBin = 0u;


    ivec2 isize = imageSize(imgS);

    if (any(greaterThanEqual(px, isize))) return;

    vec2 size = vec2(isize);



    pixelDiag[0]++;
    vec4 geom = imageLoad(imgGeomCur, px);

    if (geom.z < 0.0) { // sky
        pixelDiag[2]++;

        imageStore(imgHistCur, px, vec4(0.0, 0.0, 0.0, 1.0));

        imageStore(imgMomentsCur, px, vec4(0.0));
        imageStore(imgGiDirectionBins0,px,vec4(0));
        imageStore(imgGiDirectionBins1,px,vec4(0));
        imageStore(imgGiDirectionBins2,px,vec4(0));
        imageStore(imgGiDirectionCount,px,vec4(0));
        imageStore(imgGiPathPosition,px,vec4(0));
        imageStore(imgGiPathNormal,px,vec4(0));
        ageBin = 0u;
        histogramCounted = true; // zero-age / sky

        return;

    }



    vec4 raw = imageLoad(imgS, px);
    float curHitDistFactor = unpackGiHitDistFactor(geom.w);

    vec3 N = rtOctDecode(geom.xy);

    vec2 curUV = (vec2(px) + 0.5) / size;
    ivec2 fullDepthSize = textureSize(uDepth, 0).xy;
    ivec2 fullPx = min(ivec2(curUV * vec2(fullDepthSize)), fullDepthSize - 1);
    float d = texelFetch(uDepth, fullPx, 0).r;
    float zC = rtLinearDepth(d);

    // Reconstruct the GI pixel at its own texel centre. The selected full-res
    // depth sample is nearest-neighbour, but its integer texel centre must not
    // replace the GI pixel's continuous screen-space centre during reprojection.
    vec3 P = rtWorldPos(vec2(px) + 0.5, d, size);

    // Evaluate cache diagnostics before temporal work, but do not return here:
    // cache writes must still run while a cache-hit debug view is selected.
    bool cacheDebugMode = (pc.u.y & 12u) != 0u;
    bool cacheDebugEnabled = false;
    bool cacheDebugHit = false;
    vec4 cacheDebugValue = vec4(0.0);
    float cacheDebugConfidence = 0.0;
    if (cacheDebugMode) {
        if ((pc.u.y & 4u) != 0u) {
            cacheDebugEnabled = (pc.u.x & 4u) != 0u;
            if (cacheDebugEnabled) {
                // Diagnostic-only reads are intentionally excluded from runtime hit-rate counters.
                float debugSampleWeight = 0.0;
                cacheDebugValue = sampleWorldRadianceCacheTangentJitter(P, N, px, pc.u.w,
                                                                          ubo.cameraPos.xyz, debugSampleWeight);
                cacheDebugConfidence = cacheDebugValue.a;
                cacheDebugValue.a = debugSampleWeight;
                cacheDebugHit = debugSampleWeight > 0.0;
            }
        } else if ((pc.u.y & 8u) != 0u) {
            cacheDebugEnabled = (pc.u.x & 2u) != 0u;
            if (cacheDebugEnabled) {
                float debugCoverage = 0.0;
                // Diagnostic-only reads are intentionally excluded from runtime hit-rate counters.
                cacheDebugHit = loadSurfaceHistory(P, N, pc.u.z, pc.u.w, cacheDebugValue, debugCoverage);
            }
        }
    }

    if ((pc.u.x & 1u) != 0u && !cacheDebugMode) { // bypass normal temporal work only outside cache diagnostics.
        float rawLum = dot(raw.rgb, vec3(0.2126, 0.7152, 0.0722));
        imageStore(imgHistCur, px, raw);
        imageStore(imgMomentsCur, px, vec4(rawLum, rawLum * rawLum, 0.0, 0.0));
        geom.w = packGiGeomW(1.0, curHitDistFactor);
        imageStore(imgGeomCur, px, geom);
        ageBin = 0u;
        histogramCounted = true;
        return;
    }
    vec3 toCam = ubo.cameraPos.xyz - P;
    vec3 toCamNorm = (dot(toCam, toCam) > 1e-6) ? normalize(toCam) : vec3(0.0, 1.0, 0.0);
    float nDotV = clamp(abs(dot(N, toCamNorm)), 0.15, 1.0);

    vec4  hist = vec4(0.0);
    vec4  histMoments = vec4(0.0);
    float histLen = 0.0;
    float histHitDist = 0.0;
    vec4 histDirectionBins0=vec4(0),histDirectionBins1=vec4(0),histDirectionBins2=vec4(0),histDirectionCount=vec4(0);
    vec4 histPathPositionBest=vec4(0),histPathNormalBest=vec4(0);
    float histPathBestScore=0.0,histPathEnergy=0.0;
    float wSum = 0.0;

    ivec2 fullMotionSize = textureSize(uMotion, 0).xy;
    ivec2 fullMotionPx = min(ivec2(curUV * vec2(fullMotionSize)), fullMotionSize - 1);
    vec2 motion = texelFetch(uMotion, fullMotionPx, 0).xy;

    vec4 pClip = pc.prevViewProj * vec4(P, 1.0);
    vec2 cameraPrevUV = (pClip.w > 0.0001) ? ((pClip.xy / pClip.w) * 0.5 + 0.5) : curUV;
    vec2 effectivePrevUV = (dot(motion, motion) >= 0.000000001) ? (curUV - motion) : cameraPrevUV;
    float motionPixels = length((curUV - effectivePrevUV) * size);
    bool isHistValid = (pc.u.y & 256u) != 0u;
    if (isHistValid) {
        vec2 prevUV = effectivePrevUV;

        vec2 prevPx = prevUV * size - 0.5;
        ivec2 base = ivec2(floor(prevPx));
        vec2 fr = prevPx - vec2(base);

        // Slope-aware depth tolerance: grazing angles expand tolerance to prevent false history rejection
        float depthTol = (0.04 * pClip.w + 0.01) / nDotV;

        for (int i = 0; i < 4; ++i) {
            ivec2 o = ivec2(i & 1, i >> 1);
            ivec2 tp = base + o;
            if (any(lessThan(tp, ivec2(0))) || any(greaterThanEqual(tp, isize))) { pixelDiag[3]++; continue; }

            vec4 g = imageLoad(imgGeomPrev, tp);
            if (g.z < 0.0) continue;

            // Disocclusion tests: slope-adjusted depth + surface normal
            if (abs(g.z - pClip.w) > depthTol) { pixelDiag[4]++; continue; }
            if (dot(rtOctDecode(g.xy), N) < 0.8) { pixelDiag[5]++; continue; }

            float w = ((o.x == 0) ? (1.0 - fr.x) : fr.x) * ((o.y == 0) ? (1.0 - fr.y) : fr.y);
            hist        += w * imageLoad(imgHistPrev, tp);
            histMoments += w * imageLoad(imgMomentsPrev, tp);
            histLen     += w * unpackGiHistoryLen(g.w);
            histHitDist += w * unpackGiHitDistFactor(g.w);
            histDirectionBins0+=w*imageLoad(imgGiDirectionBinsPrev0,tp);
            histDirectionBins1+=w*imageLoad(imgGiDirectionBinsPrev1,tp);
            histDirectionBins2+=w*imageLoad(imgGiDirectionBinsPrev2,tp);
            histDirectionCount+=w*imageLoad(imgGiDirectionCountPrev,tp);
            vec4 prevPathPosition=imageLoad(imgGiPathPositionPrev,tp);
            vec4 prevPathNormal=imageLoad(imgGiPathNormalPrev,tp);
            histPathEnergy+=w*max(prevPathPosition.w,0.0);
            float pathCandidateScore=w*max(prevPathPosition.w,0.0);
            if(pathCandidateScore>histPathBestScore){histPathBestScore=pathCandidateScore;histPathPositionBest=prevPathPosition;histPathNormalBest=prevPathNormal;}
            wSum        += w;
        }


    }

    if(wSum>0.05){histPathEnergy/=wSum;}

    float maxHist = max(pc.f.x, 1.0);
    // Screen-space motion includes camera movement. It is not evidence that
    // diffuse surface irradiance changed, so never shorten GI history from it.
    float effectiveMaxHist = maxHist;
    vec4 result;
    float newLen;
    float finalHitDistFactor = curHitDistFactor;
    bool isCheckerSkipped = (raw.a < -0.5);
    // Pre-temporal spatial jitter is disabled to prevent frame-to-frame checkerboard variance fighting.
    // Pure temporal accumulation integrates raw rays smoothly without injecting spatial noise.

    vec4 outMoments = vec4(0.0);
    vec2 curSampleMoments = vec2(0.0);

    if (isCheckerSkipped) {
        if (wSum > 0.05) {
            pixelDiag[6]++;
            // Full temporal reuse from the alternating frame when this pixel was traced
            hist /= wSum;
            histMoments /= wSum;
            histLen /= wSum;
            histHitDist /= wSum;
            finalHitDistFactor = histHitDist;
            result = hist;
            // Checkerboard-skipped pixels have no fresh radiance observation this
            // frame. Do not clamp mature reprojected HDR history against four sparse
            // 1-SPP neighbors: they may simply have missed the bright indirect path.
            // For young history only, apply a small luminance-only safety bound and
            // scale RGB uniformly so chroma and HDR energy ratio remain intact.
            if (motionPixels > 1.5 && histLen < 4.0) {
                float checkerMaxLum = 0.0;
                float checkerCount = 0.0;
                const ivec2 checkerOffsets[4] = ivec2[](ivec2(-1, 0), ivec2(1, 0), ivec2(0, -1), ivec2(0, 1));
                for (int ci = 0; ci < 4; ++ci) {
                    ivec2 cp = px + checkerOffsets[ci];
                    if (any(lessThan(cp, ivec2(0))) || any(greaterThanEqual(cp, isize))) continue;
                    vec4 cv = imageLoad(imgS, cp);
                    if (cv.a < 0.0) continue;
                    checkerMaxLum = max(checkerMaxLum, rgbToYCoCg(cv.rgb).x);
                    checkerCount += 1.0;
                }
                float histLum = rgbToYCoCg(result.rgb).x;
                if (checkerCount >= 2.0 && checkerMaxLum > 0.05 &&
                    histLum > checkerMaxLum * 4.0) {
                    float targetLum = max(checkerMaxLum * 4.0, histLum * 0.85);
                    result.rgb *= targetLum / max(histLum, 1e-4);
                }
            }
            newLen = min(histLen, effectiveMaxHist); // Checkerboard reuse adds no new temporal observation.
            outMoments = histMoments;
        } else {
            pixelDiag[7]++;
            // Disocclusion / invalid history: bilateral reconstruction from the 4 active neighbors in current frame
            vec4 neighborSum = vec4(0.0);
            float weightSum = 0.0;
            const ivec2 offsets[4] = ivec2[](ivec2(1, 0), ivec2(-1, 0), ivec2(0, 1), ivec2(0, -1));
            for (int i = 0; i < 4; ++i) {
                ivec2 np = px + offsets[i];
                if (any(lessThan(np, ivec2(0))) || any(greaterThanEqual(np, isize))) continue;
                vec4 nVal = imageLoad(imgS, np);
                if (nVal.a < 0.0) continue;

                vec4 nG = imageLoad(imgGeomCur, np);
                if (nG.z < 0.0) continue;
                // Comparing neighbor depth to current pixel linear depth zC in current frame
                float depthDiff = abs(nG.z - zC);
                if (depthDiff > 0.05 * zC + 0.02) continue;
                vec3 nNormal = rtOctDecode(nG.xy);
                float normalDot = max(dot(nNormal, N), 0.0);
                if (normalDot < 0.75) continue;

                float w = normalDot / (1.0 + depthDiff * 50.0);
                neighborSum += nVal * w;
                weightSum += w;
            }
            if (weightSum > 1e-4) {
                result = neighborSum / weightSum;
            } else {
                result = vec4(0.0, 0.0, 0.0, 1.0);
            }
            newLen = 1.0;
            float rLum = dot(result.rgb, vec3(0.2126, 0.7152, 0.0722));
            outMoments = vec4(rLum, rLum * rLum, 0.1, 0.1);
        }
    } else {
        if (wSum > 0.05) {
            pixelDiag[1]++;
            hist /= wSum;
            histMoments /= wSum;
            histLen /= wSum;
            histHitDist /= wSum;
        } else {
            pixelDiag[2]++;
            hist = raw;
            histMoments = vec4(0.0);
            histLen = 0.0;
            histHitDist = curHitDistFactor;
        }
        float prevHitDistFactor = histHitDist;

        // 3x3 Neighborhood Hampel Outlier & Variance Clamping in YCoCg space
        vec3 rawYCoCg = rgbToYCoCg(raw.rgb);
        vec3 neighborY[8];
        float neighborLuma[8];
        int nNeighbors = 0;
        float aoMin = raw.a;
        float aoMax = raw.a;
        float minLum = rawYCoCg.x;
        float maxLum = rawYCoCg.x;

        for (int dy = -1; dy <= 1; ++dy) {
            for (int dx = -1; dx <= 1; ++dx) {
                if (dx == 0 && dy == 0) continue; // Exclude center pixel to prevent outlier self-contamination
                ivec2 sp = px + ivec2(dx, dy);
                if (any(lessThan(sp, ivec2(0))) || any(greaterThanEqual(sp, isize))) continue;
                vec4 sVal = imageLoad(imgS, sp);
                if (sVal.a < 0.0) continue; // Skip checkerboard-skipped neighbors
                vec3 sY = rgbToYCoCg(sVal.rgb);
                neighborY[nNeighbors] = sY;
                neighborLuma[nNeighbors] = sY.x;
                aoMin = min(aoMin, sVal.a);
                aoMax = max(aoMax, sVal.a);
                minLum = min(minLum, sY.x);
                maxLum = max(maxLum, sY.x);
                nNeighbors++;
            }
        }

        // Robust neighborhood luminance statistics. The maximum is deliberately
        // not used as the firefly reference: several isolated bright samples must
        // not raise one another's rejection threshold.
        float sortedLuma[8];
        for (int i = 0; i < nNeighbors; ++i) sortedLuma[i] = neighborLuma[i];
        for (int i = 1; i < nNeighbors; ++i) {
            float key = sortedLuma[i];
            int j = i - 1;
            while (j >= 0 && sortedLuma[j] > key) {
                sortedLuma[j + 1] = sortedLuma[j];
                --j;
            }
            sortedLuma[j + 1] = key;
        }
        float medianLum = rawYCoCg.x;
        if (nNeighbors > 0) {
            int mid = nNeighbors / 2;
            medianLum = (nNeighbors & 1) != 0 ? sortedLuma[mid]
                                               : 0.5 * (sortedLuma[mid - 1] + sortedLuma[mid]);
        }
        float absDeviation[8];
        for (int i = 0; i < nNeighbors; ++i) absDeviation[i] = abs(neighborLuma[i] - medianLum);
        for (int i = 1; i < nNeighbors; ++i) {
            float key = absDeviation[i];
            int j = i - 1;
            while (j >= 0 && absDeviation[j] > key) {
                absDeviation[j + 1] = absDeviation[j];
                --j;
            }
            absDeviation[j + 1] = key;
        }
        float medianAbsDeviation = 0.0;
        if (nNeighbors > 0) {
            int mid = nNeighbors / 2;
            medianAbsDeviation = (nNeighbors & 1) != 0 ? absDeviation[mid]
                                                        : 0.5 * (absDeviation[mid - 1] + absDeviation[mid]);
        }
        float robustSigma = 1.4826 * medianAbsDeviation;

        // A bright sample is spatially supported only when multiple independent
        // neighbors carry a comparable level of radiance. This protects real
        // bright clusters without allowing one or two isolated fireflies to
        // inflate the robust threshold.
        float supportFloor = max(medianLum + max(2.0 * robustSigma,
                                                medianLum * 0.75 + 0.008),
                                 rawYCoCg.x * 0.55);
        int brightSupportCount = 0;
        for (int i = 0; i < nNeighbors; ++i) {
            if (neighborLuma[i] >= supportFloor) brightSupportCount++;
        }
        bool spatiallySupportedBright = brightSupportCount >= 2;

        float spatialVar = 0.1;
        vec3 m1Y = rawYCoCg;
        vec3 m2Y = rawYCoCg * rawYCoCg;
        vec3 effectiveSigma = vec3(0.08, 0.04, 0.04);
        float maxClusterLum = rawYCoCg.x;
        bool inDarkZone = false;
        bool inBrightZone = false;
        float splitLum = rawYCoCg.x;
        float tBlend = 0.5;
        bool isBimodal = false;
        bool useDominanceRatio = (pc.u.y & 128u) != 0u;

        if (nNeighbors >= 2) {
            // =========================================================================
            // STAGE 1: 3-Tier Dynamic Brightness Classification (Ciemne / Średnie / Jasne)
            // =========================================================================
            float darkRatio = clamp(pc.f.z, 0.0, 1.0);
            float brightRatio = clamp(pc.f.w, 0.0, 1.0);
            float midtoneSmooth = float((pc.u.y >> 16u) & 0xFFu) / 255.0;

            isBimodal = useDominanceRatio && (maxLum > minLum * 1.5 + 0.10);
            splitLum = sqrt(max(minLum, 1e-4) * max(maxLum, 1e-4));

            int numBright = (rawYCoCg.x >= splitLum) ? 1 : 0;
            int numDark = (rawYCoCg.x < splitLum) ? 1 : 0;
            for (int i = 0; i < nNeighbors; ++i) {
                if (neighborY[i].x >= splitLum) numBright++;
                else numDark++;
            }
            int totalCount = numBright + numDark;
            float brightFraction = float(numBright) / max(float(totalCount), 1.0);

            // Continuous tier blend factor t in [0, 1]:
            // 0 = purely dark zone (dominance of dark samples)
            // 1 = purely bright zone (dominance of bright samples)
            // (0..1) = midtones / penumbra transition zone
            float brightThreshold = max(darkRatio + 0.05, 1.0 - brightRatio * 0.75);
            float tRaw = clamp((brightFraction - darkRatio) / max(brightThreshold - darkRatio, 0.05), 0.0, 1.0);
            tBlend = mix(tRaw, smoothstep(0.0, 1.0, tRaw), midtoneSmooth);

            inDarkZone = (tBlend < 0.05) && (brightFraction <= darkRatio);
            inBrightZone = (tBlend > 0.95);

            m1Y = vec3(0.0);
            m2Y = vec3(0.0);
            float statsCount = 0.0;
            float maxDarkClusterLum = 0.0;
            float maxBrightClusterLum = 0.0;

            for (int i = 0; i < nNeighbors; ++i) {
                bool isSampleBright = (neighborY[i].x >= splitLum);
                float w = 1.0;
                if (useDominanceRatio && isBimodal) {
                    if (isSampleBright) {
                        // In dark zone (tBlend -> 0), bright outliers are downweighted.
                        // In bright zone (tBlend -> 1), bright samples have full weight 1.0.
                        w = mix(max(0.02, darkRatio), 1.0, tBlend);
                        maxBrightClusterLum = max(maxBrightClusterLum, neighborY[i].x);
                    } else {
                        // In bright zone (tBlend -> 1), dark misses are downweighted by brightRatio.
                        // In dark zone (tBlend -> 0), dark samples have full weight 1.0.
                        w = mix(1.0, max(0.02, 1.0 - brightRatio), tBlend);
                        maxDarkClusterLum = max(maxDarkClusterLum, neighborY[i].x);
                    }
                } else {
                    maxBrightClusterLum = max(maxBrightClusterLum, neighborY[i].x);
                    maxDarkClusterLum = max(maxDarkClusterLum, neighborY[i].x);
                }
                m1Y += neighborY[i] * w;
                m2Y += neighborY[i] * neighborY[i] * w;
                statsCount += w;
            }

            if (statsCount > 1e-4) {
                m1Y /= statsCount;
                m2Y /= statsCount;
            } else {
                m1Y = rawYCoCg;
                m2Y = rawYCoCg * rawYCoCg;
            }

            if (isBimodal) {
                maxClusterLum = mix((maxDarkClusterLum > 0.0 ? maxDarkClusterLum : m1Y.x),
                                    max(maxBrightClusterLum, m1Y.x), tBlend);
            } else {
                maxClusterLum = max(maxBrightClusterLum, rawYCoCg.x);
            }

            vec3 sigmaY = sqrt(max(vec3(0.0), m2Y - m1Y * m1Y));
            spatialVar = max(0.0, m2Y.x - m1Y.x * m1Y.x);
            effectiveSigma = max(sigmaY, vec3(0.08, 0.04, 0.04));
        }

        // Temporal Frequency & Consistency:
        // A firefly is a non-recurring 1-frame Monte Carlo spike.
        // Legitimate lighting recurs consistently across frames.
        vec3 histY = rgbToYCoCg(hist.rgb);
        // History only supports a bright current sample when its own radiance
        // is in the same brightness range. A dark history must not bless a
        // one-frame bright spike merely because the pixel has accumulated age.
        bool historySupportsCurrent = (wSum > 0.25) && (histLen >= 2.0) &&
                                      (histY.x >= rawYCoCg.x * 0.35);
        bool temporallyFrequent = historySupportsCurrent;

        vec4 cachedSurf = vec4(0.0);
        float cachedCov = 0.0;
        bool cachedSurfaceValid = false;
        bool needsCacheEvidence = inDarkZone && (rawYCoCg.x >= splitLum) && !temporallyFrequent;
        if ((pc.u.x & 2u) != 0u && needsCacheEvidence) {
            pixelCacheDiag[3]++;
            cachedSurfaceValid = loadSurfaceHistory(P, N, pc.u.z, pc.u.w, cachedSurf, cachedCov) && cachedCov > 0.25;
            if (cachedSurfaceValid) pixelCacheDiag[1]++;
        }
        bool cacheSupportsBright = cachedSurfaceValid &&
            rgbToYCoCg(cachedSurf.rgb).x > max(m1Y.x + effectiveSigma.x, 0.5);

        bool realRawFirefly = false;
        // Firefly detection uses a local *relative* noise scale rather than the
        // broad history-clamp sigma floor. The latter is intentionally generous
        // for reprojection stability, but makes low-radiance outliers invisible.
        float darkFloor = max(medianLum, 0.005);
        float historyBaseline = historySupportsCurrent ? histY.x : 0.0;
        float baseline = max(historyBaseline, medianLum);
        float localFireflyScale = max(medianLum, 0.015);
        // Tighten the dark-surface floor while keeping the threshold proportional
        // to the local robust spread. The old fixed offsets were large enough to
        // leave visible low-energy fireflies on otherwise uniform walls.
        // Young history cannot reliably distinguish a recurring bright surface
        // from a one-frame Monte Carlo spike. In that regime, lean slightly more
        // on the robust current-frame neighborhood; mature history restores the
        // original wider tolerance so converged HDR detail is not clipped.
        float historyConfidence = (wSum > 0.25)
            ? smoothstep(1.0, 4.0, histLen) * smoothstep(0.25, 0.75, wSum)
            : 0.0;
        float fireflySigmaScale = mix(1.75, 2.0, historyConfidence);
        float fireflySigma = max(robustSigma * fireflySigmaScale,
                                 localFireflyScale * 0.12 + 0.005);
        float fireflyRelativeGate = baseline * 1.9 + max(0.012, baseline * 0.12);
        float robustSigmaScale = mix(2.0, 2.5, historyConfidence);
        float robustFireflyLimit = medianLum + max(robustSigmaScale * robustSigma,
                                                   medianLum * 1.10 + 0.012);
        float fireflyLimit = min(m1Y.x + 2.75 * fireflySigma,
                                 robustFireflyLimit);
        if (useDominanceRatio && isBimodal) {
            // A true firefly is an isolated spike unsupported by history, the
            // neighborhood, or surface cache. A supported bright cluster remains intact.
            bool loneDarkSpike = inDarkZone && (maxClusterLum < splitLum * 0.5) &&
                                 (rawYCoCg.x > max(darkFloor * 3.0, 0.045));
            bool outlierSpike = (rawYCoCg.x > fireflyLimit) &&
                                (rawYCoCg.x > fireflyRelativeGate);
            // A pixel inside a neighborhood-dominant bright tier is part of a
            // coherent high-energy region, not an isolated firefly. Preserve its
            // raw radiance even when reprojection history has not converged yet.
            realRawFirefly = (loneDarkSpike || outlierSpike) &&
                             !inBrightZone &&
                             !historySupportsCurrent && !cacheSupportsBright &&
                             !spatiallySupportedBright;
        } else {
            realRawFirefly = (rawYCoCg.x > robustFireflyLimit) &&
                             (rawYCoCg.x > fireflyRelativeGate) &&
                             !inBrightZone &&
                             !historySupportsCurrent && !cacheSupportsBright &&
                             !spatiallySupportedBright;
        }

        // =========================================================================
        // STAGE 2: Pre-filter Raw Sample (GI Temporal Firefly Rejection)
        // Soft rational compression: eliminates fireflies BEFORE moments computation
        // =========================================================================
        if ((pc.u.y & 2u) != 0u && realRawFirefly) {
            // Keep the clamp proportional in dark regions: a fixed 0.2 radiance
            // allowance can be larger than the entire local GI signal.
            // Clamp against the robust local population, not its maximum:
            // the maximum can itself be another firefly and otherwise raises
            // the allowance for every subsequent outlier.
            float allowedMax = medianLum + max(2.0 * robustSigma,
                                                medianLum * 1.10 + 0.010);
            if (rawYCoCg.x > allowedMax) {
                float excess = rawYCoCg.x - allowedMax;
                float compressedY = allowedMax + excess / (1.0 + excess / (allowedMax + 1.0));
                raw.rgb *= compressedY / max(rawYCoCg.x, 1e-4);
                rawYCoCg.x = compressedY;
            }
        }
        raw.rgb = max(raw.rgb, vec3(0.0)); // Preserve non-negative radiance

        // =========================================================================
        // STAGE 3: Compute Current Sample Moments from CLEANED raw sample
        // =========================================================================
        float cleanLum = dot(raw.rgb, vec3(0.2126, 0.7152, 0.0722));
        curSampleMoments = vec2(cleanLum, cleanLum * cleanLum);

        // =========================================================================
        // STAGE 4: History Clamping & Temporal Accumulation
        // =========================================================================
        if (wSum > 0.05) {
            float clampGamma = mix(3.5, 2.2, clamp(motionPixels * 0.15, 0.0, 1.0));
            vec3 clampMinY = m1Y - effectiveSigma * clampGamma;
            vec3 clampMaxY = m1Y + effectiveSigma * (clampGamma + 1.0);
            clampMinY.x = max(0.0, clampMinY.x);
            clampMaxY.x = max(clampMinY.x, clampMaxY.x);

            hist.a = clamp(hist.a, aoMin, aoMax);

            // =====================================================================
            // 3-Tier History Clamp Bounds (Ciemne / Średnie / Jasne):
            // - Ciemne (darkRatio): tight clamp ceiling in dark areas to kill noise
            // - Jasne (brightRatio): generous ceiling to NEVER truncate bright light
            // - Średnie (midtoneSmooth): smooth continuous transition in penumbra
            // =====================================================================
            float darkRatio = clamp(pc.f.z, 0.0, 1.0);
            float brightRatio = clamp(pc.f.w, 0.0, 1.0);
            float midtoneSmooth = float((pc.u.y >> 16u) & 0xFFu) / 255.0;

            float maxObserved = max(histY.x, max(rawYCoCg.x, maxClusterLum));
            float headroom = mix(4.0, 16.0, brightRatio);
            float brightCeiling = maxObserved * (1.0 + brightRatio * 5.0) + headroom;
            float darkCeiling = m1Y.x + effectiveSigma.x * mix(3.5, 1.2, darkRatio);
            if (temporallyFrequent) darkCeiling = max(darkCeiling, histY.x);

            float targetCeiling;
            if (useDominanceRatio) {
                // In purely dark zone without any bright light, targetCeiling is darkCeiling.
                // As soon as either raw ray or history exhibits light (maxObserved > 0.05),
                // targetCeiling smoothly lifts to brightCeiling so bright light is NEVER truncated!
                float hasLight = smoothstep(0.02, 0.15, maxObserved);
                float effectiveT = max(tBlend, hasLight);
                targetCeiling = mix(darkCeiling, brightCeiling, effectiveT);
            } else {
                targetCeiling = max(clampMaxY.x, brightCeiling);
            }

            if (temporallyFrequent || cacheSupportsBright) {
                targetCeiling = max(targetCeiling, histY.x * (1.0 + brightRatio * 2.0) + 1.0);
                clampMinY.x = min(clampMinY.x, histY.x * 0.5);
            }
            if (inBrightZone || histY.x > 0.15) {
                clampMinY.x = min(clampMinY.x, histY.x * max(0.05, 1.0 - brightRatio * 0.75));
            }
            if (motionPixels < 0.25 && temporallyFrequent) {
                // Static camera & mature history: protect converged history from single-frame noise truncation
                clampMinY.x = min(clampMinY.x, histY.x * 0.85);
                targetCeiling = max(targetCeiling, histY.x * 1.5 + 1.0);
            }

            clampMaxY.x = max(clampMaxY.x, targetCeiling);

            // Bit 0: "GI Patch Firefly Clamp" (GI Temporal Neighborhood Clamp)
            if ((pc.u.y & 1u) != 0u) {
                // In static scenes, never clamp converged history downward due to single-frame ray misses
                float lowerBound = (motionPixels > 0.5 || histLen < 2.0) ? clampMinY.x : min(clampMinY.x, histY.x * 0.5);
                float clampedHistY = clamp(histY.x, lowerBound, clampMaxY.x);
                hist.rgb *= clampedHistY / max(histY.x, 1e-4);
            }

            newLen = min(histLen + 1.0, effectiveMaxHist);
            float alpha = 1.0 / newLen;
            finalHitDistFactor = mix(prevHitDistFactor, curHitDistFactor, max(alpha, 0.25));
            result = vec4(mix(hist.rgb, raw.rgb, alpha), mix(hist.a, raw.a, alpha));

            // SVGF moments accumulation: blend spatial and temporal variance when history is short (< 4 frames)
            // to prevent variance starvation, edge-stopping collapse, and noisy boiling on disocclusions.
            vec2 accumulatedMoments = mix(histMoments.xy, curSampleMoments, alpha);
            float temporalVar = max(0.0, accumulatedMoments.y - accumulatedMoments.x * accumulatedMoments.x);
            float variance = (newLen < 8.0) ? max(spatialVar, temporalVar) : temporalVar;
            variance = max(variance, 0.005);
            outMoments = vec4(accumulatedMoments, variance, variance);
        } else {
            newLen = 1.0;
            finalHitDistFactor = curHitDistFactor;
            result = raw;
            outMoments = vec4(curSampleMoments, spatialVar, spatialVar);
        }
    }

    // Reproject all 12 energy lobes and the independent valid-path count using
    // the same geometry-accepted taps as GI. Count remains samples/frame.
    vec4 cur0=imageLoad(imgGiDirectionBins0,px),cur1=imageLoad(imgGiDirectionBins1,px);
    vec4 cur2=imageLoad(imgGiDirectionBins2,px),curCount=imageLoad(imgGiDirectionCount,px);
    vec4 prev0=(wSum>0.05)?histDirectionBins0/wSum:vec4(0);
    vec4 prev1=(wSum>0.05)?histDirectionBins1/wSum:vec4(0);
    vec4 prev2=(wSum>0.05)?histDirectionBins2/wSum:vec4(0);
    vec4 prevCount=(wSum>0.05)?histDirectionCount/wSum:vec4(0);
    vec4 out0=cur0,out1=cur1,out2=cur2,outCount=curCount;
    if(isCheckerSkipped){out0=prev0;out1=prev1;out2=prev2;outCount=prevCount;}
    else if(wSum>0.05){
        float alpha=1.0/max(newLen,1.0);
        out0=mix(prev0,cur0,alpha);out1=mix(prev1,cur1,alpha);
        out2=mix(prev2,cur2,alpha);outCount=mix(prevCount,curCount,alpha);
    }
    imageStore(imgGiDirectionBins0,px,out0);imageStore(imgGiDirectionBins1,px,out1);
    imageStore(imgGiDirectionBins2,px,out2);imageStore(imgGiDirectionCount,px,outCount);

    // Keep one measured first-hit path as a temporal reservoir. Hit positions
    // and encoded normals are selected, never averaged into a synthetic path.
    // The normal image stores: oct-normal.xy, per-frame hit support.z,
    // temporal path-stability confidence.w.
    vec4 curPathPosition=imageLoad(imgGiPathPosition,px);
    vec4 curPathNormal=imageLoad(imgGiPathNormal,px);
    bool currentPathValid = curPathPosition.w > 1e-6 && curPathNormal.z > 0.0;
    bool historyPathValid = wSum > 0.05 && histPathBestScore > 0.0 &&
                            histPathPositionBest.w > 1e-6 && histPathNormalBest.z > 0.0;
    // Keep the current frame's measured path as the guide whenever it exists.
    // Temporal history is evidence for stability, not a competing direction
    // reservoir: weighting old paths by history length made debug mode 26 drift
    // toward stale directions and made per-frame support appear accumulated.
    vec4 outPathPosition=vec4(0),outPathNormal=vec4(0);
    float currentSupport=clamp(curPathNormal.z,0.0,1.0);
    float historyStability=historyPathValid?clamp(histPathNormalBest.w,0.0,1.0):0.0;
    float pathAgreement=0.0;

    if(currentPathValid && historyPathValid){
        vec3 currentDelta=curPathPosition.xyz-P;
        vec3 historyDelta=histPathPositionBest.xyz-P;
        float currentDistance=length(currentDelta);
        float historyDistance=length(historyDelta);
        if(currentDistance>1e-4 && historyDistance>1e-4){
            float directionAgreement=clamp(dot(currentDelta/currentDistance,historyDelta/historyDistance),-1.0,1.0);
            float normalAgreement=max(dot(rtOctDecode(curPathNormal.xy),rtOctDecode(histPathNormalBest.xy)),0.0);
            float distanceAgreement=exp(-abs(currentDistance-historyDistance)/
                max(0.10,0.15*min(currentDistance,historyDistance)));
            pathAgreement=smoothstep(0.78,0.98,directionAgreement)*
                          smoothstep(0.65,0.95,normalAgreement)*distanceAgreement;
        }
    }

    if(isCheckerSkipped){
        // No current trace was made for this checkerboard pixel. Reuse the
        // geometry-validated historical record without claiming new support.
        if(historyPathValid){outPathPosition=histPathPositionBest;outPathNormal=histPathNormalBest;}
    }else if(currentPathValid){
        // Modes 26 and 28 now describe this frame's actual traced paths.
        // History affects only .w (stability), never the measured direction or
        // per-frame support in .z.
        outPathPosition=curPathPosition;
        outPathNormal=curPathNormal;
        if(historyPathValid){
            // Agreement is a hard gate: a different first-hit path cannot
            // inherit the confidence of the previous frame.
            float stabilityAlpha=clamp(0.20+0.35*currentSupport,0.20,0.55);
            outPathNormal.w=mix(historyStability,currentSupport,stabilityAlpha)*pathAgreement;
        }else{
            // A newly observed path starts provisional; repeated matching
            // measurements are required before it becomes trusted.
            outPathNormal.w=currentSupport*0.20;
        }
    }else if(historyPathValid){
        // No radiance-bearing path was measured this frame. Retain the last
        // valid record with a gentle stability decay, but do not call it new
        // support (the .z value remains explicitly historical in this fallback).
        outPathPosition=histPathPositionBest;
        outPathNormal=histPathNormalBest;
        outPathNormal.w=historyStability*0.995;
    }
    imageStore(imgGiPathPosition,px,outPathPosition);
    imageStore(imgGiPathNormal,px,outPathNormal);

    // Persistent caches restore disoccluded pixels and gently support young
    // reprojection history while it converges to the current per-pixel estimate.
    bool isDisoccluded = (isCheckerSkipped && wSum <= 0.05) ||
                         (!isCheckerSkipped && wSum <= 0.05);
    if (isDisoccluded || newLen < 3.0) {
        vec4 surfaceHistory = vec4(0.0);
        float surfaceCoverage = 0.0;
        bool restoredSurface = false;
        if ((pc.u.x & 2u) != 0u) {
            pixelCacheDiag[3]++;
            restoredSurface = loadSurfaceHistory(P, N, pc.u.z, pc.u.w, surfaceHistory, surfaceCoverage);
            if (restoredSurface) pixelCacheDiag[1]++;
        }
        bool surfaceHistoryApplied = restoredSurface && surfaceHistory.a > newLen;
        if (surfaceHistoryApplied) {
            float blendW = isDisoccluded ? (0.75 * surfaceCoverage) : (0.15 * surfaceCoverage);
            result.rgb = mix(result.rgb, surfaceHistory.rgb, blendW);
            newLen = clamp(max(newLen, min(surfaceHistory.a, 6.0)), 2.0, effectiveMaxHist);
            float restoredVariance = max(outMoments.z, 0.005);
            outMoments.zw = max(outMoments.zw, vec2(restoredVariance));
        }
        // Surface History wins when it actually restored a contribution; WRC is fallback only.
        if (isDisoccluded && !surfaceHistoryApplied && (pc.u.x & 4u) != 0u) {
            pixelCacheDiag[2]++;
            vec4 cached = sampleWorldRadianceCacheTangentJitter(P, N, px, pc.u.w);
            if (cached.a > 0.0) {
                pixelCacheDiag[0]++;
                result.rgb = mix(result.rgb, cached.rgb, 0.25 * cached.a);
                newLen = max(newLen, 2.0 * cached.a);
            }
        }
    }

    bool surfaceHistoryDebug = (pc.u.y & 8u) != 0u;
    uvec2 writePhase = uvec2(pc.u.w & 1u, (pc.u.w >> 1u) & 1u);
    bool writeSample = all(equal((uvec2(px) & 1u), writePhase));
    // Surface History debug views must be read-only: otherwise this dispatch
    // races its per-pixel diagnostic reads against concurrent cache writers,
    // making transient odd sequence values appear as false red misses.
    if ((pc.u.x & 2u) != 0u && !surfaceHistoryDebug && !isCheckerSkipped && d < 1.0 &&
        writeSample && newLen >= 2.0) {
        storeSurfaceHistory(P, N, result.rgb, newLen, pc.u.z, pc.u.w, false);
    }

    imageStore(imgHistCur, px, result);
    imageStore(imgMomentsCur, px, outMoments);

    // Publish temporal history length before replacing the display output with
    // cache diagnostics. The diagnostic view must not poison temporal history.
    geom.w = packGiGeomW(newLen, finalHitDistFactor);
    imageStore(imgGeomCur, px, geom);
    ageBin = min(uint(clamp(newLen / effectiveMaxHist, 0.0, 0.999999) * 16.0), 15u);
    histogramCounted = true;

    if (cacheDebugMode) {
        vec3 debugColor = !cacheDebugEnabled ? vec3(0.05, 0.15, 0.85)
                         : cacheDebugHit ? vec3(0.0, 0.85, 0.05)
                                         : vec3(0.85, 0.02, 0.02);
        if (cacheDebugEnabled && cacheDebugHit) {
            if ((pc.u.y & 32u) != 0u) {
                // Hue-preserving log compression: map the peak channel, then
                // scale RGB uniformly. Independent channel clipping would turn
                // saturated warm HDR radiance artificially yellow.
                vec3 hdr = max(cacheDebugValue.rgb, vec3(0.0));
                float peak = max(max(hdr.r, hdr.g), hdr.b);
                if (peak > 1e-5) {
                    float mappedPeak = clamp(log2(1.0 + peak * 6.0) / log2(25.0), 0.0, 1.0);
                    debugColor = hdr * (mappedPeak / peak);
                } else {
                    debugColor = vec3(0.0);
                }
            } else if ((pc.u.y & 64u) != 0u) {
                if ((pc.u.y & 4u) != 0u) {
                    // Show the raw probe sample weight, not the already saturated
                    // smoothstep confidence used by lighting. This exposes convergence.
                    // WRC stores weights from 8 (new cell) to 64 (mature cell).
                    float weight = clamp(log2(1.0 + max(cacheDebugValue.a, 0.0)) / log2(65.0), 0.0, 1.0);
                    vec3 weightColor = weight < 0.5
                        ? mix(vec3(0.05, 0.10, 0.85), vec3(0.0, 0.95, 0.85), weight * 2.0)
                        : mix(vec3(0.0, 0.95, 0.85), vec3(1.0, 0.90, 0.0), (weight - 0.5) * 2.0);
                    // Brightness carries the plane-distance confidence multiplier.
                    debugColor = weightColor * (0.2 + 0.8 * cacheDebugConfidence);
                } else {
                    float age = clamp(log2(1.0 + max(cacheDebugValue.a, 0.0)) / log2(257.0), 0.0, 1.0);
                    debugColor = vec3(age, age * age, 1.0 - age);
                }
            }
        }
        imageStore(imgHistCur, px, vec4(debugColor, 1.0));
    }

}

void main() {
    uint ageBin = 0u;
    bool histogramCounted = false;
    uint pixelDiag[8];
    uint pixelCacheDiag[4];
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    processPixel(px, ageBin, histogramCounted, pixelDiag, pixelCacheDiag);

    uint diagMask = 0u;
    for (uint metric = 0u; metric < 8u; ++metric) diagMask |= pixelDiag[metric];
    uvec4 diagBallot = subgroupBallot(diagMask != 0u);
    if (subgroupBallotBitCount(diagBallot) != 0u) {
        for (uint metric = 0u; metric < 8u; ++metric) {
            addDiagCounter(metric, pixelDiag[metric]);
        }
    }

    uint cacheDiagMask = 0u;
    for (uint metric = 0u; metric < 4u; ++metric) cacheDiagMask |= pixelCacheDiag[metric];
    uvec4 cacheDiagBallot = subgroupBallot(cacheDiagMask != 0u);
    if (subgroupBallotBitCount(cacheDiagBallot) != 0u) {
        for (uint metric = 0u; metric < 4u; ++metric) {
            addDiagCounter(56u + metric, pixelCacheDiag[metric]);
        }
    }

    // Sky/out-of-bounds-only subgroups have no age-bin work to reduce.
    uvec4 histogramBallot = subgroupBallot(histogramCounted);
    if (subgroupBallotBitCount(histogramBallot) != 0u) {
        for (uint bin = 0u; bin < 16u; ++bin) {
            uvec4 ballot = subgroupBallot(histogramCounted && ageBin == bin);
            uint binCount = subgroupBallotBitCount(ballot);
            if (subgroupElect() && binCount != 0u) {
                atomicAdd(rtDiag.counters[16u + bin], binCount);
            }
        }
    }
}
