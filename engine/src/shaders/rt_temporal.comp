#version 460

#extension GL_EXT_ray_query : require

#extension GL_EXT_buffer_reference2 : require

#extension GL_EXT_scalar_block_layout : require

#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

#extension GL_EXT_nonuniform_qualifier : require

#extension GL_GOOGLE_include_directive : require



// Pass 2/4: temporal accumulation with camera reprojection, motion vectors,
// geometric history rejection, 3x3 neighborhood clamping, EMA, and SVGF moments.
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

#include "rt_common.glsl"
#include "rt_screen.glsl"
#include "gi_world_cache_common.glsl"
#include "gi_surface_history_common.glsl"

vec3 rgbToYCoCg(vec3 c) {
    return vec3(
         0.25 * c.r + 0.5 * c.g + 0.25 * c.b,
         0.5  * c.r             - 0.5  * c.b,
        -0.25 * c.r + 0.5 * c.g - 0.25 * c.b
    );
}

vec3 yCoCgToRgb(vec3 c) {
    float y  = c.x;
    float co = c.y;
    float cg = c.z;
    return vec3(
        y + co - cg,
        y + cg,
        y - co - cg
    );
}



layout(set = 1, binding = 0) uniform sampler2D uDepth;

layout(set = 1, binding = 1, rgba16f) uniform image2D imgS;        // in : raw trace output

layout(set = 1, binding = 3, rgba32f) uniform image2D imgGeomCur;  // in/out: history length written to .w

layout(set = 1, binding = 4, rgba32f) uniform image2D imgGeomPrev; // in

layout(set = 1, binding = 5, rgba16f) uniform image2D imgHistCur;  // out

layout(set = 1, binding = 6, rgba16f) uniform image2D imgHistPrev; // in

layout(set = 1, binding = 12) uniform sampler2D uMotion;           // in: screen-space motion vectors

layout(set = 1, binding = 13, rgba16f) uniform image2D imgMomentsCur;  // out: mu1, mu2, variance, filtered_var

layout(set = 1, binding = 14, rgba16f) uniform image2D imgMomentsPrev; // in: reprojected moments

layout(set = 1, binding = 15, std430) buffer RtDiagnostics { uint counters[48]; } rtDiag;
layout(set = 1, binding = 20, std430) readonly buffer WorldRadianceCacheBuf { WorldRadianceCell cells[]; } worldRadianceCache;

bool trySampleWorldRadianceCache(uint cellKey, vec3 n, uint currentFrame, out vec4 result) {
    uint baseIndex = cellKey % CACHE_CELL_COUNT;
    for (uint probe = 0u; probe < 4u; ++probe) {
        uint idx = (baseIndex + probe) % CACHE_CELL_COUNT;
        WorldRadianceCell cell = worldRadianceCache.cells[idx];
        if (cell.cellKey != cellKey || cell.irradiance.a <= 0.0)
            continue;
        if (currentFrame < cell.lastSeenFrame ||
            (currentFrame - cell.lastSeenFrame) > 2048u)
            continue;
        if (dot(unpackNormalOctahedral(cell.packedNormal), n) <= 0.5)
            continue;
        result = vec4(cell.irradiance.rgb, clamp(cell.irradiance.a / 8.0, 0.0, 1.0));
        return true;
    }
    return false;
}

vec4 sampleWorldRadianceCache(vec3 worldPos, vec3 worldNormal, uint currentFrame) {
    vec3 n = normalize(worldNormal);
    uint cellKey = computeWorldCellKey(worldPos, n, DEFAULT_CELL_SIZE);
    vec4 cached = vec4(0.0);
    if (trySampleWorldRadianceCache(cellKey, n, currentFrame, cached))
        return cached;

    // Retry the adjacent voxel closest to the normal-biased point.
    vec3 snappedPos = worldPos + n * (DEFAULT_CELL_SIZE * 0.25);
    vec3 gridPos = snappedPos / DEFAULT_CELL_SIZE;
    ivec3 baseCell = ivec3(floor(gridPos));
    vec3 fraction = fract(gridPos);
    vec3 edgeDistance = min(fraction, vec3(1.0) - fraction);
    int axis = (edgeDistance.x <= edgeDistance.y && edgeDistance.x <= edgeDistance.z) ? 0 :
               ((edgeDistance.y <= edgeDistance.z) ? 1 : 2);
    if (edgeDistance[axis] > 0.10) return vec4(0.0);
    ivec3 neighbor = baseCell;
    neighbor[axis] += (fraction[axis] < 0.5) ? -1 : 1;
    vec3 neighborCenter = (vec3(neighbor) + vec3(0.5)) * DEFAULT_CELL_SIZE;
    uint neighborKey = computeWorldCellKey(neighborCenter, n, DEFAULT_CELL_SIZE);
    if (trySampleWorldRadianceCache(neighborKey, n, currentFrame, cached))
        return cached;
    return vec4(0.0);
}



layout(push_constant) uniform PC {

    mat4 prevViewProj;

    vec4 f;   // x = max history, y = samples per pixel, z = history valid, w = svgfEnabled

    uvec4 u;

} pc;



shared uint rtLocalCounters[48];

void processPixel(ivec2 px, out uint ageBin, out bool histogramCounted) {
    histogramCounted = false;
    ageBin = 0u;


    ivec2 isize = imageSize(imgS);

    if (any(greaterThanEqual(px, isize))) return;

    vec2 size = vec2(isize);



    atomicAdd(rtLocalCounters[0], 1u);
    vec4 geom = imageLoad(imgGeomCur, px);

    if (geom.z < 0.0) { // sky
        atomicAdd(rtLocalCounters[2], 1u);

        imageStore(imgHistCur, px, vec4(0.0, 0.0, 0.0, 1.0));

        imageStore(imgMomentsCur, px, vec4(0.0));
        ageBin = 0u;
        histogramCounted = true; // zero-age / sky

        return;

    }



    vec4 raw = imageLoad(imgS, px);

    vec3 N = rtOctDecode(geom.xy);

    vec2 curUV = (vec2(px) + 0.5) / size;
    ivec2 fullDepthSize = textureSize(uDepth, 0).xy;
    ivec2 fullPx = min(ivec2(curUV * vec2(fullDepthSize)), fullDepthSize - 1);
    float d = texelFetch(uDepth, fullPx, 0).r;
    float zC = rtLinearDepth(d);

    vec3 P = rtWorldPos(vec2(px) + 0.5, d, size);

    // Evaluate cache diagnostics before temporal work, but do not return here:
    // cache writes must still run while a cache-hit debug view is selected.
    bool cacheDebugMode = (pc.u.y & 12u) != 0u;
    bool cacheDebugEnabled = false;
    bool cacheDebugHit = false;
    if (cacheDebugMode) {
        if ((pc.u.y & 4u) != 0u) {
            cacheDebugEnabled = (pc.u.x & 4u) != 0u;
            if (cacheDebugEnabled)
                cacheDebugHit = sampleWorldRadianceCache(P, N, pc.u.w).a > 0.0;
        } else if ((pc.u.y & 8u) != 0u) {
            cacheDebugEnabled = (pc.u.x & 2u) != 0u;
            if (cacheDebugEnabled) {
                vec4 debugHistory = vec4(0.0);
                float debugCoverage = 0.0;
                cacheDebugHit = loadSurfaceHistory(P, N, pc.u.z, pc.u.w, debugHistory, debugCoverage);
            }
        }
    }

    if ((pc.u.x & 1u) != 0u && !cacheDebugMode) { // bypass normal temporal work only outside cache diagnostics.
        float rawLum = dot(raw.rgb, vec3(0.2126, 0.7152, 0.0722));
        imageStore(imgHistCur, px, raw);
        imageStore(imgMomentsCur, px, vec4(rawLum, rawLum * rawLum, 0.0, 0.0));
        geom.w = 1.0;
        imageStore(imgGeomCur, px, geom);
        ageBin = 0u;
        histogramCounted = true;
        return;
    }
    vec3 toCam = ubo.cameraPos.xyz - P;
    vec3 toCamNorm = (dot(toCam, toCam) > 1e-6) ? normalize(toCam) : vec3(0.0, 1.0, 0.0);
    float nDotV = clamp(abs(dot(N, toCamNorm)), 0.15, 1.0);

    vec4  hist = vec4(0.0);
    vec4  histMoments = vec4(0.0);
    float histLen = 0.0;
    float wSum = 0.0;

    ivec2 fullMotionSize = textureSize(uMotion, 0).xy;
    ivec2 fullMotionPx = min(ivec2(curUV * vec2(fullMotionSize)), fullMotionSize - 1);
    vec2 motion = texelFetch(uMotion, fullMotionPx, 0).xy;

    vec4 pClip = pc.prevViewProj * vec4(P, 1.0);
    if (pc.f.z > 0.5) {
        vec2 prevUV = curUV - motion;
        if (dot(motion, motion) < 1e-9 && pClip.w > 1e-4) {
            prevUV = (pClip.xy / pClip.w) * 0.5 + 0.5;
        }

        vec2 prevPx = prevUV * size - 0.5;
        ivec2 base = ivec2(floor(prevPx));
        vec2 fr = prevPx - vec2(base);

        // Slope-aware depth tolerance: grazing angles expand tolerance to prevent false history rejection
        float depthTol = (0.04 * pClip.w + 0.01) / nDotV;

        for (int i = 0; i < 4; ++i) {
            ivec2 o = ivec2(i & 1, i >> 1);
            ivec2 tp = base + o;
            if (any(lessThan(tp, ivec2(0))) || any(greaterThanEqual(tp, isize))) { atomicAdd(rtLocalCounters[3], 1u); continue; }

            vec4 g = imageLoad(imgGeomPrev, tp);
            if (g.z < 0.0) continue;

            // Disocclusion tests: slope-adjusted depth + surface normal
            if (abs(g.z - pClip.w) > depthTol) { atomicAdd(rtLocalCounters[4], 1u); continue; }
            if (dot(rtOctDecode(g.xy), N) < 0.8) { atomicAdd(rtLocalCounters[5], 1u); continue; }

            float w = ((o.x == 0) ? (1.0 - fr.x) : fr.x) * ((o.y == 0) ? (1.0 - fr.y) : fr.y);
            hist        += w * imageLoad(imgHistPrev, tp);
            histMoments += w * imageLoad(imgMomentsPrev, tp);
            histLen     += w * g.w;
            wSum        += w;
        }


    }

    float maxHist = max(pc.f.x, 1.0);
    // Screen-space motion includes camera movement. It is not evidence that
    // diffuse surface irradiance changed, so never shorten GI history from it.
    float effectiveMaxHist = maxHist;
    vec4 result;
    float newLen;

    float rawLum = dot(raw.rgb, vec3(0.2126, 0.7152, 0.0722));
    vec2 curSampleMoments = vec2(rawLum, rawLum * rawLum);
    vec4 outMoments = vec4(0.0);

    bool isCheckerSkipped = (raw.a < -0.5);
    if (isCheckerSkipped) {
        if (wSum > 0.05) {
            atomicAdd(rtLocalCounters[6], 1u);
            // Full temporal reuse from the alternating frame when this pixel was traced
            hist /= wSum;
            histMoments /= wSum;
            histLen /= wSum;
            result = hist;
            newLen = min(histLen, effectiveMaxHist); // Checkerboard reuse adds no new temporal observation.
            outMoments = histMoments;
        } else {
            atomicAdd(rtLocalCounters[7], 1u);
            // Disocclusion / invalid history: bilateral reconstruction from the 4 active neighbors in current frame
            vec4 neighborSum = vec4(0.0);
            float weightSum = 0.0;
            const ivec2 offsets[4] = ivec2[](ivec2(1, 0), ivec2(-1, 0), ivec2(0, 1), ivec2(0, -1));
            for (int i = 0; i < 4; ++i) {
                ivec2 np = px + offsets[i];
                if (any(lessThan(np, ivec2(0))) || any(greaterThanEqual(np, isize))) continue;
                vec4 nVal = imageLoad(imgS, np);
                if (nVal.a < 0.0) continue;

                vec4 nG = imageLoad(imgGeomCur, np);
                if (nG.z < 0.0) continue;
                // Comparing neighbor depth to current pixel linear depth zC in current frame
                float depthDiff = abs(nG.z - zC);
                if (depthDiff > 0.05 * zC + 0.02) continue;
                vec3 nNormal = rtOctDecode(nG.xy);
                float normalDot = max(dot(nNormal, N), 0.0);
                if (normalDot < 0.75) continue;

                float w = normalDot / (1.0 + depthDiff * 50.0);
                neighborSum += nVal * w;
                weightSum += w;
            }
            if (weightSum > 1e-4) {
                result = neighborSum / weightSum;
            } else {
                result = vec4(0.0, 0.0, 0.0, 1.0);
            }
            newLen = 1.0;
            float rLum = dot(result.rgb, vec3(0.2126, 0.7152, 0.0722));
            outMoments = vec4(rLum, rLum * rLum, 0.1, 0.1);
        }
    } else {
        if (wSum > 0.05) {
            atomicAdd(rtLocalCounters[1], 1u);
            hist /= wSum;
            histMoments /= wSum;
            histLen /= wSum;

            // 3x3 Neighborhood Hampel Outlier & Variance Clamping in YCoCg space
            vec3 rawYCoCg = rgbToYCoCg(raw.rgb);
            vec3 m1Y = vec3(0.0);
            vec3 m2Y = vec3(0.0);
            float count = 0.0;
            float aoMin = raw.a;
            float aoMax = raw.a;

            for (int dy = -1; dy <= 1; ++dy) {
                for (int dx = -1; dx <= 1; ++dx) {
                    if (dx == 0 && dy == 0) continue; // Exclude center pixel to prevent outlier self-contamination
                    ivec2 sp = px + ivec2(dx, dy);
                    if (any(lessThan(sp, ivec2(0))) || any(greaterThanEqual(sp, isize))) continue;
                    vec4 sVal = imageLoad(imgS, sp);
                    if (sVal.a < 0.0) continue; // Skip checkerboard-skipped neighbors
                    vec3 sY = rgbToYCoCg(sVal.rgb);
                    m1Y += sY;
                    m2Y += sY * sY;
                    aoMin = min(aoMin, sVal.a);
                    aoMax = max(aoMax, sVal.a);
                    count += 1.0;
                }
            }
            float spatialVar = 0.1;
            if (count >= 2.0) {
                m1Y /= count;
                m2Y /= count;
                vec3 sigmaY = sqrt(max(vec3(0.0), m2Y - m1Y * m1Y));
                spatialVar = max(0.0, m2Y.x - m1Y.x * m1Y.x);
                float gamma = 1.5 + 1.5 * clamp(histLen / 16.0, 0.0, 1.0);

                // Variance floor: prevent zero-clipping of weak indirect light in dark areas
                vec3 effectiveSigma = max(sigmaY, vec3(0.08, 0.04, 0.04));
                vec3 clampMinY = m1Y - gamma * effectiveSigma;
                vec3 clampMaxY = m1Y + gamma * effectiveSigma;
                clampMinY.x = max(0.0, clampMinY.x);
                clampMaxY.x = max(clampMinY.x, clampMaxY.x);

                vec3 histY = rgbToYCoCg(hist.rgb);
                hist.a = clamp(hist.a, aoMin, aoMax);

                // A bright sample is not automatically a firefly: preserve it when
                // nearby pixels show the same bright feature. Reject only a high sample
                // that is statistically rare in a sufficiently populated neighborhood.
                float fireflyThreshold = max(6.0 * sigmaY.x, max(m1Y.x * 7.0, 24.0));
                float supportThreshold = max(m1Y.x + sigmaY.x, rawYCoCg.x * 0.5);
                float brightNeighborCount = 0.0;
                float maxSupportedLum = clampMaxY.x;
                for (int fy = -1; fy <= 1; ++fy) {
                    for (int fx = -1; fx <= 1; ++fx) {
                        if (fx == 0 && fy == 0) continue;
                        ivec2 fp = px + ivec2(fx, fy);
                        if (any(lessThan(fp, ivec2(0))) || any(greaterThanEqual(fp, isize))) continue;
                        vec4 fVal = imageLoad(imgS, fp);
                        if (fVal.a < 0.0) continue;
                        float neighborLum = dot(fVal.rgb, vec3(0.2126, 0.7152, 0.0722));
                        if (neighborLum >= supportThreshold) {
                            brightNeighborCount += 1.0;
                            maxSupportedLum = max(maxSupportedLum, neighborLum);
                        }
                    }
                }
                bool isolatedFirefly = count >= 4.0 &&
                    brightNeighborCount <= floor(count * 0.125);
                // A valid reprojection (wSum > 0.2) identifies the same surface
                // across camera motion. Preserve its accumulated diffuse irradiance;
                // only an isolated firefly is allowed to force the history downward.
                if (!isolatedFirefly && wSum > 0.2) {
                    // Do not exponentially decay accumulated history while the camera moves.
                    // Protect mature history fully; retain a soft ceiling only for very young pixels.
                    vec3 safeHistPeak = (histLen >= 4.0) ? histY : min(histY, m1Y + max(sigmaY * 6.0, vec3(8.0)));
                    clampMaxY = max(clampMaxY, safeHistPeak);
                }
                // Preserve newly visible, spatially supported bright structures.
                if (!isolatedFirefly) clampMaxY.x = max(clampMaxY.x, maxSupportedLum);
                if ((pc.u.y & 1u) != 0u)
                    histY = clamp(histY, clampMinY, clampMaxY);
                hist.rgb = max(vec3(0.0), yCoCgToRgb(histY));
                if ((pc.u.y & 2u) != 0u && isolatedFirefly &&
                    rawYCoCg.x > m1Y.x + fireflyThreshold) {
                    rawYCoCg.x = m1Y.x + fireflyThreshold;
                    raw.rgb = max(vec3(0.0), yCoCgToRgb(rawYCoCg));
                }
            }
            raw.rgb = max(raw.rgb, vec3(0.0)); // No fixed radiance ceiling: preserve legitimate bright indirect light.

            // History length is measured in valid frames, not accumulated rays.
            // Each raw frame is already the average of its SPP samples, so SPP must
            // not change the temporal response speed or make 1 SPP freeze the image.
            newLen = min(histLen + 1.0, effectiveMaxHist);
            float alpha = 1.0 / newLen;
            result = mix(hist, raw, alpha);

            // SVGF moments accumulation: blend spatial and temporal variance when history is short (< 4 frames)
            // to prevent variance starvation, edge-stopping collapse, and noisy boiling on disocclusions.
            vec2 accumulatedMoments = mix(histMoments.xy, curSampleMoments, alpha);
            float temporalVar = max(0.0, accumulatedMoments.y - accumulatedMoments.x * accumulatedMoments.x);
            float variance = (newLen < 4.0) ? mix(spatialVar, temporalVar, clamp((newLen - 1.0) / 3.0, 0.0, 1.0)) : temporalVar;
            outMoments = vec4(accumulatedMoments, variance, variance);
        } else {
            atomicAdd(rtLocalCounters[2], 1u);
            newLen = 1.0;
            result = raw;

            // Disocclusion / rejected history: compute spatial variance over local 3x3 footprint
            float sumLum = 0.0;
            float sumLum2 = 0.0;
            float count = 0.0;
            for (int dy = -1; dy <= 1; ++dy) {
                for (int dx = -1; dx <= 1; ++dx) {
                    ivec2 sp = px + ivec2(dx, dy);
                    if (any(lessThan(sp, ivec2(0))) || any(greaterThanEqual(sp, isize))) continue;
                    vec4 sampleCol = imageLoad(imgS, sp);
                    if (sampleCol.a < 0.0) continue;
                    float l = dot(sampleCol.rgb, vec3(0.2126, 0.7152, 0.0722));
                    sumLum += l;
                    sumLum2 += l * l;
                    count += 1.0;
                }
            }
            float meanLum = sumLum / max(count, 1.0);
            float spatialVar = max(0.0, (sumLum2 / max(count, 1.0)) - meanLum * meanLum);
            outMoments = vec4(curSampleMoments, spatialVar, spatialVar);
        }
    }

    // Persistent caches restore disoccluded pixels and gently support young
    // reprojection history while it converges to the current per-pixel estimate.
    bool isDisoccluded = (isCheckerSkipped && wSum <= 0.05) ||
                         (!isCheckerSkipped && wSum <= 0.05);
    if (isDisoccluded || newLen < 12.0) {
        vec4 surfaceHistory = vec4(0.0);
        float surfaceCoverage = 0.0;
        bool restoredSurface = (pc.u.x & 2u) != 0u &&
                               loadSurfaceHistory(P, N, pc.u.z, pc.u.w, surfaceHistory, surfaceCoverage);
        if (restoredSurface && surfaceHistory.a > newLen) {
            // Restore most of the frozen object-space illumination on first visibility.
            // Fade support as per-pixel history matures to avoid visible 25 cm cache cells.
            float disocclusionWeight = isDisoccluded
                ? (0.85 * surfaceCoverage)
                : (0.25 * surfaceCoverage * clamp((12.0 - newLen) / 12.0, 0.0, 1.0));
            result.rgb = mix(result.rgb, surfaceHistory.rgb, disocclusionWeight);
            if (isDisoccluded) {
                newLen = clamp(surfaceHistory.a, 2.0, 12.0);
            }
        } else if (isDisoccluded && (pc.u.x & 4u) != 0u) {
            vec4 cached = sampleWorldRadianceCache(P, N, pc.u.w);
            if (cached.a > 0.0) {
                result.rgb = mix(result.rgb, cached.rgb, 0.75 * cached.a);
                newLen = max(newLen, 6.0 * cached.a);
            }
        }
    }

    bool surfaceHistoryDebug = (pc.u.y & 12u) != 0u;
    uvec2 writePhase = uvec2(pc.u.w & 1u, (pc.u.w >> 1u) & 1u);
    bool writeSample = all(equal((uvec2(px) & 1u), writePhase));
    if ((pc.u.x & 2u) != 0u && !isCheckerSkipped && d < 1.0 &&
        (writeSample && newLen >= 2.0 || surfaceHistoryDebug)) {
        storeSurfaceHistory(P, N, result.rgb, newLen, pc.u.z, pc.u.w, false);
    }

    imageStore(imgHistCur, px, result);
    imageStore(imgMomentsCur, px, outMoments);

    // Publish temporal history length before replacing the display output with
    // cache diagnostics. The diagnostic view must not poison temporal history.
    geom.w = newLen;
    imageStore(imgGeomCur, px, geom);
    ageBin = min(uint(clamp(newLen / effectiveMaxHist, 0.0, 0.999999) * 16.0), 15u);
    histogramCounted = true;

    if (cacheDebugMode) {
        vec3 debugColor = !cacheDebugEnabled ? vec3(0.05, 0.15, 0.85)
                         : cacheDebugHit ? vec3(0.0, 0.85, 0.05)
                                         : vec3(0.85, 0.02, 0.02);
        imageStore(imgHistCur, px, vec4(debugColor, 1.0));
    }

}

void main() {
    uint lane = gl_LocalInvocationIndex;
    if (lane < 48u) rtLocalCounters[lane] = 0u;
    barrier();

    uint ageBin = 0u;
    bool histogramCounted = false;
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    processPixel(px, ageBin, histogramCounted);
    if (histogramCounted) atomicAdd(rtLocalCounters[16u + ageBin], 1u);

    barrier();
    if (lane < 48u) {
        uint count = rtLocalCounters[lane];
        if (count != 0u) atomicAdd(rtDiag.counters[lane], count);
    }
}
