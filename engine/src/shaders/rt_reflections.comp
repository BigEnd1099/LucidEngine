#version 460
#extension GL_EXT_ray_query : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_GOOGLE_include_directive : require

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

#include "rt_common.glsl"
#include "rt_screen.glsl"

layout(set = 1, binding = 0) uniform sampler2D uDepth;
layout(set = 1, binding = 1, rgba16f) uniform readonly image2D imgGI;
layout(set = 1, binding = 4, rgba32f) uniform image2D imgGeomPrev;
layout(set = 1, binding = 7) uniform sampler2D uGNormalRoughness;
layout(set = 1, binding = 8) uniform sampler2D uGAlbedoMetallic;
layout(set = 1, binding = 9, rgba16f) uniform image2D imgRefl;
// Screen-space SSGI radiance cache (same sampled image as the PBR SSAO/SSGI input).
layout(set = 0, binding = 7) uniform sampler2D ssgiRadianceMap;

layout(push_constant) uniform PC {
    mat4  unused;
    vec4  f;
    uvec4 u;   // x = samples per pixel (1..16), y = frame index, z = flags, w = max bounces
} pc;

const float MAX_REFL_DIST = 1000.0;

void main() {
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    ivec2 isize = imageSize(imgRefl);
    if (any(greaterThanEqual(px, isize))) return;
    vec2 size = vec2(isize);

    float d = texelFetch(uDepth, px, 0).r;
    if (d >= 1.0 || ubo.rtParams.x < 0.5 || ubo.rtParams.w < 0.5) {
        imageStore(imgRefl, px, vec4(0.0));
        return;
    }

    vec4 gNR = texelFetch(uGNormalRoughness, px, 0);
    vec3 N = gNR.xyz;
    if (dot(N, N) > 1e-4) {
        N = normalize(N);
    } else {
        imageStore(imgRefl, px, vec4(0.0));
        return;
    }

    // Unclamped roughness allows mirror metals (roughness 0.0) to have exact specular rays
    float roughness = clamp(gNR.w, 0.0, 1.0);

    vec3 P = rtWorldPos(vec2(px) + 0.5, d, size);
    vec3 V = normalize(ubo.cameraPos.xyz - P);
    if (dot(N, V) < 0.0) N = -N;

    vec3 idealR = normalize(reflect(-V, N));
    vec3 tangent, bitangent;
    buildBasis(idealR, tangent, bitangent);

    int baseSamples = int(clamp(pc.u.x, 1u, 16u));
    int samples = baseSamples;
    vec4 prevG = imageLoad(imgGeomPrev, px);
    if (prevG.w < 4.0 && baseSamples < 4) {
        samples = min(baseSamples * 2, 4);
    }
    uint frame = pc.u.y;
    rngInit(uvec2(px), frame);

    vec3 accumulated = vec3(0.0);
    float spread = roughness * roughness * 0.85;
    vec3 rayOrig = P + N * 0.012;

    int numActiveLights = min(ubo.numLights, 8);

    for (int s = 0; s < samples; ++s) {
        vec2 disk = sampleUniformDisk(rand2());
        vec3 dir = (roughness < 0.02) ? idealR : normalize(idealR + tangent * disk.x * spread + bitangent * disk.y * spread);
        if (dot(dir, N) <= 0.0) dir = reflect(dir, N);

        RtInstanceData hit;
        vec3 hitPos, hitNorm;
        vec2 hitUv;
        vec4 hitTangent;
        float hitDist;

        bool hitGeo = traceSceneSurface(rayOrig, dir, MAX_REFL_DIST, hit, hitPos, hitNorm, hitUv, hitTangent, hitDist);
        float closestDist = hitGeo ? hitDist : MAX_REFL_DIST;

        // Analytical point/spot/area lights intersection (light bulbs have no TLAS geometry)
        bool hitBulb = false;
        vec3 bulbRadiance = vec3(0.0);
        float closestBulbDist = closestDist;

        for (int li = 0; li < numActiveLights; ++li) {
            float intensity = max(ubo.lightsCol[li].w, 0.0);
            if (intensity <= 0.001) continue;

            vec3 lightPos = ubo.lightsPos[li].xyz;
            float range = max(ubo.lightsPos[li].w, 0.1);
            int type = int(round(ubo.lightsDir[li].w));
            float bulbRadius = clamp(range * 0.02, 0.08, 0.35);
            if (type == 2) {
                bulbRadius = clamp(max(ubo.lightsParams[li].z, ubo.lightsParams[li].w) * 0.5, 0.1, 0.6);
            }

            vec3 OC = lightPos - rayOrig;
            float tProj = dot(OC, dir);
            if (tProj > 0.0) {
                float d2 = dot(OC, OC) - tProj * tProj;
                float r2 = bulbRadius * bulbRadius;
                if (d2 < r2) {
                    float tHit = tProj - sqrt(max(0.0, r2 - d2));
                    if (tHit > 0.0 && tHit < closestBulbDist) {
                        bool conePass = true;
                        if (type == 1) {
                            vec3 toHit = normalize((rayOrig + dir * tHit) - lightPos);
                            float cone = dot(toHit, normalize(ubo.lightsDir[li].xyz));
                            conePass = (cone > ubo.lightsParams[li].y);
                        }
                        if (conePass) {
                            if (!rayQueryOccluded(rayOrig, dir, max(0.001, tHit - 0.02))) {
                                closestBulbDist = tHit;
                                float distRatio = tHit / range;
                                float window = clamp(1.0 - pow(distRatio, 4.0), 0.0, 1.0);
                                float attenuation = (window * window) / (tHit * tHit * 0.25 + 1.0);
                                bulbRadiance = ubo.lightsCol[li].rgb * (intensity * 6.0 * attenuation);
                                hitBulb = true;
                            }
                        }
                    }
                }
            }
        }

        if (hitBulb) {
            accumulated += bulbRadiance;
        } else if (hitGeo) {
            vec3 hitRadiance = shadeRtHit(hit, hitPos, hitNorm, hitUv, hitTangent, dir, false);

            // Screen-Space Radiance Cache / GI Reprojection:
            // Fetch indirect diffuse GI for secondary hit points visible on screen
            vec4 clipPos = ubo.viewProj * vec4(hitPos, 1.0);
            if (clipPos.w > 0.001) {
                vec2 hitUV = (clipPos.xy / clipPos.w) * 0.5 + 0.5;
                if (all(greaterThanEqual(hitUV, vec2(0.0))) && all(lessThanEqual(hitUV, vec2(1.0)))) {
                    float screenDepth = textureLod(uDepth, hitUV, 0.0).r;
                    if (abs(clipPos.z / clipPos.w - screenDepth) < 0.02) {
                        ivec2 giSize = imageSize(imgGI);
                        ivec2 hitPx = clamp(ivec2(hitUV * vec2(giSize)), ivec2(0), giSize - 1);
                        // RT GI is a separately controlled feature. Its cache stores
                        // the source pixel's BRDF-weighted diffuse indirect contribution,
                        // so it is added as outgoing radiance at this secondary hit.
                        // Do not sample the cache when RT GI is disabled: stale contents
                        // from a previous frame/setting must never leak into reflections.
                        if (ubo.rtParams.x > 0.5 && ubo.rtFeatureParams.x > 0.5) {
                            vec3 screenGI = max(imageLoad(imgGI, hitPx).rgb, vec3(0.0));
                            hitRadiance += screenGI;
                        }

                        // Screen-space SSGI is a distinct approximation with its own
                        // existing user control. Keep it independent from RT GI so users
                        // can compare/enable either technique, or deliberately combine
                        // both. The two are not silently forced on together.
                        if (ubo.bounceParams.x > 0.5) {
                            vec4 albSamp = textureLod(rtAlbedoTextures[nonuniformEXT(hit.textureIndices.x)], hitUv, 0.0);
                            vec3 texLinear = pow(max(albSamp.rgb, vec3(0.0)), vec3(2.2));
                            vec3 hitAlbedo = clamp(hit.baseColor.rgb * texLinear, vec3(0.0), vec3(1.0));
                            vec3 hitOrm = textureLod(rtOrmTextures[nonuniformEXT(hit.textureIndices.z)], hitUv, 0.0).rgb;
                            float hitMetallic = clamp(hit.material.x * hitOrm.b, 0.0, 1.0);
                            vec3 F0_hit = mix(vec3(0.04), hitAlbedo, hitMetallic);
                            float hitNdotV = max(dot(normalize(hitNorm), -dir), 0.0);
                            vec3 F_hit = F0_hit + (1.0 - F0_hit) * pow(1.0 - hitNdotV, 5.0);
                            vec3 kD_hit = (vec3(1.0) - F_hit) * (1.0 - hitMetallic);
                            vec3 screenSSGI = max(textureLod(ssgiRadianceMap, hitUV, 0.0).rgb, vec3(0.0));
                            hitRadiance += (kD_hit * hitAlbedo / 3.14159265359) * screenSSGI;
                        }
                    }
                }
            }

            accumulated += hitRadiance;
        } else {
            // Missed geometry & light bulbs: sample sky radiance (includes sun disk + corona + HDRI cubemap)
            if ((ubo.skyboxMode & 3) != 0) {
                accumulated += sampleRtSkyRadiance(dir);
            }
        }
    }

    vec3 refl = sanitizeHDR(accumulated / float(samples));
    imageStore(imgRefl, px, vec4(refl, 1.0));
}
