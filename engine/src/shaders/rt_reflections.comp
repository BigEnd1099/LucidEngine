#version 460
#extension GL_EXT_ray_query : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_GOOGLE_include_directive : require

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
#include "rt_common.glsl"
#include "rt_screen.glsl"

layout(set = 1, binding = 0) uniform sampler2D uDepth;
layout(set = 1, binding = 1, rgba16f) uniform readonly image2D imgGI;
layout(set = 1, binding = 4, rgba32f) uniform image2D imgGeomPrev;
layout(set = 1, binding = 7) uniform sampler2D uGNormalRoughness;
layout(set = 1, binding = 8) uniform sampler2D uGAlbedoMetallic;
layout(set = 1, binding = 9, rgba16f) uniform image2D imgRefl;
layout(set = 0, binding = 7) uniform sampler2D ssgiRadianceMap;

layout(push_constant) uniform PC {
    mat4 unused;
    vec4 f;
    uvec4 u; // x=samples, y=frame, z=flags, w=reflection bounces (2..4)
} pc;

const float MAX_REFL_DIST = 1000.0;
const float FIREFLY_CLAMP = 32.0;

vec3 sampleGGX(vec2 u, vec3 N, float roughness) {
    float a = max(roughness * roughness, 0.001);
    float phi = 2.0 * PI * u.x;
    float cosTheta = sqrt(clamp((1.0 - u.y) / (1.0 + (a * a - 1.0) * u.y), 0.0, 1.0));
    float sinTheta = sqrt(max(0.0, 1.0 - cosTheta * cosTheta));
    vec3 hLocal = vec3(cos(phi) * sinTheta, sin(phi) * sinTheta, cosTheta);
    vec3 T, B;
    buildBasis(N, T, B);
    return normalize(T * hLocal.x + B * hLocal.y + N * hLocal.z);
}

// Indirect diffuse at a secondary hit.
//  - hit visible on screen: reuse the denoised RT GI / SSGI cache,
//  - hit off-screen or hidden in screen space: trace one cosine-weighted diffuse ray from the hit point.
vec3 screenIndirectAtHit(RtInstanceData hit, vec3 hitPos, vec3 hitNorm, vec2 hitUv, vec3 dir, float pathEnergy, bool allowTrace) {
    bool useRtGI = (ubo.rtParams.x > 0.5 && ubo.rtFeatureParams.x > 0.5);
    bool useSSGI = (ubo.bounceParams.x > 0.5);
    if (!useRtGI && !useSSGI) return vec3(0.0);

    vec4 albSamp = textureLod(rtAlbedoTextures[nonuniformEXT(hit.textureIndices.x)], hitUv, 2.0);
    vec3 texLinear = pow(max(albSamp.rgb, vec3(0.0)), vec3(2.2));
    vec3 hitAlbedo = clamp(hit.baseColor.rgb * texLinear, vec3(0.0), vec3(1.0));
    vec3 hitOrm = textureLod(rtOrmTextures[nonuniformEXT(hit.textureIndices.z)], hitUv, 2.0).rgb;
    float hitMetallic = clamp(hit.material.x * hitOrm.b, 0.0, 1.0);
    vec3 F0 = mix(vec3(0.04), hitAlbedo, hitMetallic);
    vec3 Nh = normalize(hitNorm);
    float NdotV = max(dot(Nh, -dir), 0.0);
    vec3 F = F0 + (1.0 - F0) * pow(1.0 - NdotV, 5.0);
    vec3 diffuseResponse = (1.0 - F) * (1.0 - hitMetallic) * hitAlbedo;
    if (max(diffuseResponse.r, max(diffuseResponse.g, diffuseResponse.b)) < 1e-3) return vec3(0.0);

    // 1) Visible on screen: reuse the cached GI with guard-band edge fading.
    vec4 clipPos = ubo.viewProj * vec4(hitPos, 1.0);
    vec3 screenGI = vec3(0.0);
    float screenWeight = 0.0;
    if (clipPos.w > 0.001) {
        vec2 hitUV = clipPos.xy / clipPos.w * 0.5 + 0.5;
        vec2 edgeFade = smoothstep(vec2(0.0), vec2(0.06), hitUV) * smoothstep(vec2(1.0), vec2(0.94), hitUV);
        float wEdge = edgeFade.x * edgeFade.y;
        if (wEdge > 0.001) {
            float screenDepth = textureLod(uDepth, hitUV, 0.0).r;
            if (abs(clipPos.z / clipPos.w - screenDepth) < 0.03) {
                if (useRtGI) {
                    ivec2 giSize = imageSize(imgGI);
                    ivec2 hitPx = clamp(ivec2(hitUV * vec2(giSize)), ivec2(0), giSize - 1);
                    screenGI += diffuseResponse * max(imageLoad(imgGI, hitPx).rgb, vec3(0.0)) * max(ubo.rtFeatureParams.z, 0.0);
                }
                if (useSSGI) {
                    screenGI += (diffuseResponse / PI) * max(textureLod(ssgiRadianceMap, hitUV, 0.0).rgb, vec3(0.0));
                }
                screenWeight = wEdge;
                if (screenWeight >= 0.99) return screenGI;
            }
        }
    }

    // 2) Off-screen / hidden in screen space: one diffuse ray smoothly blended with guard band.
    if (!allowTrace || pathEnergy < 0.005) return screenGI * screenWeight;
    vec3 gd = sampleCosineHemisphere(Nh, rand2());
    RtInstanceData h2;
    vec3 p2, n2;
    vec2 uv2;
    vec4 t2;
    float dist2;
    vec3 worldGI = vec3(0.0);
    if (traceSceneSurface(hitPos + Nh * 0.012, gd, 200.0, h2, p2, n2, uv2, t2, dist2)) {
        int numActiveLights = min(ubo.numLights, 8);
        int singleLight = (numActiveLights > 0) ? clamp(int(floor(rand1() * float(numActiveLights))), 0, numActiveLights - 1) : -1;
        float singleWeight = (numActiveLights > 0) ? float(numActiveLights) : 1.0;
        vec3 L2 = clampFirefly(shadeRtHitEx(h2, p2, n2, uv2, t2, gd, true, -1.0, singleLight, singleWeight, 2.0), 24.0);
        worldGI = diffuseResponse * L2 * max(ubo.rtFeatureParams.z, 0.0);
    }
    return mix(worldGI, screenGI, screenWeight);
}

void main() {
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    ivec2 isize = imageSize(imgRefl);
    if (any(greaterThanEqual(px, isize))) return;
    vec2 size = vec2(isize);
    float d = texelFetch(uDepth, px, 0).r;
    if (d >= 1.0 || ubo.rtParams.x < 0.5 || ubo.rtParams.w < 0.5) {
        imageStore(imgRefl, px, vec4(0.0)); return;
    }

    vec4 gNR = texelFetch(uGNormalRoughness, px, 0);
    vec3 N = gNR.xyz;
    if (dot(N, N) <= 1e-4) { imageStore(imgRefl, px, vec4(0.0)); return; }
    N = normalize(N);
    float roughness = clamp(gNR.w, 0.0, 1.0);
    // Rough surfaces get (almost) no visible mirror reflection: skip tracing and let IBL handle them.
    const float RT_REFL_MAX_ROUGHNESS = 0.75;
    if (roughness > RT_REFL_MAX_ROUGHNESS) { imageStore(imgRefl, px, vec4(0.0)); return; }

    bool useCheckerboard     = (pc.u.w & 0x00000100u) != 0u;
    bool useStochasticLights = (pc.u.w & 0x00000200u) != 0u; // Secondary reflection bounces
    bool usePrimaryStochasticLights = (pc.u.w & 0x00001000u) != 0u; // Optional PR #49 primary-hit optimization
    bool useLodBias          = (pc.u.w & 0x00000400u) != 0u;
    bool useHalfRes          = (pc.u.w & 0x00000800u) != 0u;

    // Wariant 1 & 4: Szachownica adaptacyjna wg chropowatosci (W1) lub globalna polowkowa (W4)
    bool checkerSkip = false;
    if (useHalfRes) {
        checkerSkip = (((px.x + px.y + int(pc.u.y)) & 1) != 0);
    } else if (useCheckerboard && roughness > 0.25) {
        checkerSkip = (((px.x + px.y + int(pc.u.y)) & 1) != 0);
    }

    if (checkerSkip) {
        // Zapisz znacznik alfa 0.25 do rekonstrukcji temporalnej / bilateralnej
        imageStore(imgRefl, px, vec4(0.0, 0.0, 0.0, 0.25));
        return;
    }
    vec3 P = rtWorldPos(vec2(px) + 0.5, d, size);
    vec3 V = normalize(ubo.cameraPos.xyz - P);
    if (dot(N, V) < 0.0) N = -N;
    vec3 idealR = normalize(reflect(-V, N));
    vec3 tangent, bitangent;
    buildBasis(idealR, tangent, bitangent);

    int baseSamples = int(clamp(pc.u.x, 1u, 16u));
    int samples = baseSamples;
    vec4 prevG = imageLoad(imgGeomPrev, px);
    if (prevG.w < 4.0 && baseSamples < 4) samples = min(baseSamples * 2, 4);
    // Mirror-like pixels: the primary ray is deterministic, extra samples only average RR / fallback noise.
    if (roughness < 0.02)      samples = min(samples, 4);
    else if (roughness < 0.15) samples = min(samples, 8);
    rngInit(uvec2(px), pc.u.y);

    bool infiniteBounces = (pc.u.w & 0x80000000u) != 0u;
    int maxBounces = clamp(int(pc.u.w & 0xFFu), 2, infiniteBounces ? 8 : 4);

    vec3 accumulated = vec3(0.0);
    float spread = roughness * roughness * 0.85;
    int numActiveLights = min(ubo.numLights, 8);

    for (int s = 0; s < samples; ++s) {
        vec3 throughput = vec3(1.0);
        vec3 pathRadiance = vec3(0.0);
        vec3 curOrig = P + N * (0.012 / max(dot(N, V), 0.15));
        vec3 curDir;
        if (roughness < 0.02) {
            curDir = idealR;
        } else {
            vec3 H = sampleGGX(rand2(), N, roughness);
            curDir = reflect(-V, H);
            if (dot(curDir, N) <= 0.0) curDir = idealR;
        }

        for (int bounce = 0; bounce < maxBounces; ++bounce) {
            RtInstanceData hit;
            vec3 hitPos, hitNorm;
            vec2 hitUv;
            vec4 hitTangent;
            float hitDist;
            bool hitGeo = traceSceneSurface(curOrig, curDir, MAX_REFL_DIST, hit, hitPos, hitNorm, hitUv, hitTangent, hitDist);
            float closestDist = hitGeo ? hitDist : MAX_REFL_DIST;

            bool hitBulb = false;
            vec3 bulbRadiance = vec3(0.0);
            float closestBulbDist = closestDist;
            for (int li = 0; li < numActiveLights; ++li) {
                float intensity = max(ubo.lightsCol[li].w, 0.0);
                if (intensity <= 0.001) continue;
                vec3 lightPos = ubo.lightsPos[li].xyz;
                float range = max(ubo.lightsPos[li].w, 0.1);
                int type = int(round(ubo.lightsDir[li].w));
                float bulbRadius = clamp(range * 0.02, 0.08, 0.35);
                if (type == 2) bulbRadius = clamp(max(ubo.lightsParams[li].z, ubo.lightsParams[li].w) * 0.5, 0.1, 0.6);
                vec3 OC = lightPos - curOrig;
                float tProj = dot(OC, curDir);
                if (tProj <= 0.0) continue;
                float d2 = dot(OC, OC) - tProj * tProj;
                float r2 = bulbRadius * bulbRadius;
                if (d2 >= r2) continue;
                float tHit = tProj - sqrt(max(0.0, r2 - d2));
                if (tHit <= 0.0 || tHit >= closestBulbDist) continue;
                float coneFade = 1.0;
                if (type == 1) {
                    vec3 toHit = normalize((curOrig + curDir * tHit) - lightPos);
                    float cone = dot(toHit, normalize(ubo.lightsDir[li].xyz));
                    coneFade = mix(0.15, 1.0, smoothstep(ubo.lightsParams[li].y, ubo.lightsParams[li].x, cone));
                }
                if (!rayQueryOccluded(curOrig, curDir, max(0.001, tHit - 0.02))) {
                    closestBulbDist = tHit;
                    bulbRadiance = ubo.lightsCol[li].rgb * (intensity * 6.0 * coneFade);
                    hitBulb = true;
                }
            }

            if (hitBulb) { pathRadiance += throughput * bulbRadiance; break; }
            if (!hitGeo) {
                if ((ubo.skyboxMode & 3) != 0) pathRadiance += throughput * sampleRtSkyRadiance(curDir);
                break;
            }

            float bounceLod = useLodBias ? clamp(float(bounce), 0.0, 4.0) : 0.0;
            vec4 alb = textureLod(rtAlbedoTextures[nonuniformEXT(hit.textureIndices.x)], hitUv, bounceLod);
            vec3 hitAlbedo = clamp(hit.baseColor.rgb * pow(max(alb.rgb, vec3(0.0)), vec3(2.2)), vec3(0.0), vec3(1.0));
            vec3 orm = textureLod(rtOrmTextures[nonuniformEXT(hit.textureIndices.z)], hitUv, bounceLod).rgb;
            float metallic = clamp(hit.material.x * orm.b, 0.0, 1.0);
            float hitRough = clamp(hit.material.y * orm.g, 0.0, 1.0);
            vec3 F0 = mix(vec3(0.04), hitAlbedo, metallic);
            vec3 Nh = normalize(hitNorm);
            float NdotV = max(dot(Nh, -curDir), 0.0);
            vec3 F = F0 + (1.0 - F0) * pow(1.0 - NdotV, 5.0);
            vec3 contW = mix(F * (1.0 - hitRough * 0.5), F, metallic);
            float maxContinueRoughness = clamp(pc.f.w, 0.05, 1.0);
            float minContinueThroughput = clamp(uintBitsToFloat(pc.u.z), 0.001, 1.0);
            float contLum = max(contW.r, max(contW.g, contW.b));
            bool canContinue = (bounce + 1 < maxBounces) && hitRough < maxContinueRoughness &&
                (infiniteBounces ? (contLum > 0.002) : (contLum > minContinueThroughput));

            int singleLight = -1;
            float singleWeight = 1.0;
            const bool useSingleLightForHit = (bounce == 0)
                ? usePrimaryStochasticLights
                : useStochasticLights;
            if (useSingleLightForHit && numActiveLights > 0) {
                // Uniform one-light sampling is an unbiased estimator of the full local-light sum.
                // Primary-hit sampling is independently optional because it trades lower query cost
                // for increased per-sample variance on the most visible reflection contribution.
                singleLight = clamp(int(floor(rand1() * float(numActiveLights))), 0, numActiveLights - 1);
                singleWeight = float(numActiveLights);
            }

            vec3 local = shadeRtHitEx(hit, hitPos, hitNorm, hitUv, hitTangent, curDir, false,
                                      canContinue ? 0.0 : -1.0, singleLight, singleWeight, bounceLod);
            local += screenIndirectAtHit(hit, hitPos, hitNorm, hitUv, curDir,
                                         max(throughput.r, max(throughput.g, throughput.b)), bounce < 2);
            pathRadiance += throughput * clampFirefly(local, FIREFLY_CLAMP);
            if (!canContinue) break;

            if (infiniteBounces) {
                // Russian roulette proportional to the mirror-lobe weight: weak lobes (rough / dielectric hits)
                // almost always terminate, strong lobes (metals) keep going. Unbiased, never amplifies.
                float pCont = clamp(contLum, 0.05, 1.0);
                if (rand1() > pCont) break;
                throughput *= contW / pCont;
            } else {
                throughput *= contW;
            }

            vec3 reflected = reflect(curDir, Nh);
            vec3 nextDir;
            if (hitRough < 0.02) {
                nextDir = reflected;
            } else {
                vec3 H2 = sampleGGX(rand2(), Nh, hitRough);
                nextDir = reflect(curDir, H2);
                if (dot(nextDir, Nh) <= 0.0) nextDir = reflected;
            }
            curOrig = hitPos + Nh * (0.012 / max(dot(Nh, -curDir), 0.15));
            curDir = nextDir;
        }
        accumulated += clampFirefly(pathRadiance, FIREFLY_CLAMP);
    }

    imageStore(imgRefl, px, vec4(sanitizeHDR(accumulated / float(samples)), 1.0));
}
