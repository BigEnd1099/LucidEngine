#version 460
#extension GL_EXT_ray_query : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_GOOGLE_include_directive : require

// Diffuse indirect path tracing. The output is primary-surface diffuse irradiance
// (demodulated from albedo/BRDF) so temporal and à-trous filtering preserve texture detail.
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

#include "rt_common.glsl"
#include "rt_screen.glsl"
#include "gi_world_cache_common.glsl"

layout(set = 1, binding = 0) uniform sampler2D uDepth;
layout(set = 1, binding = 1, rgba16f) uniform image2D imgS;
layout(set = 1, binding = 3, rgba32f) uniform image2D imgGeomCur;
layout(set = 1, binding = 4, rgba32f) uniform image2D imgGeomPrev;
layout(set = 1, binding = 7) uniform sampler2D uGNormalRoughness;
layout(set = 1, binding = 8) uniform sampler2D uGAlbedoMetallic;
layout(set = 1, binding = 15, std430) buffer RtDiagnostics { uint counters[56]; } rtDiag;
layout(set = 1, binding = 16, rgba16f) uniform image2D imgRawGi;
layout(set = 1, binding = 17, rgba16f) uniform image2D imgCaustics;
layout(set = 1, binding = 20, std430) readonly buffer WorldRadianceCacheBuf { WorldRadianceCell cells[]; } worldRadianceCache;

vec4 sampleWorldRadianceCache(vec3 worldPos, vec3 worldNormal, uint currentFrame) {
    uint idx = hashWorldCell(worldPos, worldNormal, 1.0);
    WorldRadianceCell cell = worldRadianceCache.cells[idx];
    if (cell.cellKey != idx || cell.irradiance.a <= 0.0) return vec4(0.0);
    if (currentFrame < cell.lastSeenFrame || (currentFrame - cell.lastSeenFrame) > 120u) return vec4(0.0);
    vec3 cachedNormal = unpackNormalOctahedral(cell.packedNormal);
    if (dot(cachedNormal, normalize(worldNormal)) <= 0.5) return vec4(0.0);
    return vec4(cell.irradiance.rgb, clamp(cell.irradiance.a / 8.0, 0.0, 1.0));
}

layout(push_constant) uniform PC {
mat4 unused;
vec4 f;
uvec4 u; // x=samples, y=frame, z=flags (bit0 GI, bit1 AO), w=max bounces
} pc;

const float AO_DISTANCE = 1.75;
const float MAX_RAY_DIST = 200.0;
const float FIREFLY_CLAMP = 256.0; // Emergency safety ceiling, not an artistic brightness clamp.
const int MAX_BOUNCES = 15;

// Decorrelated 2D PCG scramble keyed by pixel and frame. Used as a
// Cranley-Patterson rotation to preserve the R2 sequence without deriving
// both sample dimensions from a single scalar IGN value.
vec2 hash2(uvec2 p, uint frame) {
    uint frameSeed = pcgHash(frame ^ 0xA511E9B3u);
    uint h0 = pcgHash(p.x ^ pcgHash(p.y + frameSeed));
    uint h1 = pcgHash(p.y ^ pcgHash(p.x + (frameSeed ^ 0x63D83595u)));
    return vec2(float(h0 >> 8u), float(h1 >> 8u)) * (1.0 / 16777216.0);
}

vec3 fresnelSchlickGI(float cosTheta, vec3 f0) {
float f = pow(clamp(1.0 - cosTheta, 0.0, 1.0), 5.0);
return f0 + (1.0 - f0) * f;
}

vec3 sampleGGXHalfVectorGI(vec3 n, float roughness, vec2 u) {
    float alpha = max(roughness * roughness, 1e-4);
    float alpha2 = alpha * alpha;
    float phi = 2.0 * PI * u.x;
    float cosTheta = sqrt(max((1.0 - u.y) / (1.0 + (alpha2 - 1.0) * u.y), 0.0));
    float sinTheta = sqrt(max(1.0 - cosTheta * cosTheta, 0.0));
    vec3 t, b;
    buildBasis(n, t, b);
    return normalize(t * (sinTheta * cos(phi)) + b * (sinTheta * sin(phi)) + n * cosTheta);
}

float smithG1GGXGI(float nDotV, float alpha) {
    float a2 = alpha * alpha;
    float n2 = max(nDotV * nDotV, 1e-6);
    return (2.0 * nDotV) / max(nDotV + sqrt(a2 + (1.0 - a2) * n2), 1e-6);
}

void main() {
ivec2 px = ivec2(gl_GlobalInvocationID.xy);
ivec2 isize = imageSize(imgS);
if (any(greaterThanEqual(px, isize))) return;
vec2 size = vec2(isize);

vec2 curUV = (vec2(px) + 0.5) / size;
ivec2 fullDepthSize = textureSize(uDepth, 0).xy;
ivec2 fullPx = min(ivec2(curUV * vec2(fullDepthSize)), fullDepthSize - 1);

float d = texelFetch(uDepth, fullPx, 0).r;
if (d >= 1.0) {
    imageStore(imgS, px, vec4(0.0, 0.0, 0.0, 1.0));
    imageStore(imgGeomCur, px, vec4(0.0, 0.0, -1.0, 0.0));
    imageStore(imgRawGi, px, vec4(0.0, 0.0, 0.0, 1.0));
    imageStore(imgCaustics, px, vec4(0.0));
    return;
}

float zC = rtLinearDepth(d);
vec3 P = rtWorldPos(vec2(px) + 0.5, d, size);
vec3 toCam = ubo.cameraPos.xyz - P;

vec4 gNR = texelFetch(uGNormalRoughness, fullPx, 0);
vec3 N = gNR.xyz;
if (dot(N, N) > 1e-4) {
    N = normalize(N);
} else {
    ivec2 mx = fullDepthSize - 1;
    ivec2 pL = clamp(fullPx + ivec2(-1, 0), ivec2(0), mx);
    ivec2 pR = clamp(fullPx + ivec2(1, 0), ivec2(0), mx);
    ivec2 pU = clamp(fullPx + ivec2(0, -1), ivec2(0), mx);
    ivec2 pD = clamp(fullPx + ivec2(0, 1), ivec2(0), mx);
    float dL = texelFetch(uDepth, pL, 0).r;
    float dR = texelFetch(uDepth, pR, 0).r;
    float dU = texelFetch(uDepth, pU, 0).r;
    float dD = texelFetch(uDepth, pD, 0).r;
    vec3 pl = rtWorldPos((vec2(pL) + 0.5) / vec2(fullDepthSize) * size, dL, size);
    vec3 pr = rtWorldPos((vec2(pR) + 0.5) / vec2(fullDepthSize) * size, dR, size);
    vec3 pu = rtWorldPos((vec2(pU) + 0.5) / vec2(fullDepthSize) * size, dU, size);
    vec3 pd = rtWorldPos((vec2(pD) + 0.5) / vec2(fullDepthSize) * size, dD, size);
    vec3 dx = (abs(rtLinearDepth(dR) - zC) < abs(rtLinearDepth(dL) - zC)) ? (pr - P) : (P - pl);
    vec3 dy = (abs(rtLinearDepth(dD) - zC) < abs(rtLinearDepth(dU) - zC)) ? (pd - P) : (P - pu);
    N = cross(dx, dy);
    N = (dot(N, N) > 1e-14) ? normalize(N) : normalize(toCam);
}
if (dot(N, toCam) < 0.0) N = -N;


imageStore(imgGeomCur, px, vec4(rtOctEncode(N), zC, 0.0));
if (ubo.rtParams.x < 0.5) {
    imageStore(imgS, px, vec4(0.0, 0.0, 0.0, 1.0));
    imageStore(imgRawGi, px, vec4(0.0, 0.0, 0.0, 1.0));
    imageStore(imgCaustics, px, vec4(0.0));
    return;
}

const int baseSamples = int(clamp(pc.u.x, 1u, 16u));
const uint frame = pc.u.y;
const bool doGI = (pc.u.z & 1u) != 0u;
const bool doAO = (pc.u.z & 2u) != 0u;
const bool clampPathFireflies = (pc.u.z & 8u) != 0u;
const bool useCheckerboard = (pc.u.z & 4u) != 0u;
const int bounces = int(clamp(pc.u.w, 1u, uint(MAX_BOUNCES)));

// Checkerboard for GI: skip alternating pixels every other frame (cuts GI ray tracing cost by 50%)
bool checkerSkip = useCheckerboard && (((px.x + px.y + int(frame)) & 1) != 0);
if (checkerSkip) {
    // Store -1.0 in alpha as marker for rt_temporal.comp to reconstruct from history/neighbors
    imageStore(imgS, px, vec4(0.0, 0.0, 0.0, -1.0));
    imageStore(imgRawGi, px, vec4(0.0, 0.0, 0.0, -1.0));
    imageStore(imgCaustics, px, vec4(0.0));
    return;
}

int samples = baseSamples;

rngInit(uvec2(px), frame);
// Pixel/frame-specific 2D rotation of the R2 low-discrepancy sequence.
vec2 sampleOffset = hash2(uvec2(px), frame);
const vec2 R2 = vec2(0.75487766624669276, 0.56984029099805327);
float bias = 0.010 + 0.0006 * length(toCam);
vec3 origin = P + N * bias;

vec3 gi = vec3(0.0);
vec3 causticRadiance = vec3(0.0);
float causticHitCount = 0.0;
float occ = 0.0;
uint diagSurfaceHits = 0u;
uint diagMirrorHits = 0u;
uint diagLightTests = 0u;
uint diagConeHits = 0u;
uint diagVisibleHits = 0u;
uint diagCausticContributions = 0u;
uint diagPathBounces = 0u;

for (int s = 0; s < samples; ++s) {
    vec2 u0 = fract(sampleOffset + float(s) * R2);

    // This pass owns diffuse indirect lighting and AO only. Specular RT
    // reflections are evaluated independently by rt_reflections.comp and
    // controlled by the user's RT Reflections setting. Keeping the primary
    // lobe diffuse-only prevents specular energy from being written into the
    // diffuse GI buffer and added a second time in the PBR lighting combine.
    vec3 rayOrigin = origin;
    vec3 rayNormal = N;
    vec3 pathRadiance = vec3(0.0);
    vec3 nextDir = sampleCosineHemisphere(rayNormal, u0);
    // Store incident diffuse irradiance only; the PBR pass applies the primary material BRDF after denoising.
    vec3 throughput = vec3(1.0);

    for (int b = 0; b < MAX_BOUNCES; ++b) {
        if (b >= bounces) break;
        vec3 dir = nextDir;
        RtInstanceData hit;
        vec3 hitPosition, hitNormal;
        vec2 hitUv;
        vec4 hitTangent;
        float hitDistance;
        bool found = traceSceneSurface(rayOrigin, dir, MAX_RAY_DIST,
            hit, hitPosition, hitNormal, hitUv, hitTangent, hitDistance);

        if (doAO && b == 0 && found && hitDistance < AO_DISTANCE) occ += 1.0;

        // Environment lighting is owned exclusively by the IBL switch (skyboxMode bit 1)
        // in the PBR pass and in shadeRtHit(). A visible skybox must never light the
        // scene through RT GI, and rays that miss simply carry no extra radiance.
        if (!found) break;
        if (doGI) {
            diagSurfaceHits++;
            if (b > 0) diagPathBounces++;
        }
        if (!doGI) break;

        float bounceLod = clamp(float(b), 0.0, 4.0);
        int numActiveLights = min(ubo.numLights, 8);
        int singleLight = -1;
        float singleWeight = 1.0;
        if (b >= 1 && numActiveLights > 0) {
            singleLight = clamp(int(floor(rand1() * float(numActiveLights))), 0, numActiveLights - 1);
            singleWeight = float(numActiveLights);
        }

        pathRadiance += throughput * shadeRtHitEx(hit, hitPosition, hitNormal, hitUv, hitTangent, dir, true, -1.0, singleLight, singleWeight, bounceLod);

        vec3 hitAlbedo = hit.baseColor.rgb *
            pow(max(textureLod(rtAlbedoTextures[nonuniformEXT(hit.textureIndices.x)], hitUv, bounceLod).rgb, vec3(0.0)), vec3(2.2));
        vec3 hitOrm = textureLod(rtOrmTextures[nonuniformEXT(hit.textureIndices.z)], hitUv, bounceLod).rgb;
        float hitMetallic = clamp(hit.material.x * hitOrm.b, 0.0, 1.0);
        vec3 hitDiffuseAlbedo = hitAlbedo * (1.0 - hitMetallic);
        if (b == bounces - 1 && hitDistance > 1.5) {
            vec4 cached = sampleWorldRadianceCache(hitPosition, hitNormal, pc.u.y);
            if (cached.a > 0.0)
                pathRadiance += throughput * hitDiffuseAlbedo * cached.rgb * (0.35 * cached.a);
        }
        float hitRoughness = clamp(hit.material.y * hitOrm.g, 0.0, 1.0);
        bool hitReflects = (hit.material.w > 0.5);

        vec3 hitF0 = mix(vec3(0.04), hitAlbedo, hitMetallic);

        // Specular caustic reflection: when ray hits a reflective surface (mirror or low roughness metal),
        // analytically evaluate the reflection of active lights (Spot & Point) bouncing off the mirror onto this path
        bool isMirrorSurface = hitReflects && (hitMetallic > 0.4 || hitRoughness < 0.12);
        if (isMirrorSurface) {
            diagMirrorHits++;
            vec3 hitN = normalize(hitNormal);
            vec3 reflRay = reflect(dir, hitN);

            for (int li = 0; li < numActiveLights; ++li) {
                diagLightTests++;
                float intensity = max(ubo.lightsCol[li].w, 0.0);
                if (intensity <= 0.001) continue;

                vec3 toLight = ubo.lightsPos[li].xyz - hitPosition;
                float distToLight = length(toLight);
                float range = max(ubo.lightsPos[li].w, 0.1);
                if (distToLight >= range) continue;

                vec3 L = toLight / max(distToLight, 1e-4);
                float nDotL = dot(hitN, L);
                if (nDotL <= 0.001) continue; // Light is behind the mirror plane

                int type = int(round(ubo.lightsDir[li].w));
                float coneFade = 1.0;
                if (type == 1) {
                    vec3 spotDir = normalize(ubo.lightsDir[li].xyz);
                    float cone = dot(-L, spotDir);
                    if (cone <= ubo.lightsParams[li].y) continue;
                    coneFade = smoothstep(ubo.lightsParams[li].y, ubo.lightsParams[li].x, cone);
                }

                float cosAngle = dot(reflRay, L);
                float bulbRadius = clamp(range * 0.02, 0.08, 0.35);
                if (type == 2) bulbRadius = clamp(max(ubo.lightsParams[li].z, ubo.lightsParams[li].w) * 0.5, 0.1, 0.6);
                float sinBulb = clamp(bulbRadius / max(distToLight, bulbRadius + 0.01), 0.01, 0.95);
                float spreadAngle = clamp(sinBulb + hitRoughness * 1.2, 0.025, 0.85);
                float cosThreshold = cos(spreadAngle);

                if (cosAngle > cosThreshold) {
                    diagConeHits++;
                    if (!rayQueryOccluded(hitPosition + hitN * 0.01, L, max(distToLight - 0.03, 0.005))) {
                        diagVisibleHits++;
                        float totalDist = hitDistance + distToLight;
                        float ratio = totalDist / range;
                        float window = clamp(1.0 - pow(ratio, 4.0), 0.0, 1.0);
                        float attenuation = (window * window) / (totalDist * totalDist + 1.0);
                        float lobeFade = smoothstep(cosThreshold, mix(cosThreshold, 1.0, 0.35), cosAngle);
                        vec3 F_caustic = hitF0 + (vec3(1.0) - hitF0) * pow(clamp(1.0 - max(dot(hitN, L), 0.0), 0.0, 1.0), 5.0);
                        vec3 causticContrib = ubo.lightsCol[li].rgb * (intensity * 4.0 * attenuation * coneFade * lobeFade * nDotL) * F_caustic;
                        pathRadiance += throughput * causticContrib;
                        causticRadiance += throughput * causticContrib;
                        causticHitCount += 1.0;
                        diagCausticContributions++;
                    }
                }
            }
        }

        rayNormal = normalize(hitNormal);
        rayOrigin = hitPosition + rayNormal * 0.014;

        vec3 hitV = normalize(-dir);
        float hitNdotV = max(dot(rayNormal, hitV), 1e-5);
        vec3 hitF = fresnelSchlickGI(hitNdotV, hitF0);
        vec3 hitKd = (vec3(1.0) - hitF) * (1.0 - hitMetallic);
        vec3 hitDiffuseWeight = hitAlbedo * hitKd;

        // Stochastic BRDF-lobe selection. The selected lobe's probability is
        // divided out below, so the mixture remains unbiased even when clamped
        // away from zero to keep rare lobes sampleable.
        float specLum = max(max(hitF.r, hitF.g), hitF.b);
        float diffLum = max(max(hitDiffuseWeight.r, hitDiffuseWeight.g), hitDiffuseWeight.b);
        float totalLum = specLum + diffLum;
        if (totalLum < 1e-5) break;

        float hitSpecProbability = hitReflects ? clamp(specLum / totalLum, 0.05, 0.95) : 0.0;
        if (rand1() < hitSpecProbability) {
            vec3 F;
            float specWeight;
            vec3 nextSpecDir;
            if (hitRoughness < 0.02) {
                // Delta mirror limit: the directional PDF cancels analytically.
                nextSpecDir = reflect(dir, rayNormal);
                F = hitF;
                specWeight = 1.0;
            } else {
                vec3 H = sampleGGXHalfVectorGI(rayNormal, hitRoughness, rand2());
                float vDotH = max(dot(hitV, H), 1e-5);
                float nDotH = max(dot(rayNormal, H), 1e-5);
                nextSpecDir = normalize(reflect(dir, H));
                float nDotL = dot(rayNormal, nextSpecDir);
                if (nDotL <= 1e-5) break;

                float alpha = max(hitRoughness * hitRoughness, 1e-4);
                float G1V = smithG1GGXGI(hitNdotV, alpha);
                float G1L = smithG1GGXGI(nDotL, alpha);
                F = fresnelSchlickGI(vDotH, hitF0);
                // f_s * cos(theta_l) / pdf_L for NDF-sampled GGX.
                specWeight = (G1V * G1L * vDotH) / max(hitNdotV * nDotH, 1e-5);
            }
            throughput *= F * (specWeight / hitSpecProbability);
            nextDir = nextSpecDir;
        } else {
            throughput *= hitDiffuseWeight / (1.0 - hitSpecProbability);
            nextDir = sampleCosineHemisphere(rayNormal, rand2());
        }

        float thLum = max(max(throughput.r, throughput.g), throughput.b);
        if (thLum < 0.005) break;

        if (b >= 1) {
            // Russian roulette starts from the second hit (b >= 1):
            // terminate weak paths proportional to energy, keeping bright paths unbiased.
            float p = clamp(thLum, 0.08, 1.0);
            if (rand1() > p) break;
            throughput /= p;
        }
    }
    gi += clampPathFireflies ? clampFirefly(pathRadiance, FIREFLY_CLAMP) : pathRadiance;
}

float invSamples = 1.0 / float(samples);
gi = sanitizeHDR(gi * invSamples);
float vis = 1.0 - occ * invSamples;
imageStore(imgS, px, vec4(gi, vis));
imageStore(imgRawGi, px, vec4(gi, vis));
imageStore(imgCaustics, px, vec4(sanitizeHDR(causticRadiance * invSamples), causticHitCount * invSamples));
if (diagSurfaceHits > 0u) atomicAdd(rtDiag.counters[48], diagSurfaceHits);
if (diagMirrorHits > 0u) atomicAdd(rtDiag.counters[49], diagMirrorHits);
if (diagLightTests > 0u) atomicAdd(rtDiag.counters[50], diagLightTests);
if (diagConeHits > 0u) atomicAdd(rtDiag.counters[51], diagConeHits);
if (diagVisibleHits > 0u) atomicAdd(rtDiag.counters[52], diagVisibleHits);
if (diagCausticContributions > 0u) atomicAdd(rtDiag.counters[53], diagCausticContributions);
atomicAdd(rtDiag.counters[54], uint(samples));
if (diagPathBounces > 0u) atomicAdd(rtDiag.counters[55], diagPathBounces);
}
