#version 460 core
#extension GL_EXT_ray_query : enable

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform accelerationStructureEXT u_TLAS;
layout(set = 0, binding = 1, r32ui) uniform writeonly uimage2D u_SemanticBuffer;

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    
    // Mocked camera setup (In prod, passed via uniform buffer)
    vec3 origin = vec3(0.0, 0.0, -5.0);
    vec3 direction = normalize(vec3(vec2(pixel) / vec2(800.0, 600.0) * 2.0 - 1.0, 1.0));
    
    rayQueryEXT rq;
    rayQueryInitializeEXT(rq, u_TLAS, gl_RayFlagsOpaqueEXT, 0xFF, origin, 0.01, direction, 1000.0);
    
    while(rayQueryProceedEXT(rq)) {
        // Here we could handle alpha-tested geometry or any intersection filters
    }
    
    uint entityId = 0; // 0 = background/skybox
    if (rayQueryGetIntersectionTypeEXT(rq, true) != gl_RayQueryCommittedIntersectionNoneEXT) {
        // [Domain I] Extracts the exact ECS Entity ID from the TLAS custom instance index!
        entityId = rayQueryGetIntersectionInstanceCustomIndexEXT(rq, true);
    }
    
    // Write the Entity ID directly to the AI Semantic Vision Buffer
    imageStore(u_SemanticBuffer, pixel, uvec4(entityId, 0, 0, 0));
}
