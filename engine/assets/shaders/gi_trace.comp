#version 460
#extension GL_EXT_ray_query : require

// Debug/semantic ray-query compute pass. The renderer can bind its live TLAS,
// camera UBO and an R32_UINT storage image to these descriptors.
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform accelerationStructureEXT u_TLAS;
layout(set = 0, binding = 1, r32ui) uniform writeonly uimage2D u_SemanticBuffer;

layout(set = 0, binding = 2, std140) uniform RayCamera {
    mat4 inverseViewProjection;
    vec4 cameraPosition;
    vec4 viewport; // xy = width/height
} camera;

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 extent = imageSize(u_SemanticBuffer);
    if (any(greaterThanEqual(pixel, extent))) return;

    vec2 uv = (vec2(pixel) + vec2(0.5)) / vec2(extent);
    vec2 ndc = uv * 2.0 - 1.0;
    // Vulkan clip-space depth is [0, 1]; the Y axis is inverted by projection.
    vec4 nearH = camera.inverseViewProjection * vec4(ndc.x, -ndc.y, 0.0, 1.0);
    vec4 farH  = camera.inverseViewProjection * vec4(ndc.x, -ndc.y, 1.0, 1.0);
    vec3 origin = camera.cameraPosition.xyz;
    vec3 target = farH.xyz / max(abs(farH.w), 1e-7) * sign(farH.w);
    vec3 direction = normalize(target - origin);

    rayQueryEXT rq;
    rayQueryInitializeEXT(rq, u_TLAS, gl_RayFlagsOpaqueEXT | gl_RayFlagsTerminateOnFirstHitEXT,
                          0xFF, origin, 0.001, direction, 10000.0);
    while (rayQueryProceedEXT(rq)) { }

    uint entityId = 0u; // 0 = background
    if (rayQueryGetIntersectionTypeEXT(rq, true) != gl_RayQueryCommittedIntersectionNoneEXT)
        entityId = rayQueryGetIntersectionInstanceCustomIndexEXT(rq, true);

    imageStore(u_SemanticBuffer, pixel, uvec4(entityId, 0u, 0u, 0u));
}
